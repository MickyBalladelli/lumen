import { AstProgram } from "./ast.lm"
import { compilerAbiParameter, compilerAbiSignature } from "./abi.lm"
import { CompilerToken, TokenArena, tokenArenaGet } from "./containers.lm"
import { typeArrayElement, typeCanAssign, typeCanCompare, typeIsArray, typeIsNullable, typeIsNumeric, typeIsResult, typeIsTask, typeNonNullable, typeResultValue, typeTaskValue, typeWidest } from "./types.lm"

struct TypeResult {
  ok: bool
  message: string
  checkedCount: i32
  tokenIndex: i32
}

struct TypeValue {
  ok: bool
  typeName: string
  message: string
  tokenIndex: i32
}

function typeOk(checkedCount: i32): TypeResult {
  return TypeResult {
    ok: true,
    message: "",
    checkedCount: checkedCount,
    tokenIndex: 0
  }
}

function typeError(message: string, checkedCount: i32, tokenIndex: i32): TypeResult {
  return TypeResult {
    ok: false,
    message: message,
    checkedCount: checkedCount,
    tokenIndex: tokenIndex
  }
}

function typeValue(typeName: string): TypeValue {
  return TypeValue {
    ok: true,
    typeName: typeName,
    message: "",
    tokenIndex: 0
  }
}

function typeValueError(message: string, tokenIndex: i32): TypeValue {
  return TypeValue {
    ok: false,
    typeName: "unknown",
    message: message,
    tokenIndex: tokenIndex
  }
}

function typeTokenValue(token: CompilerToken): string {
  if stringEquals(token.kind, "string") {
    return token.literal
  }
  return token.lexeme
}

function typeTokenKind(token: CompilerToken): string {
  return token.kind
}

function typeIsTerminator(tokens: TokenArena, index: i32): bool {
  let kind = typeTokenKind(tokenArenaGet(tokens, index))
  return stringEquals(kind, "semicolon") || stringEquals(kind, "eof")
}

function typeFindNext(tokens: TokenArena, index: i32, wanted: string): i32 {
  while index < tokens.count do {
    if stringEquals(typeTokenValue(tokenArenaGet(tokens, index)), wanted) {
      return index
    }
    index = index + 1
  }
  return index
}

function typeFindMatching(
  tokens: TokenArena,
  open: i32,
  end: i32,
  left: string,
  right: string
): i32 {
  let depth: i32 = 0
  let index = open
  while index < end do {
    let token = tokenArenaGet(tokens, index)
    if !stringEquals(typeTokenKind(token), "string") {
      let value = typeTokenValue(token)
      if stringEquals(value, left) {
        depth = depth + 1
      } else if stringEquals(value, right) {
        depth = depth - 1
        if depth == 0 {
          return index
        }
      }
    }
    index = index + 1
  }
  return end
}

function typeFindStatementEnd(tokens: TokenArena, start: i32): i32 {
  let parens: i32 = 0
  let brackets: i32 = 0
  let braces: i32 = 0
  let index = start
  while index < tokens.count do {
    let token = tokenArenaGet(tokens, index)
    if !stringEquals(typeTokenKind(token), "string") {
      let value = typeTokenValue(token)
      if stringEquals(value, "(") {
        parens = parens + 1
      } else if stringEquals(value, ")") {
        parens = parens - 1
      } else if stringEquals(value, "[") {
        brackets = brackets + 1
      } else if stringEquals(value, "]") {
        brackets = brackets - 1
      } else if stringEquals(value, "{") {
        braces = braces + 1
      } else if stringEquals(value, "}") {
        if braces == 0 {
          return index - 1
        }
        braces = braces - 1
      }
    }
    if parens == 0 && brackets == 0 && braces == 0 {
      if typeIsTerminator(tokens, index) {
        return index - 1
      }
    }
    index = index + 1
  }
  return tokens.count - 1
}

function typeTrimEnd(tokens: TokenArena, start: i32, end: i32): i32 {
  while end >= start do {
    if typeIsTerminator(tokens, end) {
      end = end - 1
    } else {
      return end
    }
  }
  return end
}

function typeFindTopLevel(
  tokens: TokenArena,
  start: i32,
  end: i32,
  wanted: string
): i32 {
  let parens: i32 = 0
  let brackets: i32 = 0
  let braces: i32 = 0
  let index = start
  while index <= end do {
    let token = tokenArenaGet(tokens, index)
    if !stringEquals(typeTokenKind(token), "string") {
      let value = typeTokenValue(token)
      if stringEquals(value, wanted) &&
        parens == 0 && brackets == 0 && braces == 0 {
        return index
      }
      if stringEquals(value, "(") {
        parens = parens + 1
      } else if stringEquals(value, ")") {
        parens = parens - 1
      } else if stringEquals(value, "[") {
        brackets = brackets + 1
      } else if stringEquals(value, "]") {
        brackets = brackets - 1
      } else if stringEquals(value, "{") {
        braces = braces + 1
      } else if stringEquals(value, "}") {
        braces = braces - 1
      }
    }
    index = index + 1
  }
  return -1
}

function typeFindLastTopLevel(
  tokens: TokenArena,
  start: i32,
  end: i32,
  wanted: string
): i32 {
  let found: i32 = -1
  let parens: i32 = 0
  let brackets: i32 = 0
  let braces: i32 = 0
  let index = start
  while index <= end do {
    let token = tokenArenaGet(tokens, index)
    if !stringEquals(typeTokenKind(token), "string") {
      let value = typeTokenValue(token)
      if stringEquals(value, wanted) &&
        parens == 0 && brackets == 0 && braces == 0 {
        found = index
      }
      if stringEquals(value, "(") {
        parens = parens + 1
      } else if stringEquals(value, ")") {
        parens = parens - 1
      } else if stringEquals(value, "[") {
        brackets = brackets + 1
      } else if stringEquals(value, "]") {
        brackets = brackets - 1
      } else if stringEquals(value, "{") {
        braces = braces + 1
      } else if stringEquals(value, "}") {
        braces = braces - 1
      }
    }
    index = index + 1
  }
  return found
}

function typeOperatorPrecedence(operator: string): i32 {
  if stringEquals(operator, "=") {
    return 1
  }
  if stringEquals(operator, "||") {
    return 2
  }
  if stringEquals(operator, "&&") {
    return 3
  }
  if stringEquals(operator, "==") || stringEquals(operator, "!=") ||
    stringEquals(operator, "===") || stringEquals(operator, "!==") {
    return 4
  }
  if stringEquals(operator, "<") || stringEquals(operator, "<=") ||
    stringEquals(operator, ">") || stringEquals(operator, ">=") {
    return 5
  }
  if stringEquals(operator, "+") || stringEquals(operator, "-") {
    return 6
  }
  if stringEquals(operator, "*") || stringEquals(operator, "/") ||
    stringEquals(operator, "%") {
    return 7
  }
  return 0
}

function typeFindBinary(tokens: TokenArena, start: i32, end: i32): i32 {
  let best: i32 = -1
  let bestPrecedence: i32 = 100
  let parens: i32 = 0
  let brackets: i32 = 0
  let braces: i32 = 0
  let index = start
  while index <= end do {
    let token = tokenArenaGet(tokens, index)
    if !stringEquals(typeTokenKind(token), "string") {
      let value = typeTokenValue(token)
      if stringEquals(value, "(") {
        parens = parens + 1
      } else if stringEquals(value, ")") {
        parens = parens - 1
      } else if stringEquals(value, "[") {
        brackets = brackets + 1
      } else if stringEquals(value, "]") {
        brackets = brackets - 1
      } else if stringEquals(value, "{") {
        braces = braces + 1
      } else if stringEquals(value, "}") {
        braces = braces - 1
      } else if parens == 0 && brackets == 0 && braces == 0 {
        let precedence = typeOperatorPrecedence(value)
        if precedence > 0 && index > start && precedence <= bestPrecedence {
          best = index
          bestPrecedence = precedence
        }
      }
    }
    index = index + 1
  }
  return best
}

function readTypeName(tokens: TokenArena, index: i32, stop: string): string {
  let out = stringBuilder()
  while index < tokens.count do {
    let value = typeTokenValue(tokenArenaGet(tokens, index))
    if stringEquals(value, stop) || stringEquals(value, "=") ||
      stringEquals(value, ",") {
      return out
    }
    out = stringBuilderAppend(out, value)
    index = index + 1
  }
  return out
}

function readTypeRange(tokens: TokenArena, start: i32, end: i32): string {
  let out = stringBuilder()
  let index = start
  while index <= end do {
    out = stringBuilderAppend(
      out,
      typeTokenValue(tokenArenaGet(tokens, index))
    )
    index = index + 1
  }
  return out
}

function functionReturnKey(name: string): string {
  return "function:" + name + ":return"
}

function functionCountKey(name: string): string {
  return "function:" + name + ":count"
}

function functionParamKey(name: string, index: i32): string {
  return "function:" + name + ":param:" + intToString(index)
}

function structFieldKey(name: string, field: string): string {
  return "struct:" + name + ":field:" + field
}

function structTypeKey(name: string): string {
  return "struct:" + name
}

function registerStructType(tokens: TokenArena, index: i32, variables: string): string {
  let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
  variables = mapSet(variables, structTypeKey(name), "declared")
  let open = typeFindNext(tokens, index, "{")
  let close = typeFindMatching(tokens, open, tokens.count, "{", "}")
  let cursor = open + 1
  while cursor < close do {
    if typeIsTerminator(tokens, cursor) {
      cursor = cursor + 1
      continue
    }
    let field = typeTokenValue(tokenArenaGet(tokens, cursor))
    let colon = typeFindNext(tokens, cursor, ":")
    let fieldEnd = typeFindStatementEnd(tokens, colon + 1)
    let fieldType = readTypeRange(tokens, colon + 1, fieldEnd)
    variables = mapSet(variables, structFieldKey(name, field), fieldType)
    cursor = fieldEnd + 1
  }
  return variables
}

function registerFunctionType(tokens: TokenArena, index: i32, functions: string): string {
  let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
  let open = typeFindNext(tokens, index, "(")
  let close = typeFindMatching(tokens, open, tokens.count, "(", ")")
  let returnType = "i32"
  if stringEquals(typeTokenValue(tokenArenaGet(tokens, close + 1)), ":") {
    returnType = readTypeName(tokens, close + 2, "{")
  }
  if index > 0 {
    if stringEquals(typeTokenValue(tokenArenaGet(tokens, index - 1)), "async") {
      returnType = "Task<" + returnType + ">"
    }
  }
  functions = mapSet(functions, functionReturnKey(name), returnType)
  let cursor = open + 1
  let paramCount: i32 = 0
  while cursor < close do {
    let comma = typeFindTopLevel(tokens, cursor, close - 1, ",")
    let paramEnd = close - 1
    if comma >= 0 {
      paramEnd = comma - 1
    }
    let colon = typeFindTopLevel(tokens, cursor, paramEnd, ":")
    let paramType = "i32"
    if colon >= 0 {
      paramType = readTypeRange(tokens, colon + 1, paramEnd)
    }
    functions = mapSet(
      functions,
      functionParamKey(name, paramCount),
      paramType
    )
    paramCount = paramCount + 1
    if comma < 0 {
      cursor = close
    } else {
      cursor = comma + 1
    }
  }
  return mapSet(functions, functionCountKey(name), intToString(paramCount))
}

function registerFunctionParameters(
  tokens: TokenArena,
  index: i32,
  variables: string
): string {
  let open = typeFindNext(tokens, index, "(")
  let close = typeFindMatching(tokens, open, tokens.count, "(", ")")
  let cursor = open + 1
  while cursor < close do {
    let comma = typeFindTopLevel(tokens, cursor, close - 1, ",")
    let paramEnd = close - 1
    if comma >= 0 {
      paramEnd = comma - 1
    }
    let colon = typeFindTopLevel(tokens, cursor, paramEnd, ":")
    if colon >= 0 {
      let name = typeTokenValue(tokenArenaGet(tokens, cursor))
      let paramType = readTypeRange(tokens, colon + 1, paramEnd)
      variables = mapSet(variables, name, paramType)
    }
    if comma < 0 {
      cursor = close
    } else {
      cursor = comma + 1
    }
  }
  return variables
}

function inferCallType(
  tokens: TokenArena,
  start: i32,
  open: i32,
  close: i32,
  variables: string,
  functions: string
): TypeValue {
  let name = typeTokenValue(tokenArenaGet(tokens, start))
  let cursor = open + 1
  let argumentCount: i32 = 0
  let expectedCount: i32 = -1
  let minimumCount: i32 = -1
  let maximumCount: i32 = -1
  let signature = compilerAbiSignature(name)
  if mapHas(functions, functionCountKey(name)) {
    expectedCount = stringToInt(mapGet(functions, functionCountKey(name)))
    minimumCount = expectedCount
    maximumCount = expectedCount
  } else if signature.found {
    expectedCount = signature.parameterCount
    minimumCount = signature.minArity
    maximumCount = signature.maxArity
  }

  while cursor < close do {
    let comma = typeFindTopLevel(tokens, cursor, close - 1, ",")
    let argumentEnd = close - 1
    if comma >= 0 {
      argumentEnd = comma - 1
    }
    let actual = inferTypeRange(
      tokens,
      cursor,
      argumentEnd,
      variables,
      functions
    )
    if !actual.ok {
      return actual
    }
    if expectedCount >= 0 && (argumentCount < expectedCount || signature.variadic) {
      let expected = "unknown"
      if signature.found {
        expected = compilerAbiParameter(signature, argumentCount)
      } else {
        expected = mapGet(functions, functionParamKey(name, argumentCount))
      }
      if !typeCanAssign(actual.typeName, expected) {
        return typeValueError(
          "compile error: cannot pass " + actual.typeName + " to " + expected,
          start
        )
      }
    }
    argumentCount = argumentCount + 1
    if comma < 0 {
      cursor = close
    } else {
      cursor = comma + 1
    }
  }

  if minimumCount >= 0 && argumentCount < minimumCount {
    return typeValueError("compile error: invalid call to " + name, start)
  }
  if maximumCount >= 0 && argumentCount > maximumCount {
    return typeValueError("compile error: invalid call to " + name, start)
  }

  if stringEquals(name, "none") {
    if argumentCount != 0 {
      return typeValueError("compile error: none expects no values", start)
    }
    return typeValue("none")
  }
  if stringEquals(name, "some") {
    if argumentCount != 1 {
      return typeValueError("compile error: some expects one value", start)
    }
    let inner = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    if typeIsNullable(inner.typeName) {
      return inner
    }
    return typeValue(inner.typeName + "?")
  }
  if stringEquals(name, "ok") {
    if argumentCount != 1 {
      return typeValueError("compile error: ok expects one value", start)
    }
    let inner = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    return typeValue("Result<" + inner.typeName + ">")
  }
  if stringEquals(name, "err") {
    if argumentCount != 1 {
      return typeValueError("compile error: err expects one string", start)
    }
    let inner = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    if !typeCanAssign(inner.typeName, "string") {
      return typeValueError("compile error: err expects one string", start)
    }
    return typeValue("Result<unknown>")
  }
  if stringEquals(name, "resultValue") {
    if argumentCount != 1 {
      return typeValueError("compile error: resultValue expects Result<T>", start)
    }
    let result = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    if stringEquals(result.typeName, "unknown") {
      return result
    }
    if !typeIsResult(result.typeName) {
      return typeValueError("compile error: resultValue expects Result<T>", start)
    }
    return typeValue(typeResultValue(result.typeName))
  }
  if stringEquals(name, "isOk") || stringEquals(name, "errorMessage") {
    if argumentCount != 1 {
      return typeValueError(
        "compile error: " + name + " expects one Result<T>",
        start
      )
    }
    let result = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    if !stringEquals(result.typeName, "unknown") && !typeIsResult(result.typeName) {
      return typeValueError(
        "compile error: " + name + " expects Result<T>, got " + result.typeName,
        start
      )
    }
    if stringEquals(name, "isOk") {
      return typeValue("bool")
    }
    return typeValue("string")
  }
  if stringEquals(name, "hasValue") {
    let result = inferTypeRange(tokens, open + 1, close - 1, variables, functions)
    if !stringEquals(result.typeName, "unknown") &&
      !typeIsNullable(result.typeName) {
      return typeValueError(
        "compile error: hasValue expects nullable value, got " + result.typeName,
        start
      )
    }
    return typeValue("bool")
  }
  if stringEquals(name, "valueOr") {
    let comma = typeFindTopLevel(tokens, open + 1, close - 1, ",")
    if argumentCount != 2 || comma < 0 {
      return typeValueError(
        "compile error: valueOr expects nullable value and fallback",
        start
      )
    }
    let maybe = inferTypeRange(tokens, open + 1, comma - 1, variables, functions)
    let fallback = inferTypeRange(tokens, comma + 1, close - 1, variables, functions)
    if stringEquals(maybe.typeName, "unknown") {
      return maybe
    }
    if !typeIsNullable(maybe.typeName) {
      return typeValueError(
        "compile error: valueOr expects nullable value, got " + maybe.typeName,
        start
      )
    }
    let valueType = typeNonNullable(maybe.typeName)
    if !typeCanAssign(fallback.typeName, valueType) {
      return typeValueError(
        "compile error: cannot use " + fallback.typeName +
        " as fallback for " + maybe.typeName,
        start
      )
    }
    return typeValue(valueType)
  }

  if mapHas(functions, functionReturnKey(name)) {
    return typeValue(mapGet(functions, functionReturnKey(name)))
  }
  if signature.found {
    return typeValue(signature.returnType)
  }
  return typeValue("unknown")
}

function inferArrayType(
  tokens: TokenArena,
  start: i32,
  end: i32,
  variables: string,
  functions: string
): TypeValue {
  if start + 1 >= end {
    return typeValue("unknown[]")
  }
  let cursor = start + 1
  let elementType = "unknown"
  while cursor < end do {
    let comma = typeFindTopLevel(tokens, cursor, end - 1, ",")
    let elementEnd = end - 1
    if comma >= 0 {
      elementEnd = comma - 1
    }
    let element = inferTypeRange(tokens, cursor, elementEnd, variables, functions)
    if !element.ok {
      return element
    }
    if stringEquals(elementType, "unknown") {
      elementType = element.typeName
    } else if typeIsNumeric(elementType) && typeIsNumeric(element.typeName) {
      elementType = typeWidest(elementType, element.typeName)
    } else if !typeCanAssign(element.typeName, elementType) {
      return typeValueError(
        "compile error: array elements have types " +
        elementType + " and " + element.typeName,
        cursor
      )
    }
    if comma < 0 {
      cursor = end
    } else {
      cursor = comma + 1
    }
  }
  return typeValue(elementType + "[]")
}

function inferTypeRange(
  tokens: TokenArena,
  start: i32,
  end: i32,
  variables: string,
  functions: string
): TypeValue {
  end = typeTrimEnd(tokens, start, end)
  if end < start {
    return typeValue("void")
  }

  let firstToken = tokenArenaGet(tokens, start)
  let first = typeTokenValue(firstToken)
  let firstKind = typeTokenKind(firstToken)

  if stringEquals(first, "(") {
    let close = typeFindMatching(tokens, start, end + 1, "(", ")")
    if close == end {
      return inferTypeRange(tokens, start + 1, end - 1, variables, functions)
    }
  }

  let binary = typeFindBinary(tokens, start, end)
  if binary >= 0 {
    let operator = typeTokenValue(tokenArenaGet(tokens, binary))
    let left = inferTypeRange(tokens, start, binary - 1, variables, functions)
    if !left.ok {
      return left
    }
    let right = inferTypeRange(tokens, binary + 1, end, variables, functions)
    if !right.ok {
      return right
    }
    if stringEquals(operator, "=") {
      if !typeCanAssign(right.typeName, left.typeName) {
        return typeValueError(
          "compile error: cannot assign " + right.typeName +
          " to " + left.typeName,
          start
        )
      }
      return typeValue(left.typeName)
    }
    if stringEquals(operator, "&&") || stringEquals(operator, "||") {
      let leftBool = stringEquals(left.typeName, "bool") ||
        stringEquals(left.typeName, "unknown")
      let rightBool = stringEquals(right.typeName, "bool") ||
        stringEquals(right.typeName, "unknown")
      if !leftBool || !rightBool {
        return typeValueError(
          "compile error: operator " + operator + " needs bool operands",
          binary
        )
      }
      return typeValue("bool")
    }
    if stringEquals(operator, "==") || stringEquals(operator, "!=") ||
      stringEquals(operator, "===") || stringEquals(operator, "!==") {
      if !typeCanCompare(left.typeName, right.typeName) {
        return typeValueError(
          "compile error: cannot compare " + left.typeName +
          " with " + right.typeName,
          binary
        )
      }
      return typeValue("bool")
    }
    if stringEquals(operator, "<") || stringEquals(operator, "<=") ||
      stringEquals(operator, ">") || stringEquals(operator, ">=") {
      let leftNumber = typeIsNumeric(left.typeName) ||
        stringEquals(left.typeName, "unknown")
      let rightNumber = typeIsNumeric(right.typeName) ||
        stringEquals(right.typeName, "unknown")
      if !leftNumber || !rightNumber {
        return typeValueError(
          "compile error: operator " + operator + " needs numbers",
          binary
        )
      }
      return typeValue("bool")
    }
    if stringEquals(operator, "+") &&
      stringEquals(left.typeName, "string") &&
      stringEquals(right.typeName, "string") {
      return typeValue("string")
    }
    if !typeIsNumeric(left.typeName) || !typeIsNumeric(right.typeName) {
      if stringEquals(left.typeName, "unknown") ||
        stringEquals(right.typeName, "unknown") {
        return typeValue("unknown")
      }
      return typeValueError(
        "compile error: operator " + operator + " needs numbers",
        binary
      )
    }
    return typeValue(typeWidest(left.typeName, right.typeName))
  }

  if !stringEquals(firstKind, "string") &&
    (stringEquals(first, "!") || stringEquals(first, "-") ||
    stringEquals(first, "+")) {
    let argument = inferTypeRange(tokens, start + 1, end, variables, functions)
    if !argument.ok {
      return argument
    }
    if stringEquals(first, "!") {
      if !stringEquals(argument.typeName, "bool") &&
        !stringEquals(argument.typeName, "unknown") {
        return typeValueError(
          "compile error: operator ! needs bool, got " + argument.typeName,
          start
        )
      }
      return typeValue("bool")
    }
    if !typeIsNumeric(argument.typeName) &&
      !stringEquals(argument.typeName, "unknown") {
      return typeValueError(
        "compile error: operator " + first + " needs number",
        start
      )
    }
    return argument
  }

  if !stringEquals(firstKind, "string") && stringEquals(first, "await") {
    let task = inferTypeRange(tokens, start + 1, end, variables, functions)
    if stringEquals(task.typeName, "unknown") {
      return task
    }
    if !typeIsTask(task.typeName) {
      return typeValueError(
        "compile error: await expects Task<T>, got " + task.typeName,
        start
      )
    }
    return typeValue(typeTaskValue(task.typeName))
  }

  if !stringEquals(firstKind, "string") && stringEquals(first, "[") {
    let close = typeFindMatching(tokens, start, end + 1, "[", "]")
    if close == end {
      return inferArrayType(tokens, start, end, variables, functions)
    }
  }

  let callOpen = typeFindTopLevel(tokens, start, end, "(")
  if callOpen > start {
    let callClose = typeFindMatching(tokens, callOpen, end + 1, "(", ")")
    if callClose == end {
      return inferCallType(
        tokens,
        start,
        callOpen,
        callClose,
        variables,
        functions
      )
    }
  }

  let bracket = typeFindTopLevel(tokens, start, end, "[")
  if bracket > start {
    let close = typeFindMatching(tokens, bracket, end + 1, "[", "]")
    if close == end {
      let object = inferTypeRange(
        tokens,
        start,
        bracket - 1,
        variables,
        functions
      )
      if !object.ok {
        return object
      }
      let firstDot = typeFindTopLevel(tokens, bracket + 1, close - 1, ".")
      if firstDot >= 0 {
        if firstDot + 1 < close {
          if stringEquals(typeTokenValue(tokenArenaGet(tokens, firstDot + 1)), ".") {
            if !stringEquals(object.typeName, "string") &&
              !stringEquals(object.typeName, "unknown") {
              return typeValueError("compile error: slice needs string", start)
            }
            if firstDot > bracket + 1 {
              let lower = inferTypeRange(
                tokens,
                bracket + 1,
                firstDot - 1,
                variables,
                functions
              )
              if !stringEquals(lower.typeName, "i32") &&
                !stringEquals(lower.typeName, "unknown") {
                return typeValueError(
                  "compile error: slice bounds must be i32",
                  bracket + 1
                )
              }
            }
            if firstDot + 2 < close {
              let upper = inferTypeRange(
                tokens,
                firstDot + 2,
                close - 1,
                variables,
                functions
              )
              if !stringEquals(upper.typeName, "i32") &&
                !stringEquals(upper.typeName, "unknown") {
                return typeValueError(
                  "compile error: slice bounds must be i32",
                  firstDot + 2
                )
              }
            }
            return typeValue("string")
          }
        }
      }
      let indexType = inferTypeRange(
        tokens,
        bracket + 1,
        close - 1,
        variables,
        functions
      )
      if !stringEquals(indexType.typeName, "i32") &&
        !stringEquals(indexType.typeName, "unknown") {
        return typeValueError(
          "compile error: index must be i32, got " + indexType.typeName,
          bracket + 1
        )
      }
      if stringEquals(object.typeName, "string") {
        return typeValue("string")
      }
      if typeIsArray(object.typeName) {
        return typeValue(typeArrayElement(object.typeName))
      }
      if stringEquals(object.typeName, "unknown") {
        return object
      }
      return typeValueError("compile error: expected array", start)
    }
  }

  let dot = typeFindLastTopLevel(tokens, start, end, ".")
  if dot > start {
    let object = inferTypeRange(tokens, start, dot - 1, variables, functions)
    if !object.ok {
      return object
    }
    let field = typeTokenValue(tokenArenaGet(tokens, dot + 1))
    let key = structFieldKey(object.typeName, field)
    if mapHas(variables, key) {
      return typeValue(mapGet(variables, key))
    }
    if stringEquals(object.typeName, "unknown") {
      return object
    }
    return typeValueError(
      "compile error: unknown field " + field + " on " + object.typeName,
      dot + 1
    )
  }

  if start + 1 <= end {
    if stringEquals(typeTokenValue(tokenArenaGet(tokens, start + 1)), "{") {
      let close = typeFindMatching(tokens, start + 1, end + 1, "{", "}")
      if close == end {
        let cursor = start + 2
        while cursor < close do {
          if typeIsTerminator(tokens, cursor) ||
            stringEquals(typeTokenValue(tokenArenaGet(tokens, cursor)), ",") {
            cursor = cursor + 1
            continue
          }
          let field = typeTokenValue(tokenArenaGet(tokens, cursor))
          let colon = typeFindTopLevel(tokens, cursor, close - 1, ":")
          if colon < 0 {
            cursor = close
            continue
          }
          let valueEnd = typeFindStatementEnd(tokens, colon + 1)
          if valueEnd >= close {
            valueEnd = close - 1
          }
          let comma = typeFindTopLevel(tokens, colon + 1, valueEnd, ",")
          if comma >= 0 {
            valueEnd = comma - 1
          }
          let fieldValue = inferTypeRange(
            tokens,
            colon + 1,
            valueEnd,
            variables,
            functions
          )
          if !fieldValue.ok {
            return fieldValue
          }
          let fieldKey = structFieldKey(first, field)
          if mapHas(variables, fieldKey) {
            let expected = mapGet(variables, fieldKey)
            if !typeCanAssign(fieldValue.typeName, expected) {
              return typeValueError(
                "compile error: cannot assign " + fieldValue.typeName +
                " to field " + first + "." + field,
                cursor
              )
            }
          } else if mapHas(variables, structTypeKey(first)) {
            return typeValueError(
              "compile error: unknown field " + field + " on " + first,
              cursor
            )
          }
          if comma < 0 {
            cursor = valueEnd + 1
          } else {
            cursor = comma + 1
          }
        }
        return typeValue(first)
      }
    }
  }

  if stringEquals(firstKind, "number") {
    if includes(first, ".") {
      return typeValue("f32")
    }
    return typeValue("i32")
  }
  if stringEquals(firstKind, "string") {
    return typeValue("string")
  }
  if stringEquals(first, "true") || stringEquals(first, "false") {
    return typeValue("bool")
  }
  if stringEquals(first, "null") || stringEquals(first, "none") {
    return typeValue("none")
  }
  if mapHas(variables, first) {
    return typeValue(mapGet(variables, first))
  }
  return typeValue("unknown")
}

function typeCheckVariable(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let next = typeTokenValue(tokenArenaGet(tokens, index + 2))
  if !stringEquals(next, ":") {
    return typeOk(0)
  }
  let expected = readTypeName(tokens, index + 3, "=")
  let equals = typeFindNext(tokens, index, "=")
  let declarationEnd = typeFindStatementEnd(tokens, index)
  if equals > declarationEnd {
    return typeOk(0)
  }
  let end = typeFindStatementEnd(tokens, equals + 1)
  let actual = inferTypeRange(tokens, equals + 1, end, variables, functions)
  if !actual.ok {
    return typeError(actual.message, 1, actual.tokenIndex)
  }
  if !typeCanAssign(actual.typeName, expected) {
    return typeError(
      "compile error: cannot assign " + actual.typeName + " to " + expected,
      1,
      index
    )
  }
  return typeOk(1)
}

function registerVariableType(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): string {
  let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
  let next = typeTokenValue(tokenArenaGet(tokens, index + 2))
  if stringEquals(next, ":") {
    return mapSet(
      variables,
      name,
      readTypeName(tokens, index + 3, "=")
    )
  }
  let equals = typeFindNext(tokens, index, "=")
  if equals >= tokens.count {
    return mapSet(variables, name, "unknown")
  }
  let end = typeFindStatementEnd(tokens, equals + 1)
  let inferred = inferTypeRange(tokens, equals + 1, end, variables, functions)
  return mapSet(variables, name, inferred.typeName)
}

function checkFunctionCall(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let open = index + 1
  let close = typeFindMatching(tokens, open, tokens.count, "(", ")")
  let inferred = inferCallType(
    tokens,
    index,
    open,
    close,
    variables,
    functions
  )
  if !inferred.ok {
    return typeError(inferred.message, 1, inferred.tokenIndex)
  }
  return typeOk(1)
}

function checkAssignment(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let end = typeFindStatementEnd(tokens, index)
  let inferred = inferTypeRange(tokens, index, end, variables, functions)
  if !inferred.ok {
    return typeError(inferred.message, 1, inferred.tokenIndex)
  }
  return typeOk(1)
}

function checkReturnType(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string,
  expected: string
): TypeResult {
  let end = typeFindStatementEnd(tokens, index + 1)
  let actual = inferTypeRange(tokens, index + 1, end, variables, functions)
  if !actual.ok {
    return typeError(actual.message, 1, actual.tokenIndex)
  }
  if typeCanAssign(actual.typeName, expected) {
    return typeOk(1)
  }
  return typeError(
    "compile error: return type " + actual.typeName +
    " does not match " + expected,
    1,
    index
  )
}

function checkThrowType(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let end = typeFindStatementEnd(tokens, index + 1)
  let actual = inferTypeRange(tokens, index + 1, end, variables, functions)
  if !actual.ok {
    return typeError(actual.message, 1, actual.tokenIndex)
  }
  if stringEquals(actual.typeName, "string") ||
    stringEquals(actual.typeName, "error") ||
    stringEquals(actual.typeName, "unknown") {
    return typeOk(1)
  }
  return typeError(
    "compile error: throw expects string or error, got " + actual.typeName,
    1,
    index
  )
}

function checkForOfType(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let end = typeFindStatementEnd(tokens, index + 1)
  let actual = inferTypeRange(tokens, index + 1, end, variables, functions)
  if typeIsArray(actual.typeName) || stringEquals(actual.typeName, "unknown") {
    return typeOk(1)
  }
  return typeError("compile error: for-of needs an array", 1, index)
}

function checkSwitchCases(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let bodyStart = typeFindNext(tokens, index, "{")
  let bodyEnd = typeFindMatching(tokens, bodyStart, tokens.count, "{", "}")
  let subject = inferTypeRange(
    tokens,
    index + 1,
    bodyStart - 1,
    variables,
    functions
  )
  let cursor = bodyStart + 1
  while cursor < bodyEnd do {
    if stringEquals(typeTokenValue(tokenArenaGet(tokens, cursor)), "case") {
      let caseEnd = typeFindNext(tokens, cursor, "{")
      let caseType = inferTypeRange(
        tokens,
        cursor + 1,
        caseEnd - 1,
        variables,
        functions
      )
      if !typeCanCompare(subject.typeName, caseType.typeName) {
        return typeError(
          "compile error: cannot compare switch " + subject.typeName +
          " with case " + caseType.typeName,
          1,
          cursor
        )
      }
    }
    cursor = cursor + 1
  }
  return typeOk(1)
}

function checkIfCondition(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let bodyStart = typeFindNext(tokens, index, "{")
  let actual = inferTypeRange(tokens, index + 1, bodyStart - 1, variables, functions)
  if !actual.ok {
    return typeError(actual.message, 1, actual.tokenIndex)
  }
  if stringEquals(actual.typeName, "bool") || stringEquals(actual.typeName, "unknown") {
    return typeOk(1)
  }
  return typeError(
    "compile error: if condition must be bool, got " + actual.typeName,
    1,
    index
  )
}

function checkWhileCondition(
  tokens: TokenArena,
  index: i32,
  variables: string,
  functions: string
): TypeResult {
  let bodyStart = typeFindNext(tokens, index, "{")
  let actual = inferTypeRange(tokens, index + 1, bodyStart - 1, variables, functions)
  if !actual.ok {
    return typeError(actual.message, 1, actual.tokenIndex)
  }
  if stringEquals(actual.typeName, "bool") || stringEquals(actual.typeName, "unknown") {
    return typeOk(1)
  }
  return typeError(
    "compile error: while condition must be bool, got " + actual.typeName,
    1,
    index
  )
}

function checkTypes(ast: AstProgram): TypeResult {
  let tokens = ast.tokens
  let variables = map("unused", "unused")
  let functions = map("unused", "unused")
  let index: i32 = 0
  let checked: i32 = 0
  let currentReturnType = "void"

  while index < tokens.count do {
    let declarationToken = tokenArenaGet(tokens, index)
    let current = typeTokenValue(declarationToken)
    let isKeyword = stringEquals(typeTokenKind(declarationToken), "keyword")
    if isKeyword && stringEquals(current, "struct") {
      let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
      variables = mapSet(variables, structTypeKey(name), "declared")
    }
    if isKeyword && stringEquals(current, "enum") {
      let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
      variables = mapSet(variables, structTypeKey(name), "declared")
    }
    if isKeyword && stringEquals(current, "function") {
      functions = registerFunctionType(tokens, index, functions)
    }
    index = index + 1
  }

  index = 0
  while index < tokens.count do {
    let token = tokenArenaGet(tokens, index)
    let current = typeTokenValue(token)
    let isKeyword = stringEquals(typeTokenKind(token), "keyword")
    if isKeyword && stringEquals(current, "struct") {
      variables = registerStructType(tokens, index, variables)
    }
    index = index + 1
  }

  let typeDefinitions = variables
  index = 0
  while index < tokens.count do {
    let token = tokenArenaGet(tokens, index)
    let current = typeTokenValue(token)
    let following = tokenArenaGet(tokens, index + 1)
    let followingValue = typeTokenValue(following)
    let isKeyword = stringEquals(typeTokenKind(token), "keyword")

    if isKeyword && stringEquals(current, "function") {
      variables = typeDefinitions
      variables = registerFunctionParameters(tokens, index, variables)
      let name = typeTokenValue(tokenArenaGet(tokens, index + 1))
      currentReturnType = mapGet(functions, functionReturnKey(name))
      if typeIsTask(currentReturnType) {
        currentReturnType = typeTaskValue(currentReturnType)
      }
    }

    if isKeyword &&
      (stringEquals(current, "let") || stringEquals(current, "const")) {
      let result = typeCheckVariable(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
      variables = registerVariableType(tokens, index, variables, functions)
    }

    let assignmentStart: bool = false
    if stringEquals(followingValue, "=") &&
      !stringEquals(typeTokenKind(following), "string") {
      assignmentStart = true
      if index > 0 {
        if stringEquals(typeTokenValue(tokenArenaGet(tokens, index - 1)), ".") {
          assignmentStart = false
        }
      }
    }
    if stringEquals(followingValue, ".") {
      if stringEquals(typeTokenValue(tokenArenaGet(tokens, index + 3)), "=") {
        assignmentStart = true
      }
    }
    if stringEquals(followingValue, "[") {
      let isTypeAnnotation: bool = false
      if index > 0 {
        isTypeAnnotation = stringEquals(
          typeTokenValue(tokenArenaGet(tokens, index - 1)),
          ":"
        )
      }
      if !isTypeAnnotation {
        let assignmentClose = typeFindMatching(
          tokens,
          index + 1,
          tokens.count,
          "[",
          "]"
        )
        if stringEquals(
          typeTokenValue(tokenArenaGet(tokens, assignmentClose + 1)),
          "="
        ) {
          assignmentStart = true
        }
      }
    }
    if assignmentStart {
      let result = checkAssignment(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "return") {
      let result = checkReturnType(
        tokens,
        index,
        variables,
        functions,
        currentReturnType
      )
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "throw") {
      let result = checkThrowType(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "of") {
      let result = checkForOfType(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "switch") {
      let result = checkSwitchCases(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "if") {
      let result = checkIfCondition(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if isKeyword && stringEquals(current, "while") {
      let result = checkWhileCondition(tokens, index, variables, functions)
      checked = checked + result.checkedCount
      if !result.ok {
        return typeError(result.message, checked, result.tokenIndex)
      }
    }

    if stringEquals(followingValue, "(") &&
      stringEquals(typeTokenKind(token), "identifier") {
      let isDeclaration: bool = false
      if index > 0 {
        isDeclaration = stringEquals(
          typeTokenValue(tokenArenaGet(tokens, index - 1)),
          "function"
        )
      }
      if !isDeclaration {
        let result = checkFunctionCall(tokens, index, variables, functions)
        checked = checked + result.checkedCount
        if !result.ok {
          return typeError(result.message, checked, result.tokenIndex)
        }
      }
    }

    index = index + 1
  }

  return typeOk(checked)
}
