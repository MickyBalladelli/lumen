import { IrModule, IrStatement, IrFunction, irStatementFromProgram, irFunctionFromProgram, typedIrValid } from "./ir.lm"

function emitIr(ir: IrModule): string {
  if !typedIrValid(ir.typed) {
    return "; invalid typed IR\n"
  }

  return emitStatementMainIr(ir, ir.program)
}

function statementPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "statement")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function binaryValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%bin.")
  out = stringBuilderAppend(out, slot)
  return out
}

function callValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%call.")
  out = stringBuilderAppend(out, slot)
  return out
}

function statementAt(ir: IrModule, program: string, index: i32): IrStatement {
  return irStatementFromProgram(program, index)
}

function functionAt(ir: IrModule, program: string, index: i32): IrFunction {
  return irFunctionFromProgram(program, index)
}

function resolvedStatementExprKind(statement: IrStatement, symbols: string): string {
  let kind = statement.expressionKind
  let value = statement.expressionValue
  let resolvedKind = statement.resolvedKind

  if includes(kind, "call") {
    return "number"
  }

  if includes(kind, "binary") {
    return "number"
  }

  if includes(kind, "identifier") {
    let resolved = mapGet(symbols, value + "Kind")
    if includes(resolved, "string") {
      return resolved
    }
    if includes(resolved, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedKind
  }

  if includes(resolvedKind, "number") {
    return resolvedKind
  }

  return kind
}

function resolvedStatementExprValue(statement: IrStatement, symbols: string): string {
  let kind = statement.expressionKind
  let value = statement.expressionValue
  let resolvedKind = statement.resolvedKind
  let resolvedValue = statement.resolvedValue

  if includes(kind, "call") {
    return value
  }

  if includes(kind, "binary") {
    return value
  }

  if includes(kind, "identifier") {
    let resolvedKind = mapGet(symbols, value + "Kind")
    let resolved = mapGet(symbols, value + "Value")
    if includes(resolvedKind, "string") {
      return resolved
    }
    if includes(resolvedKind, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedValue
  }

  if includes(resolvedKind, "number") {
    return resolvedValue
  }

  return value
}

function addStructFieldSymbols(symbols: string, name: string, value: string): string {
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]

    if stringEquals(ch, ":") {
      let fieldStart = index + 1
      let cursor = fieldStart

      while cursor < length do {
        let current = value[cursor..cursor + 1]
        if stringEquals(current, "=") {
          let fieldName = value[fieldStart..cursor]
          let valueStart = cursor + 1
          let valueEnd = valueStart

          while valueEnd < length do {
            let next = value[valueEnd..valueEnd + 1]
            if stringEquals(next, ":") {
              let fieldKey = name + "." + fieldName
              symbols = mapSet(symbols, fieldKey + "Kind", "number")
              symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..valueEnd])
              index = valueEnd
              break
            }

            valueEnd = valueEnd + 1
          }

          if valueEnd >= length {
            let fieldKey = name + "." + fieldName
            symbols = mapSet(symbols, fieldKey + "Kind", "number")
            symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..length])
            index = length
          }
        }

        if stringEquals(current, ":") {
          break
        }

        cursor = cursor + 1
      }
    }

    index = index + 1
  }

  return symbols
}

function buildStatementSymbols(program: string): string {
  let symbols = map("unused", "unused")
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "assign") {
      let name = mapGet(program, prefix + "Name")
      symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
      symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
    }

    if includes(kind, "while") {
      let name = mapGet(program, prefix + "BodyAssignName")
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
    }

    if includes(kind, "for") {
      let name = mapGet(program, prefix + "BodyAssignName")
      let loopName = mapGet(program, prefix + "LoopVariable")
      let initial = mapGet(symbols, name + "Value")
      symbols = mapSet(symbols, name + "InitialValue", initial)
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
      symbols = mapSet(symbols, loopName + "Kind", "number")
      symbols = mapSet(symbols, loopName + "Value", "%" + loopName + ".done")
    }

    index = index + 1
  }

  return symbols
}

function resolvedExprKind(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")

  if includes(kind, "call") {
    return "number"
  }

  if includes(kind, "binary") {
    return "number"
  }

  if includes(kind, "identifier") {
    let resolved = mapGet(symbols, value + "Kind")
    if includes(resolved, "string") {
      return resolved
    }
    if includes(resolved, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedKind
  }

  if includes(resolvedKind, "number") {
    return resolvedKind
  }

  return kind
}

function resolvedExprValue(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")
  let resolvedValue = mapGet(program, prefix + "ResolvedValue")

  if includes(kind, "call") {
    return value
  }

  if includes(kind, "binary") {
    return value
  }

  if includes(kind, "identifier") {
    let resolvedKind = mapGet(symbols, value + "Kind")
    let resolved = mapGet(symbols, value + "Value")
    if includes(resolvedKind, "string") {
      return resolved
    }
    if includes(resolvedKind, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedValue
  }

  if includes(resolvedKind, "number") {
    return resolvedValue
  }

  return value
}

function hasForStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "for") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasWhileStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      return true
    }

    index = index + 1
  }

  return false
}

function resolvedNumberAtom(symbols: string, value: string): string {
  let resolved = mapGet(symbols, value + "Value")
  if includes(resolved, "%") {
    return resolved
  }

  if includes(mapGet(symbols, value + "Kind"), "number") {
    return resolved
  }

  return value
}

function hasFunction(program: string): bool {
  let count = stringToInt(mapGet(program, "functionCount"))
  return count > 0
}

function hasFunctionIr(ir: IrModule): bool {
  if ir.functionCount > 0 {
    if stringEquals(ir.function0Name, "") {
      return false
    }

    return true
  }

  return false
}

function hasForStatementIr(ir: IrModule, program: string): bool {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "for") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasWhileStatementIr(ir: IrModule, program: string): bool {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "while") {
      return true
    }

    index = index + 1
  }

  return false
}

function buildStatementSymbolsIr(ir: IrModule, program: string): string {
  let symbols = map("unused", "unused")
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      let name = statement.name
      if includes(statement.expressionKind, "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(statement.expressionKind, "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(statement.resolvedKind, "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", statement.resolvedValue)
        symbols = addStructFieldSymbols(symbols, name, statement.resolvedValue)
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
        symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "const") {
      let name = statement.name
      if includes(statement.expressionKind, "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(statement.expressionKind, "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(statement.resolvedKind, "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", statement.resolvedValue)
        symbols = addStructFieldSymbols(symbols, name, statement.resolvedValue)
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
        symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "assign") {
      let name = statement.name
      symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
      symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
    }

    if includes(statement.kind, "while") {
      let name = statement.bodyAssignName
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
    }

    if includes(statement.kind, "for") {
      let name = statement.bodyAssignName
      let initial = mapGet(symbols, name + "Value")
      symbols = mapSet(symbols, name + "InitialValue", initial)
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
      symbols = mapSet(symbols, statement.loopVariable + "Kind", "number")
      symbols = mapSet(symbols, statement.loopVariable + "Value", "%" + statement.loopVariable + ".done")
    }

    index = index + 1
  }

  return symbols
}

function emitStatementMainIr(ir: IrModule, program: string): string {
  let symbols = buildStatementSymbolsIr(ir, program)
  let returnValue = ir.returnValue
  let hasFor = hasForStatementIr(ir, program)
  let hasWhile = hasWhileStatementIr(ir, program)
  let out = stringBuilder()

  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
  if hasFunctionIr(ir) {
    out = emitFunctionDefinitionsIr(out, ir, program)
  }

  let globalIndex: i32 = 0
  while globalIndex < ir.statementCount do {
    let statement = statementAt(ir, program, globalIndex)

    if includes(statement.kind, "println") {
      let kind = resolvedStatementExprKind(statement, symbols)
      let value = resolvedStatementExprValue(statement, symbols)
      if includes(kind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), value)
      }
    }

    if includes(statement.kind, "if") {
      if includes(statement.bodyExpressionKind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), statement.bodyExpressionValue)
      }
    }

    if includes(statement.kind, "return") {
      returnValue = resolvedStatementExprValue(statement, symbols)
    }

    globalIndex = globalIndex + 1
  }

  out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  out = stringBuilderAppend(out, "define i32 @main() {
")
  out = stringBuilderAppend(out, "entry:
")
  out = emitLocalStorageIr(out, ir, program, symbols)
  if hasFor {
    out = emitForStatementsIr(out, ir, program, symbols)
  }
  out = emitBinaryStatementsIr(out, ir, program, symbols)
  out = emitCallStatementsIr(out, ir, program, symbols)
  if hasWhile {
    out = emitWhileStatementsIr(out, ir, program, symbols)
  }

  let emitIndex: i32 = 0
  while emitIndex < ir.statementCount do {
    let statement = statementAt(ir, program, emitIndex)

    if includes(statement.kind, "println") {
      out = emitPrint(out, intToString(emitIndex), resolvedStatementExprKind(statement, symbols), resolvedStatementExprValue(statement, symbols))
    }

    if includes(statement.kind, "if") {
      out = emitIfStatementIr(out, intToString(emitIndex), symbols, statement)
    }

    emitIndex = emitIndex + 1
  }

  out = stringBuilderAppend(out, "  ret i32 ")
  out = stringBuilderAppend(out, returnValue)
  out = stringBuilderAppend(out, "
}
")

  return out
}

function emitStatementMain(program: string): string {
  let symbols = buildStatementSymbols(program)
  let returnValue = mapGet(program, "mainReturnValue")
  let statementCount = stringToInt(mapGet(program, "statementCount"))
  let hasFor = hasForStatement(program)
  let hasWhile = hasWhileStatement(program)
  let out = stringBuilder()

  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
  if hasFunction(program) {
    out = emitFunctionDefinitions(out, program)
  }

  let globalIndex: i32 = 0
  while globalIndex < statementCount do {
    let prefix = statementPrefix(globalIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      let kind = resolvedExprKind(program, symbols, prefix)
      let value = resolvedExprValue(program, symbols, prefix)
      if includes(kind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), value)
      }
    }

    if includes(statementKind, "if") {
      let bodyKind = mapGet(program, prefix + "BodyExprKind")
      let bodyValue = mapGet(program, prefix + "BodyExprValue")
      if includes(bodyKind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), bodyValue)
      }
    }

    if includes(statementKind, "return") {
      returnValue = resolvedExprValue(program, symbols, prefix)
    }

    globalIndex = globalIndex + 1
  }

  out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  out = stringBuilderAppend(out, "define i32 @main() {
")
  out = stringBuilderAppend(out, "entry:
")
  out = emitLocalStorage(out, program, symbols)
  if hasFor {
    out = emitForStatements(out, program, symbols)
  }
  out = emitBinaryStatements(out, program, symbols)
  out = emitCallStatements(out, program, symbols)
  if hasWhile {
    out = emitWhileStatements(out, program, symbols)
  }

  let emitIndex: i32 = 0
  while emitIndex < statementCount do {
    let prefix = statementPrefix(emitIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      out = emitPrint(out, intToString(emitIndex), resolvedExprKind(program, symbols, prefix), resolvedExprValue(program, symbols, prefix))
    }

    if includes(statementKind, "if") {
      out = emitIfStatement(out, intToString(emitIndex), program, symbols, prefix)
    }

    emitIndex = emitIndex + 1
  }

  out = stringBuilderAppend(out, "  ret i32 ")
  out = stringBuilderAppend(out, returnValue)
  out = stringBuilderAppend(out, "
}
")

  return out
}

function emitLocalStorage(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")
    let name = mapGet(program, prefix + "Name")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    index = index + 1
  }

  return out
}

function emitLocalStorageIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "binary") {
        let skippedBinary = 1
      } else if includes(statement.expressionKind, "call") {
        let skippedCall = 1
      } else if includes(resolvedStatementExprKind(statement, symbols), "number") {
        out = emitLocalStore(out, statement.name, resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "binary") {
        let skippedBinary = 1
      } else if includes(statement.expressionKind, "call") {
        let skippedCall = 1
      } else if includes(resolvedStatementExprKind(statement, symbols), "number") {
        out = emitLocalStore(out, statement.name, resolvedStatementExprValue(statement, symbols))
      }
    }

    index = index + 1
  }

  return out
}

function emitLocalStore(out: string, name: string, value: string): string {
  if includes(value, "%") {
    return out
  }

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 ")
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr
")

  return out
}

function functionPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "function")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function emitFunctionDefinitions(out: string, program: string): string {
  let count = stringToInt(mapGet(program, "functionCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = functionPrefix(index)
    let name = mapGet(program, prefix + "Name")
    let param0 = mapGet(program, prefix + "Param0")
    let param1 = mapGet(program, prefix + "Param1")
    let paramCount = mapGet(program, prefix + "ParamCount")
    let operator = mapGet(program, prefix + "ReturnValue")
    let left = mapGet(program, prefix + "ReturnLeftValue")
    let right = mapGet(program, prefix + "ReturnRightValue")

    out = stringBuilderAppend(out, "define i32 @")
    out = stringBuilderAppend(out, name)
    out = stringBuilderAppend(out, "(i32 %")
    out = stringBuilderAppend(out, param0)
    if stringEquals(paramCount, "2") {
      out = stringBuilderAppend(out, ", i32 %")
      out = stringBuilderAppend(out, param1)
    }
    out = stringBuilderAppend(out, ") {
entry:
")
    if stringEquals(operator, "*") {
      out = stringBuilderAppend(out, "  %fn.ret = mul i32 ")
    } else {
      out = stringBuilderAppend(out, "  %fn.ret = add i32 ")
    }
    out = emitFunctionAtom(out, left, param0, param1)
    out = stringBuilderAppend(out, ", ")
    out = emitFunctionAtom(out, right, param0, param1)
    out = stringBuilderAppend(out, "
")
    out = stringBuilderAppend(out, "  ret i32 %fn.ret
}
")

    index = index + 1
  }

  return out
}

function emitFunctionDefinitionsIr(out: string, ir: IrModule, program: string): string {
  let index: i32 = 0

  while index < ir.functionCount do {
    let fn = functionAt(ir, program, index)
    let name = fn.name
    let param0 = fn.param0
    let param1 = fn.param1
    let paramCount = fn.paramCount
    let operator = fn.returnValue
    let left = fn.returnLeftValue
    let right = fn.returnRightValue

    out = stringBuilderAppend(out, "define i32 @")
    out = stringBuilderAppend(out, name)
    out = stringBuilderAppend(out, "(i32 %")
    out = stringBuilderAppend(out, param0)
    if stringEquals(paramCount, "2") {
      out = stringBuilderAppend(out, ", i32 %")
      out = stringBuilderAppend(out, param1)
    }
    out = stringBuilderAppend(out, ") {
entry:
")
    if stringEquals(operator, "*") {
      out = stringBuilderAppend(out, "  %fn.ret = mul i32 ")
    } else {
      out = stringBuilderAppend(out, "  %fn.ret = add i32 ")
    }
    out = emitFunctionAtom(out, left, param0, param1)
    out = stringBuilderAppend(out, ", ")
    out = emitFunctionAtom(out, right, param0, param1)
    out = stringBuilderAppend(out, "
")
    out = stringBuilderAppend(out, "  ret i32 %fn.ret
}
")

    index = index + 1
  }

  return out
}

function emitFunctionAtom(out: string, value: string, param0: string, param1: string): string {
  if stringEquals(value, param0) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  if stringEquals(value, param1) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  out = stringBuilderAppend(out, value)
  return out
}

function emitCallStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitCallStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "call") {
        out = emitCallIr(out, intToString(index), symbols, statement)
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "call") {
        out = emitCallIr(out, intToString(index), symbols, statement)
      }
    }

    index = index + 1
  }

  return out
}

function emitCallIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let name = statement.expressionValue
  let arg0 = resolvedNumberAtom(symbols, statement.expressionCallArg0)
  let arg1 = resolvedNumberAtom(symbols, statement.expressionCallArg1)
  let argCount = statement.expressionCallArgCount

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, callValueName(slot))
  out = stringBuilderAppend(out, " = call i32 @")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, "(i32 ")
  out = stringBuilderAppend(out, arg0)
  if stringEquals(argCount, "2") {
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, arg1)
  }
  out = stringBuilderAppend(out, ")
")

  return out
}

function emitCall(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let name = mapGet(program, prefix + "ExprValue")
  let arg0 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg0"))
  let arg1 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg1"))
  let argCount = mapGet(program, prefix + "ExprCallArgCount")

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, callValueName(slot))
  out = stringBuilderAppend(out, " = call i32 @")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, "(i32 ")
  out = stringBuilderAppend(out, arg0)
  if stringEquals(argCount, "2") {
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, arg1)
  }
  out = stringBuilderAppend(out, ")
")

  return out
}

function emitBinaryStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitBinaryStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "binary") {
        out = emitBinaryAddIr(out, intToString(index), symbols, statement)
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "binary") {
        out = emitBinaryAddIr(out, intToString(index), symbols, statement)
      }
    }

    index = index + 1
  }

  return out
}

function emitBinaryAddIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let left = resolvedNumberAtom(symbols, statement.expressionLeftValue)
  let right = resolvedNumberAtom(symbols, statement.expressionRightValue)

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, binaryValueName(slot))
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, left)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, right)
  out = stringBuilderAppend(out, "
")

  return out
}

function emitBinaryAdd(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let left = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprLeftValue"))
  let right = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprRightValue"))

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, binaryValueName(slot))
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, left)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, right)
  out = stringBuilderAppend(out, "
")

  return out
}

function llvmIntegerPredicate(operator: string): string {
  if stringEquals(operator, "==") {
    return "eq"
  }
  if stringEquals(operator, "!=") {
    return "ne"
  }
  if stringEquals(operator, "<=") {
    return "sle"
  }
  if stringEquals(operator, ">") {
    return "sgt"
  }
  if stringEquals(operator, ">=") {
    return "sge"
  }
  return "slt"
}

function emitForStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let statement = irStatementFromProgram(program, index)
    if includes(statement.kind, "for") {
      out = emitForStatement(out, intToString(index), symbols, statement)
    }
    index = index + 1
  }

  return out
}

function emitForStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "for") {
      out = emitForStatement(out, intToString(index), symbols, statement)
    }
    index = index + 1
  }

  return out
}

function emitLoopControl(out: string, slot: string, label: string, operator: string, value: string, loopName: string, destination: string, next: string): string {
  if stringEquals(operator, "") {
    return out
  }

  out = stringBuilderAppend(out, "  %for.")
  out = stringBuilderAppend(out, label)
  out = stringBuilderAppend(out, ".")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp ")
  out = stringBuilderAppend(out, llvmIntegerPredicate(operator))
  out = stringBuilderAppend(out, " i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %for.")
  out = stringBuilderAppend(out, label)
  out = stringBuilderAppend(out, ".")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, destination)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, next)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, next)
  out = stringBuilderAppend(out, ":
")
  return out
}

function forOperand(statement: IrStatement, symbols: string, value: string, slot: string): string {
  if stringEquals(value, statement.bodyAssignName) {
    return "%" + value + ".body." + slot
  }
  if stringEquals(value, statement.loopVariable) {
    return "%" + value + ".body." + slot
  }
  return resolvedNumberAtom(symbols, value)
}

function emitForStatement(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let loopName = statement.loopVariable
  let assignName = statement.bodyAssignName
  let condition = llvmIntegerPredicate(statement.loopCompareOperator)
  let bodyLabel = "for.body." + slot
  let operationLabel = "for.operation." + slot
  let updateLabel = "for.update." + slot
  let endLabel = "for.end." + slot

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 ")
  out = stringBuilderAppend(out, statement.loopInitialValue)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  br label %for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  %for.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp ")
  out = stringBuilderAppend(out, condition)
  out = stringBuilderAppend(out, " i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, statement.loopBoundValue)
  out = stringBuilderAppend(out, "
  br i1 %for.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, bodyLabel)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, endLabel)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, bodyLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")

  out = emitLoopControl(out, slot, "continue", statement.continueOperator, statement.continueValue, loopName, updateLabel, "for.after.continue." + slot)
  out = emitLoopControl(out, slot, "break", statement.breakOperator, statement.breakValue, loopName, endLabel, operationLabel)
  if stringEquals(statement.breakOperator, "") {
    if stringEquals(statement.continueOperator, "") {
      out = stringBuilderAppend(out, "  br label %")
      out = stringBuilderAppend(out, operationLabel)
      out = stringBuilderAppend(out, "
")
    } else {
      out = stringBuilderAppend(out, "  br label %")
      out = stringBuilderAppend(out, operationLabel)
      out = stringBuilderAppend(out, "
")
    }
    out = stringBuilderAppend(out, operationLabel)
    out = stringBuilderAppend(out, ":
")
  }

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, forOperand(statement, symbols, statement.bodyAddLeft, slot))
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, forOperand(statement, symbols, statement.bodyAddRight, slot))
  out = stringBuilderAppend(out, "
  store i32 %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  br label %")
  out = stringBuilderAppend(out, updateLabel)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, updateLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, statement.loopUpdateValue)
  out = stringBuilderAppend(out, "
  store i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  br label %for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, endLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")
  return out
}

function emitWhileStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      out = emitWhileStatement(out, intToString(index), program, symbols, prefix)
    }

    index = index + 1
  }

  return out
}

