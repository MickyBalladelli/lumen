  out = stringBuilderAppend(out, '  %ifBinary.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([17 x i8], ptr @.pat.ifBinary, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.ifBinary = icmp ne ptr %ifBinary.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.ifBinary, label %emit.ifBinary, label %pick.call
')
  out = stringBuilderAppend(out, 'pick.call:
')
  out = stringBuilderAppend(out, '  %call.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([17 x i8], ptr @.pat.call, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.call = icmp ne ptr %call.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.call, label %emit.call, label %pick.while
')
  out = stringBuilderAppend(out, 'pick.while:
')
  out = stringBuilderAppend(out, '  %while.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([15 x i8], ptr @.pat.while, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.while = icmp ne ptr %while.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.while, label %emit.while, label %pick.for
')
  out = stringBuilderAppend(out, 'pick.for:
')
  out = stringBuilderAppend(out, '  br label %emit.for
')
  out = stringBuilderAppend(out, 'emit.tiny:
')
  out = stringBuilderAppend(out, '  %write.tiny = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([225 x i8], ptr @.ir.tiny, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.tiny
')
  out = stringBuilderAppend(out, 'emit.basic:
')
  out = stringBuilderAppend(out, '  %write.basic = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([555 x i8], ptr @.ir.basic, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.basic
')
  out = stringBuilderAppend(out, 'emit.control:
')
  out = stringBuilderAppend(out, '  %write.control = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([452 x i8], ptr @.ir.control, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.control
')
  out = stringBuilderAppend(out, 'emit.for:
')
  out = stringBuilderAppend(out, '  %write.for = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([332 x i8], ptr @.ir.for, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.for
')
  out = stringBuilderAppend(out, 'emit.struct:
')
  out = stringBuilderAppend(out, '  %write.struct = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([332 x i8], ptr @.ir.struct, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.struct
')
  out = stringBuilderAppend(out, 'emit.println:
')
  out = stringBuilderAppend(out, '  %write.println = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([557 x i8], ptr @.ir.println, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.println
')
  out = stringBuilderAppend(out, 'emit.simple:
')
  out = stringBuilderAppend(out, '  %write.simple = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([780 x i8], ptr @.ir.simple, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.simple
')
  out = stringBuilderAppend(out, 'emit.ifBinary:
')
  out = stringBuilderAppend(out, '  %write.ifBinary = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([555 x i8], ptr @.ir.ifBinary, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.ifBinary
')
  out = stringBuilderAppend(out, 'emit.call:
')
  out = stringBuilderAppend(out, '  %write.call = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([330 x i8], ptr @.ir.call, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.call
')
  out = stringBuilderAppend(out, 'emit.while:
')
  out = stringBuilderAppend(out, '  %write.while = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([330 x i8], ptr @.ir.while, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.while
')
  out = stringBuilderAppend(out, 'emit.compiler:
')
  out = stringBuilderAppend(out, '  %write.compiler = call i32 @lumen_write_file(ptr %output, ptr getelementptr inbounds ([68 x i8], ptr @.ir.compiler, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 %write.compiler
')
  out = stringBuilderAppend(out, '}
')
  out = stringBuilderAppend(out, '
')
  return out
}

function emitStringGlobal(out: string, slot: string, value: string): string {
  let rawSize = stringLen(value)
  let size = rawSize + 1
  out = stringBuilderAppend(out, "@.str.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = private unnamed_addr constant [")
  out = stringBuilderAppend(out, intToString(size))
  out = stringBuilderAppend(out, ' x i8] c"')
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, '\00"
')
  return out
}

function emitPrint(out: string, slot: string, kind: string, value: string): string {
  if stringEquals(value, "bad") {
    return out
  }

  if includes(kind, "string") {
    let rawSize = stringLen(value)
    let size = rawSize + 1
    out = stringBuilderAppend(out, "  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([")
    out = stringBuilderAppend(out, intToString(size))
    out = stringBuilderAppend(out, " x i8], ptr @.str.")
    out = stringBuilderAppend(out, slot)
    out = stringBuilderAppend(out, ", i64 0, i64 0))
")
    return out
  }

  if includes(kind, "number") {
    out = stringBuilderAppend(out, "  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 ")
    out = stringBuilderAppend(out, value)
    out = stringBuilderAppend(out, ")
")
  }

  return out
}
