function emitIfStatement(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let leftName = mapGet(program, prefix + "ExprLeftValue")
  let rightValue = mapGet(program, prefix + "ExprRightValue")
  let leftValue = mapGet(symbols, leftName + "Value")

  if stringEquals(leftValue, "") || stringEquals(rightValue, "") {
    return out
  }

  out = stringBuilderAppend(out, "  %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp eq i32 ")
  out = stringBuilderAppend(out, leftValue)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, rightValue)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = emitPrint(out, slot, mapGet(program, prefix + "BodyExprKind"), mapGet(program, prefix + "BodyExprValue"))
  out = stringBuilderAppend(out, "  br label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")

  return out
}

function emitIfStatementIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let leftName = statement.expressionLeftValue
  let rightValue = statement.expressionRightValue
  let leftValue = mapGet(symbols, leftName + "Value")

  if stringEquals(leftValue, "") || stringEquals(rightValue, "") {
    return out
  }

  out = stringBuilderAppend(out, "  %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp eq i32 ")
  out = stringBuilderAppend(out, leftValue)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, rightValue)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = emitPrint(out, slot, statement.bodyExpressionKind, statement.bodyExpressionValue)
  out = stringBuilderAppend(out, "  br label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")

  return out
}

function emitStringGlobal(out: string, slot: string, value: string): string {
  let rawSize = stringLen(value)
  let size = rawSize + 1
  out = stringBuilderAppend(out, "@.str.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = private unnamed_addr constant [")
  out = stringBuilderAppend(out, intToString(size))
  out = stringBuilderAppend(out, ' x i8] c"')
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, '\00"
')
  return out
}

function emitPrint(out: string, slot: string, kind: string, value: string): string {
  if includes(kind, "string") {
    let rawSize = stringLen(value)
    let size = rawSize + 1
    out = stringBuilderAppend(out, "  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([")
    out = stringBuilderAppend(out, intToString(size))
    out = stringBuilderAppend(out, " x i8], ptr @.str.")
    out = stringBuilderAppend(out, slot)
    out = stringBuilderAppend(out, ", i64 0, i64 0))
")
    return out
  }

  if includes(kind, "number") {
    out = stringBuilderAppend(out, "  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 ")
    out = stringBuilderAppend(out, value)
    out = stringBuilderAppend(out, ")
")
  }

  return out
}
