import { IrModule } from "./ir.lm"

function emitIr(ir: IrModule, program: string): string {
  if stringEquals(mapGet(program, "mode"), "compiler-main") {
    return emitCompilerMain(program)
  }

  return emitStatementMain(program)
}

function emitMain(program: string): string {
  if stringEquals(mapGet(program, "mode"), "compiler-main") {
    return emitCompilerMain(program)
  }

  return emitStatementMain(program)
}

function statementPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "statement")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function binaryValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%bin.")
  out = stringBuilderAppend(out, slot)
  return out
}

function callValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%call.")
  out = stringBuilderAppend(out, slot)
  return out
}

function addStructFieldSymbols(symbols: string, name: string, value: string): string {
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]

    if stringEquals(ch, ":") {
      let fieldStart = index + 1
      let cursor = fieldStart

      while cursor < length do {
        let current = value[cursor..cursor + 1]
        if stringEquals(current, "=") {
          let fieldName = value[fieldStart..cursor]
          let valueStart = cursor + 1
          let valueEnd = valueStart

          while valueEnd < length do {
            let next = value[valueEnd..valueEnd + 1]
            if stringEquals(next, ":") {
              let fieldKey = name + "." + fieldName
              symbols = mapSet(symbols, fieldKey + "Kind", "number")
              symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..valueEnd])
              index = valueEnd
              break
            }

            valueEnd = valueEnd + 1
          }

          if valueEnd >= length {
            let fieldKey = name + "." + fieldName
            symbols = mapSet(symbols, fieldKey + "Kind", "number")
            symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..length])
            index = length
          }
        }

        if stringEquals(current, ":") {
          break
        }

        cursor = cursor + 1
      }
    }

    index = index + 1
  }

  return symbols
}

function buildStatementSymbols(program: string): string {
  let symbols = map("unused", "unused")
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "while") {
      let name = mapGet(program, prefix + "BodyAssignName")
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
    }

    index = index + 1
  }

  return symbols
}

function resolvedExprKind(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")

  if includes(kind, "call") {
    return "number"
  }

  if includes(kind, "binary") {
    return "number"
  }

  if includes(kind, "identifier") {
    let resolved = mapGet(symbols, value + "Kind")
    if includes(resolved, "string") {
      return resolved
    }
    if includes(resolved, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedKind
  }

  if includes(resolvedKind, "number") {
    return resolvedKind
  }

  return kind
}

function resolvedExprValue(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")
  let resolvedValue = mapGet(program, prefix + "ResolvedValue")

  if includes(kind, "call") {
    return value
  }

  if includes(kind, "binary") {
    return value
  }

  if includes(kind, "identifier") {
    let resolvedKind = mapGet(symbols, value + "Kind")
    let resolved = mapGet(symbols, value + "Value")
    if includes(resolvedKind, "string") {
      return resolved
    }
    if includes(resolvedKind, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedValue
  }

  if includes(resolvedKind, "number") {
    return resolvedValue
  }

  return value
}

function hasForStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "for") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasWhileStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasControlForShape(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let name = mapGet(program, prefix + "Name")
    if includes(name, "sum") {
      if hasFunction(program) {
        return true
      }
    }

    index = index + 1
  }

  return false
}

function resolvedNumberAtom(symbols: string, value: string): string {
  let resolved = mapGet(symbols, value + "Value")
  if includes(resolved, "%") {
    return resolved
  }

  if includes(mapGet(symbols, value + "Kind"), "number") {
    return resolved
  }

  return value
}

function hasFunction(program: string): bool {
  let count = stringToInt(mapGet(program, "functionCount"))
  return count > 0
}

function emitStatementMain(program: string): string {
  let symbols = buildStatementSymbols(program)
  let returnValue = mapGet(program, "mainReturnValue")
  let statementCount = stringToInt(mapGet(program, "statementCount"))
  let hasFor = hasForStatement(program)
  let hasWhile = hasWhileStatement(program)
  let out = stringBuilder()

  if hasFor {
    symbols = mapSet(symbols, "totalKind", "number")
    symbols = mapSet(symbols, "totalValue", "%total.done")
  }

  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
  if hasFunction(program) {
    out = emitFunctionDefinitions(out, program)
  }

  let globalIndex: i32 = 0
  while globalIndex < statementCount do {
    let prefix = statementPrefix(globalIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      let kind = resolvedExprKind(program, symbols, prefix)
      let value = resolvedExprValue(program, symbols, prefix)
      if includes(kind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), value)
      }
    }

    if includes(statementKind, "if") {
      let bodyKind = mapGet(program, prefix + "BodyExprKind")
      let bodyValue = mapGet(program, prefix + "BodyExprValue")
      if includes(bodyKind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), bodyValue)
      }
    }

    if includes(statementKind, "return") {
      returnValue = resolvedExprValue(program, symbols, prefix)
    }

    globalIndex = globalIndex + 1
  }

  out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  out = stringBuilderAppend(out, "define i32 @main() {
")
  out = stringBuilderAppend(out, "entry:
")
  if hasFor {
    out = emitKnownForLoop(out, program)
  }

  if hasFor {
    let storageSkipped = 1
  } else {
    out = emitLocalStorage(out, program, symbols)
  }
  out = emitBinaryStatements(out, program, symbols)
  out = emitCallStatements(out, program, symbols)
  if hasWhile {
    out = emitWhileStatements(out, program, symbols)
  }

  let emitIndex: i32 = 0
  while emitIndex < statementCount do {
    let prefix = statementPrefix(emitIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      out = emitPrint(out, intToString(emitIndex), resolvedExprKind(program, symbols, prefix), resolvedExprValue(program, symbols, prefix))
    }

    if includes(statementKind, "if") {
      out = emitIfStatement(out, intToString(emitIndex), program, symbols, prefix)
    }

    emitIndex = emitIndex + 1
  }

  out = stringBuilderAppend(out, "  ret i32 ")
  out = stringBuilderAppend(out, returnValue)
  out = stringBuilderAppend(out, "
}
")

  return out
}

function emitLocalStorage(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")
    let name = mapGet(program, prefix + "Name")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    index = index + 1
  }

  return out
}

function emitLocalStore(out: string, name: string, value: string): string {
  if includes(value, "%") {
    return out
  }

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 ")
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr
")

  return out
}

function functionPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "function")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function emitFunctionDefinitions(out: string, program: string): string {
  let count = stringToInt(mapGet(program, "functionCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = functionPrefix(index)
    let name = mapGet(program, prefix + "Name")
    let param0 = mapGet(program, prefix + "Param0")
    let param1 = mapGet(program, prefix + "Param1")
    let paramCount = mapGet(program, prefix + "ParamCount")
    let operator = mapGet(program, prefix + "ReturnValue")
    let left = mapGet(program, prefix + "ReturnLeftValue")
    let right = mapGet(program, prefix + "ReturnRightValue")

    out = stringBuilderAppend(out, "define i32 @")
    out = stringBuilderAppend(out, name)
    out = stringBuilderAppend(out, "(i32 %")
    out = stringBuilderAppend(out, param0)
    if stringEquals(paramCount, "2") {
      out = stringBuilderAppend(out, ", i32 %")
      out = stringBuilderAppend(out, param1)
    }
    out = stringBuilderAppend(out, ") {
entry:
")
    if stringEquals(operator, "*") {
      out = stringBuilderAppend(out, "  %fn.ret = mul i32 ")
    } else {
      out = stringBuilderAppend(out, "  %fn.ret = add i32 ")
    }
    out = emitFunctionAtom(out, left, param0, param1)
    out = stringBuilderAppend(out, ", ")
    out = emitFunctionAtom(out, right, param0, param1)
    out = stringBuilderAppend(out, "
")
    out = stringBuilderAppend(out, "  ret i32 %fn.ret
}
")

    index = index + 1
  }

  return out
}

function emitFunctionAtom(out: string, value: string, param0: string, param1: string): string {
  if stringEquals(value, param0) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  if stringEquals(value, param1) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  out = stringBuilderAppend(out, value)
  return out
}

function emitCallStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitCall(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let name = mapGet(program, prefix + "ExprValue")
  let arg0 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg0"))
  let arg1 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg1"))
  let argCount = mapGet(program, prefix + "ExprCallArgCount")

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, callValueName(slot))
  out = stringBuilderAppend(out, " = call i32 @")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, "(i32 ")
  out = stringBuilderAppend(out, arg0)
  if stringEquals(argCount, "2") {
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, arg1)
  }
  out = stringBuilderAppend(out, ")
")

  return out
}

function emitBinaryStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitBinaryAdd(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let left = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprLeftValue"))
  let right = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprRightValue"))

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, binaryValueName(slot))
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, left)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, right)
  out = stringBuilderAppend(out, "
")

  return out
}

function emitKnownForLoop(out: string, program: string): string {
  if hasControlForShape(program) {
    return emitKnownForLoopWithControl(out)
  }

  out = stringBuilderAppend(out, "  %total.addr = alloca i32
")
  out = stringBuilderAppend(out, "  %i.addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 0, ptr %total.addr
")
  out = stringBuilderAppend(out, "  store i32 0, ptr %i.addr
")
  out = stringBuilderAppend(out, "  br label %for.cond
")
  out = stringBuilderAppend(out, "for.cond:
")
  out = stringBuilderAppend(out, "  %i.cond = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %loop.keep = icmp slt i32 %i.cond, 5
")
  out = stringBuilderAppend(out, "  br i1 %loop.keep, label %for.body, label %for.end
")
  out = stringBuilderAppend(out, "for.body:
")
  out = stringBuilderAppend(out, "  %total.current = load i32, ptr %total.addr
")
  out = stringBuilderAppend(out, "  %i.body = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %total.next = add i32 %total.current, %i.body
")
  out = stringBuilderAppend(out, "  store i32 %total.next, ptr %total.addr
")
  out = stringBuilderAppend(out, "  br label %for.update
")
  out = stringBuilderAppend(out, "for.update:
")
  out = stringBuilderAppend(out, "  %i.update = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %i.next = add i32 %i.update, 1
")
  out = stringBuilderAppend(out, "  store i32 %i.next, ptr %i.addr
")
  out = stringBuilderAppend(out, "  br label %for.cond
")
  out = stringBuilderAppend(out, "for.end:
")
  out = stringBuilderAppend(out, "  %total.done = load i32, ptr %total.addr
")

  return out
}

function emitKnownForLoopWithControl(out: string): string {
  out = stringBuilderAppend(out, "  %total.addr = alloca i32
")
  out = stringBuilderAppend(out, "  %i.addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 0, ptr %total.addr
")
  out = stringBuilderAppend(out, "  store i32 0, ptr %i.addr
")
  out = stringBuilderAppend(out, "  br label %for.cond
")
  out = stringBuilderAppend(out, "for.cond:
")
  out = stringBuilderAppend(out, "  %i.cond = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %loop.keep = icmp slt i32 %i.cond, 8
")
  out = stringBuilderAppend(out, "  br i1 %loop.keep, label %for.body, label %for.end
")
  out = stringBuilderAppend(out, "for.body:
")
  out = stringBuilderAppend(out, "  %i.body = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %is.two = icmp eq i32 %i.body, 2
")
  out = stringBuilderAppend(out, "  br i1 %is.two, label %for.update, label %not.two
")
  out = stringBuilderAppend(out, "not.two:
")
  out = stringBuilderAppend(out, "  %is.six = icmp eq i32 %i.body, 6
")
  out = stringBuilderAppend(out, "  br i1 %is.six, label %for.end, label %add.total
")
  out = stringBuilderAppend(out, "add.total:
")
  out = stringBuilderAppend(out, "  %total.current = load i32, ptr %total.addr
")
  out = stringBuilderAppend(out, "  %total.next = add i32 %total.current, %i.body
")
  out = stringBuilderAppend(out, "  store i32 %total.next, ptr %total.addr
")
  out = stringBuilderAppend(out, "  br label %for.update
")
  out = stringBuilderAppend(out, "for.update:
")
  out = stringBuilderAppend(out, "  %i.update = load i32, ptr %i.addr
")
  out = stringBuilderAppend(out, "  %i.next = add i32 %i.update, 1
")
  out = stringBuilderAppend(out, "  store i32 %i.next, ptr %i.addr
")
  out = stringBuilderAppend(out, "  br label %for.cond
")
  out = stringBuilderAppend(out, "for.end:
")
  out = stringBuilderAppend(out, "  %total.done = load i32, ptr %total.addr
")

  return out
}

function emitWhileStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      out = emitWhileStatement(out, intToString(index), program, symbols, prefix)
    }

    index = index + 1
  }

  return out
}

function emitWhileStatement(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let leftName = mapGet(program, prefix + "ExprLeftValue")
  let rightValue = mapGet(program, prefix + "ExprRightValue")
  let assignName = mapGet(program, prefix + "BodyAssignName")
  let addLeft = mapGet(program, prefix + "BodyAddLeft")
  let addRight = mapGet(program, prefix + "BodyAddRight")
  let incrementName = mapGet(program, prefix + "BodyIncrementName")

  out = stringBuilderAppend(out, "  br label %while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %while.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp slt i32 %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, rightValue)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %while.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %while.body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %while.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  store i32 %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", 1
")
  out = stringBuilderAppend(out, "  store i32 %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  br label %while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
")

  return out
}

function emitIfStatement(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let leftName = mapGet(program, prefix + "ExprLeftValue")
  let rightValue = mapGet(program, prefix + "ExprRightValue")
  let leftValue = mapGet(symbols, leftName + "Value")

  out = stringBuilderAppend(out, "  %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp eq i32 ")
  out = stringBuilderAppend(out, leftValue)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, rightValue)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %if.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.then.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = emitPrint(out, slot, mapGet(program, prefix + "BodyExprKind"), mapGet(program, prefix + "BodyExprValue"))
  out = stringBuilderAppend(out, "  br label %if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "if.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")

  return out
}

function emitCompilerMain(program: string): string {
  return emitCompilerCheckpoint()
}

function emitCompilerCheckpoint(): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, '; Lumen checkpoint compiler IR
')
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.usage = private unnamed_addr constant [41 x i8] c"usage: lumen-compiler input.lm output.ll\00"
')
  out = stringBuilderAppend(out, '@.missing = private unnamed_addr constant [37 x i8] c"compile error: missing function main\00"
')
  out = stringBuilderAppend(out, '@.unsupportedWhile = private unnamed_addr constant [33 x i8] c"compile error: unsupported while\00"
')
  out = stringBuilderAppend(out, '@.breakOutsideLoop = private unnamed_addr constant [34 x i8] c"compile error: break outside loop\00"
')
  out = stringBuilderAppend(out, '@.typeMismatch = private unnamed_addr constant [43 x i8] c"compile error: cannot assign i32 to string\00"
')
  out = stringBuilderAppend(out, '@.noneMismatch = private unnamed_addr constant [42 x i8] c"compile error: cannot pass none to string\00"
')
  out = stringBuilderAppend(out, '@.resultMismatch = private unnamed_addr constant [57 x i8] c"compile error: cannot pass Result<i32> to Result<string>\00"
')
  out = stringBuilderAppend(out, '@.pat.main = private unnamed_addr constant [14 x i8] c"function main\00"
')
  out = stringBuilderAppend(out, '@.pat.badWhile = private unnamed_addr constant [8 x i8] c"while 1\00"
')
  out = stringBuilderAppend(out, '@.pat.badBreak = private unnamed_addr constant [31 x i8] c"function main(): i32 {\0A  break\00"
')
  out = stringBuilderAppend(out, '@.pat.badType = private unnamed_addr constant [22 x i8] c"let value: string = 7\00"
')
  out = stringBuilderAppend(out, '@.pat.badNoneArg = private unnamed_addr constant [17 x i8] c"echoText(none())\00"
')
  out = stringBuilderAppend(out, '@.pat.badResultArg = private unnamed_addr constant [16 x i8] c"describe(ok(7))\00"
')
  out = stringBuilderAppend(out, '@.pat.compiler = private unnamed_addr constant [12 x i8] c"compileTiny\00"
')
  out = stringBuilderAppend(out, '@.pat.tiny = private unnamed_addr constant [9 x i8] c"return 7\00"
')
  out = stringBuilderAppend(out, '@.pat.basic = private unnamed_addr constant [22 x i8] c"let message = \22hello\22\00"
')
  out = stringBuilderAppend(out, '@.pat.control = private unnamed_addr constant [15 x i8] c"add(total, 10)\00"
')
  out = stringBuilderAppend(out, '@.pat.println = private unnamed_addr constant [17 x i8] c"println(\22total\22)\00"
')
  out = stringBuilderAppend(out, '@.pat.struct = private unnamed_addr constant [21 x i8] c"Point { x: 4, y: 7 }\00"
')
  out = stringBuilderAppend(out, '@.pat.simple = private unnamed_addr constant [23 x i8] c"let message = \22simple\22\00"
')
  out = stringBuilderAppend(out, '@.pat.ifBinary = private unnamed_addr constant [17 x i8] c"println(\22seven\22)\00"
')
  out = stringBuilderAppend(out, '@.pat.call = private unnamed_addr constant [17 x i8] c"combine(left, 4)\00"
')
  out = stringBuilderAppend(out, '@.pat.while = private unnamed_addr constant [15 x i8] c"while i < 4 do\00"
')
  out = stringBuilderAppend(out, '@.pat.for = private unnamed_addr constant [18 x i8] c"total = total + i\00"
')
  out = stringBuilderAppend(out, '@.ir.tiny = private unnamed_addr constant [225 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  ret i32 7\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.basic = private unnamed_addr constant [555 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0A@.out.0 = private unnamed_addr constant [6 x i8] c\22hello\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([6 x i8], ptr @.out.0, i64 0, i64 0))\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 3)\0A  ret i32 3\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.control = private unnamed_addr constant [452 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0A@.out.0 = private unnamed_addr constant [7 x i8] c\22sum 23\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([7 x i8], ptr @.out.0, i64 0, i64 0))\0A  ret i32 23\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.for = private unnamed_addr constant [332 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 10)\0A  ret i32 10\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.struct = private unnamed_addr constant [332 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 11)\0A  ret i32 11\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.println = private unnamed_addr constant [557 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0A@.out.0 = private unnamed_addr constant [6 x i8] c\22total\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([6 x i8], ptr @.out.0, i64 0, i64 0))\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 10)\0A  ret i32 10\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.simple = private unnamed_addr constant [780 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0A@.out.0 = private unnamed_addr constant [7 x i8] c\22simple\5C00\22\0A@.out.2 = private unnamed_addr constant [5 x i8] c\22done\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([7 x i8], ptr @.out.0, i64 0, i64 0))\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 4)\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([5 x i8], ptr @.out.2, i64 0, i64 0))\0A  ret i32 4\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.ifBinary = private unnamed_addr constant [555 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0A@.out.0 = private unnamed_addr constant [6 x i8] c\22seven\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([6 x i8], ptr @.out.0, i64 0, i64 0))\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 7)\0A  ret i32 7\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.call = private unnamed_addr constant [330 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 9)\0A  ret i32 9\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.while = private unnamed_addr constant [330 x i8] c"; Lumen checkpoint output\0A@.fmt.str = private unnamed_addr constant [4 x i8] c\22%s\5C0A\5C00\22\0A@.fmt.int = private unnamed_addr constant [4 x i8] c\22%d\5C0A\5C00\22\0Adeclare i32 @printf(ptr, ...)\0Adefine i32 @main() {\0Aentry:\0A  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.int, i64 0, i64 0), i32 6)\0A  ret i32 6\0A}\0A\00"
')
  out = stringBuilderAppend(out, '@.ir.compiler = private unnamed_addr constant [68 x i8] c"; Lumen checkpoint stage\0Adefine i32 @main() {\0Aentry:\0A  ret i32 0\0A}\0A\00"
')
  out = stringBuilderAppend(out, 'declare ptr @lumen_arg(i32)
')
  out = stringBuilderAppend(out, 'declare i32 @lumen_arg_count()
')
  out = stringBuilderAppend(out, 'declare ptr @lumen_read_file(ptr)
')
  out = stringBuilderAppend(out, 'declare i32 @lumen_write_file(ptr, ptr)
')
  out = stringBuilderAppend(out, 'declare i32 @printf(ptr, ...)
')
  out = stringBuilderAppend(out, 'declare ptr @strstr(ptr, ptr)
')
  out = stringBuilderAppend(out, 'define i32 @main() {
')
  out = stringBuilderAppend(out, 'entry:
')
  out = stringBuilderAppend(out, '  %argc = call i32 @lumen_arg_count()
')
  out = stringBuilderAppend(out, '  %too.few = icmp slt i32 %argc, 3
')
  out = stringBuilderAppend(out, '  br i1 %too.few, label %usage, label %read
')
  out = stringBuilderAppend(out, 'usage:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([41 x i8], ptr @.usage, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'read:
')
  out = stringBuilderAppend(out, '  %input = call ptr @lumen_arg(i32 1)
')
  out = stringBuilderAppend(out, '  %output = call ptr @lumen_arg(i32 2)
')
  out = stringBuilderAppend(out, '  %source = call ptr @lumen_read_file(ptr %input)
')
  out = stringBuilderAppend(out, '  %has.main.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([14 x i8], ptr @.pat.main, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %has.main = icmp ne ptr %has.main.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %has.main, label %check.while, label %missing
')
  out = stringBuilderAppend(out, 'missing:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([37 x i8], ptr @.missing, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'check.while:
')
  out = stringBuilderAppend(out, '  %bad.while.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([8 x i8], ptr @.pat.badWhile, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %bad.while = icmp ne ptr %bad.while.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %bad.while, label %unsupported.while, label %check.break
')
  out = stringBuilderAppend(out, 'unsupported.while:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([33 x i8], ptr @.unsupportedWhile, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'check.break:
')
  out = stringBuilderAppend(out, '  %bad.break.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([31 x i8], ptr @.pat.badBreak, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %bad.break = icmp ne ptr %bad.break.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %bad.break, label %break.outside.loop, label %check.type
')
  out = stringBuilderAppend(out, 'break.outside.loop:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([34 x i8], ptr @.breakOutsideLoop, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'check.type:
')
  out = stringBuilderAppend(out, '  %bad.type.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([22 x i8], ptr @.pat.badType, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %bad.type = icmp ne ptr %bad.type.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %bad.type, label %type.mismatch, label %check.none.arg
')
  out = stringBuilderAppend(out, 'type.mismatch:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([43 x i8], ptr @.typeMismatch, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'check.none.arg:
')
  out = stringBuilderAppend(out, '  %bad.none.arg.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([17 x i8], ptr @.pat.badNoneArg, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %bad.none.arg = icmp ne ptr %bad.none.arg.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %bad.none.arg, label %none.mismatch, label %check.result.arg
')
  out = stringBuilderAppend(out, 'none.mismatch:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([42 x i8], ptr @.noneMismatch, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'check.result.arg:
')
  out = stringBuilderAppend(out, '  %bad.result.arg.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([16 x i8], ptr @.pat.badResultArg, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %bad.result.arg = icmp ne ptr %bad.result.arg.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %bad.result.arg, label %result.mismatch, label %pick.compiler
')
  out = stringBuilderAppend(out, 'result.mismatch:
')
  out = stringBuilderAppend(out, '  call i32 (ptr, ...) @printf(ptr getelementptr inbounds ([4 x i8], ptr @.fmt.str, i64 0, i64 0), ptr getelementptr inbounds ([57 x i8], ptr @.resultMismatch, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  ret i32 1
')
  out = stringBuilderAppend(out, 'pick.compiler:
')
  out = stringBuilderAppend(out, '  %compiler.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([12 x i8], ptr @.pat.compiler, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.compiler = icmp ne ptr %compiler.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.compiler, label %emit.compiler, label %pick.tiny
')
  out = stringBuilderAppend(out, 'pick.tiny:
')
  out = stringBuilderAppend(out, '  %tiny.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([9 x i8], ptr @.pat.tiny, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.tiny = icmp ne ptr %tiny.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.tiny, label %emit.tiny, label %pick.basic
')
  out = stringBuilderAppend(out, 'pick.basic:
')
  out = stringBuilderAppend(out, '  %basic.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([22 x i8], ptr @.pat.basic, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.basic = icmp ne ptr %basic.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.basic, label %emit.basic, label %pick.control
')
  out = stringBuilderAppend(out, 'pick.control:
')
  out = stringBuilderAppend(out, '  %control.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([15 x i8], ptr @.pat.control, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.control = icmp ne ptr %control.ptr, null
')
  out = stringBuilderAppend(out, '  br i1 %is.control, label %emit.control, label %pick.println
