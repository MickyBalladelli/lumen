import { IrModule, IrStatement, IrFunction, TypedIrModule, irStatementFromProgram, irFunctionFromProgram, typedIrValid } from "./ir.lm"
import { CompilerIrBlock, irBlockArenaGet, irFunctionArenaGet, irValueArenaGet } from "./containers.lm"

function emitIr(ir: IrModule): string {
  if !typedIrValid(ir.typed) {
    return "; invalid typed IR
"
  }

  if typedIrCanEmit(ir.typed) {
    return emitTypedIr(ir.typed)
  }

  return "; typed fallback: " + typedIrUnsupportedKind(ir.typed) + "
" + emitStatementMainIr(ir, ir.program)
}

function typedIrValueText(module: TypedIrModule, valueId: i32): string {
  if valueId < 0 || valueId >= module.values.count {
    return "0"
  }

  let value = irValueArenaGet(module.values, valueId)
  if stringEquals(value.kind, "literal") {
    if value.typeId == 1 {
      let size = stringLen(value.text) + 1
      return "getelementptr inbounds ([" + intToString(size) +
        " x i8], ptr @.typed.str." + intToString(valueId) + ", i64 0, i64 0)"
    }
    if stringEquals(value.text, "true") {
      return "1"
    }
    if stringEquals(value.text, "false") {
      return "0"
    }
    return llvmI32Atom(value.text)
  }
  if stringEquals(value.kind, "load") {
    return "%v." + intToString(valueId)
  }
  if includes(value.kind, "binary.") || includes(value.kind, "unary.") ||
    includes(value.kind, "call.") ||
    stringEquals(value.kind, "struct") || stringEquals(value.kind, "member") ||
    stringEquals(value.kind, "slice") {
    return "%v." + intToString(valueId)
  }
  if stringEquals(value.kind, "local") {
    return typedIrValueText(module, value.operand0)
  }

  return "0"
}

function typedIrLLVMType(typeId: i32): string {
  if typeId == 4 {
    return "void"
  }
  if typeId > 0 {
    return "ptr"
  }
  return "i32"
}

function typedIrEscapeString(value: string): string {
  let out = stringBuilder()
  let index: i32 = 0
  while index < stringLen(value) do {
    let ch = value[index..index + 1]
    if stringEquals(ch, '"') {
      out = stringBuilderAppend(out, '\22')
    } else if stringEquals(ch, '\') {
      out = stringBuilderAppend(out, '\5C')
    } else if stringEquals(ch, "
") {
      out = stringBuilderAppend(out, '\0A')
    } else {
      out = stringBuilderAppend(out, ch)
    }
    index = index + 1
  }
  return out
}

function typedIrStorageType(module: TypedIrModule, block: CompilerIrBlock, name: string): string {
  let index = block.firstValue
  while index < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, index)
    if (stringEquals(value.kind, "param") || stringEquals(value.kind, "local")) &&
      stringEquals(value.text, name) {
      return typedIrLLVMType(value.typeId)
    }
    index = index + 1
  }
  return "i32"
}

function typedIrStorageId(module: TypedIrModule, block: CompilerIrBlock, valueId: i32, name: string): i32 {
  let index = valueId - 1
  while index >= block.firstValue do {
    let value = irValueArenaGet(module.values, index)
    if stringEquals(value.kind, "local") && stringEquals(value.text, name) {
      return index
    }
    index = index - 1
  }
  return -1
}

function typedIrFunctionReturnType(module: TypedIrModule, name: string): string {
  let index: i32 = 0
  while index < module.functions.count do {
    let fn = irFunctionArenaGet(module.functions, index)
    if stringEquals(fn.name, name) {
      return typedIrLLVMType(fn.returnTypeId)
    }
    index = index + 1
  }
  return "i32"
}

function typedIrValueType(module: TypedIrModule, block: CompilerIrBlock, valueId: i32): string {
  if valueId < 0 || valueId >= module.values.count {
    return "i32"
  }
  let value = irValueArenaGet(module.values, valueId)
  if stringEquals(value.kind, "load") {
    return typedIrStorageType(module, block, value.text)
  }
  if includes(value.kind, "call.") {
    if typedIrBuiltinExists(value.text) {
      return typedIrLLVMType(value.typeId)
    }
    return typedIrFunctionReturnType(module, value.text)
  }
  if stringEquals(value.kind, "argument") {
    return typedIrValueType(module, block, value.operand0)
  }
  if stringEquals(value.kind, "struct") {
    return "ptr"
  }
  if stringEquals(value.kind, "slice") {
    return "ptr"
  }
  if stringEquals(value.kind, "member") {
    return typedIrLLVMType(value.typeId)
  }
  return typedIrLLVMType(value.typeId)
}

function typedIrFieldCount(module: TypedIrModule): i32 {
  return module.fieldCount
}

function typedIrFunctionExists(module: TypedIrModule, name: string): bool {
  let functionIndex: i32 = 0
  while functionIndex < module.functions.count do {
    let fn = irFunctionArenaGet(module.functions, functionIndex)
    if stringEquals(fn.name, name) {
      return true
    }
    functionIndex = functionIndex + 1
  }
  return false
}

function typedIrBuiltinSymbol(name: string): string {
  if stringEquals(name, "includes") { return "lumen_string_contains"
  }
  if stringEquals(name, "intToString") { return "lumen_int_to_string"
  }
  if stringEquals(name, "stringEquals") { return "lumen_string_equals"
  }
  if stringEquals(name, "stringLen") { return "lumen_string_len"
  }
  if stringEquals(name, "stringToInt") { return "lumen_string_to_int"
  }
  if stringEquals(name, "stringBuilder") { return "lumen_string_builder"
  }
  if stringEquals(name, "stringBuilderAppend") { return "lumen_string_builder_append"
  }
  if stringEquals(name, "arg") { return "lumen_arg"
  }
  if stringEquals(name, "argCount") { return "lumen_arg_count"
  }
  if stringEquals(name, "errorMessage") { return "lumen_error_message"
  }
  if stringEquals(name, "isOk") { return "lumen_is_ok"
  }
  if stringEquals(name, "resultValue") { return "lumen_result_value"
  }
  if stringEquals(name, "json") { return "lumen_json"
  }
  if stringEquals(name, "jsonGet") { return "lumen_json_get"
  }
  if stringEquals(name, "jsonGetRaw") { return "lumen_json_get_raw"
  }
  if stringEquals(name, "list") { return "lumen_list"
  }
  if stringEquals(name, "listGet") { return "lumen_list_get"
  }
  if stringEquals(name, "listLen") { return "lumen_list_len"
  }
  if stringEquals(name, "listPush") { return "lumen_list_push"
  }
  if stringEquals(name, "map") { return "lumen_map"
  }
  if stringEquals(name, "mapGet") { return "lumen_map_get"
  }
  if stringEquals(name, "mapHas") { return "lumen_map_has"
  }
  if stringEquals(name, "mapSet") { return "lumen_map_set"
  }
  if stringEquals(name, "arenaNew") { return "lumen_arena_new"
  }
  if stringEquals(name, "arenaAppend") { return "lumen_arena_append"
  }
  if stringEquals(name, "arenaLen") { return "lumen_arena_len"
  }
  if stringEquals(name, "arenaSetString") { return "lumen_arena_set_string"
  }
  if stringEquals(name, "arenaSetI32") { return "lumen_arena_set_i32"
  }
  if stringEquals(name, "arenaGetString") { return "lumen_arena_get_string"
  }
  if stringEquals(name, "arenaGetI32") { return "lumen_arena_get_i32"
  }
  if stringEquals(name, "readFile") { return "lumen_read_file"
  }
  if stringEquals(name, "writeFile") { return "lumen_write_file"
  }
  return ""
}

function typedIrBuiltinExists(name: string): bool {
  return !stringEquals(typedIrBuiltinSymbol(name), "")
}

function typedIrIsCallTarget(module: TypedIrModule, block: CompilerIrBlock, valueId: i32): bool {
  let index = valueId + 1
  while index < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, index)
    if includes(value.kind, "call.") && value.operand0 == valueId {
      return true
    }
    index = index + 1
  }
  return false
}

function typedIrHasStorage(module: TypedIrModule, block: CompilerIrBlock, name: string): bool {
  let index = block.firstValue
  while index < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, index)
    if (stringEquals(value.kind, "param") || stringEquals(value.kind, "local")) &&
      stringEquals(value.text, name) {
      return true
    }
    index = index + 1
  }
  return false
}

function typedIrValueSupported(module: TypedIrModule, block: CompilerIrBlock, valueId: i32): bool {
  let value = irValueArenaGet(module.values, valueId)
  if stringEquals(value.kind, "param") || stringEquals(value.kind, "local") ||
    stringEquals(value.kind, "return") ||
    stringEquals(value.kind, "argument") ||
    stringEquals(value.kind, "VariableDeclaration") ||
    stringEquals(value.kind, "ExpressionStatement") ||
    stringEquals(value.kind, "struct.field") || stringEquals(value.kind, "field.link") ||
    stringEquals(value.kind, "struct") || stringEquals(value.kind, "member") ||
    stringEquals(value.kind, "slice.range") || stringEquals(value.kind, "slice") ||
    stringEquals(value.kind, "BreakStatement") || stringEquals(value.kind, "ContinueStatement") {
    return true
  }
  if stringEquals(value.kind, "literal") {
    return true
  }
  if stringEquals(value.kind, "load") {
    return typedIrIsCallTarget(module, block, valueId) ||
      typedIrHasStorage(module, block, value.text)
  }
  if stringEquals(value.kind, "binary.+") || stringEquals(value.kind, "binary.-") ||
    stringEquals(value.kind, "binary.*") || stringEquals(value.kind, "binary./") ||
    stringEquals(value.kind, "binary.==") || stringEquals(value.kind, "binary.!=") ||
    stringEquals(value.kind, "binary.<") || stringEquals(value.kind, "binary.<=") ||
    stringEquals(value.kind, "binary.>") || stringEquals(value.kind, "binary.>=") ||
    stringEquals(value.kind, "binary.&&") || stringEquals(value.kind, "binary.||") ||
    stringEquals(value.kind, "assign.=") || stringEquals(value.kind, "assign.++") ||
    stringEquals(value.kind, "assign.--") {
    return true
  }
  if stringEquals(value.kind, "unary.-") || stringEquals(value.kind, "unary.+") ||
    stringEquals(value.kind, "unary.!") {
    return true
  }
  if stringEquals(value.kind, "if.begin") || stringEquals(value.kind, "if.else") ||
    stringEquals(value.kind, "if.end") || stringEquals(value.kind, "while.begin") ||
    stringEquals(value.kind, "while.condition") || stringEquals(value.kind, "while.end") {
    return true
  }
  if includes(value.kind, "call.") {
    return stringEquals(value.text, "println") || typedIrBuiltinExists(value.text) ||
      typedIrFunctionExists(module, value.text)
  }
  return false
}

function typedIrCanEmit(module: TypedIrModule): bool {
  if module.functions.count < 1 {
    return false
  }
  let blockIndex: i32 = 0
  while blockIndex < module.blocks.count do {
    let block = irBlockArenaGet(module.blocks, blockIndex)
    let valueIndex = block.firstValue
    while valueIndex < block.firstValue + block.valueCount do {
      if !typedIrValueSupported(module, block, valueIndex) {
        return false
      }
      valueIndex = valueIndex + 1
    }
    blockIndex = blockIndex + 1
  }
  return true
}

function typedIrUnsupportedKind(module: TypedIrModule): string {
  let blockIndex: i32 = 0
  while blockIndex < module.blocks.count do {
    let block = irBlockArenaGet(module.blocks, blockIndex)
    let valueIndex = block.firstValue
    while valueIndex < block.firstValue + block.valueCount do {
      if !typedIrValueSupported(module, block, valueIndex) {
        let value = irValueArenaGet(module.values, valueIndex)
        if includes(value.kind, "call.") {
          return value.kind + ":" + value.text
        }
        return value.kind
      }
      valueIndex = valueIndex + 1
    }
    blockIndex = blockIndex + 1
  }
  return "empty module"
}

function typedIrIsParameter(module: TypedIrModule, block: CompilerIrBlock, name: string): bool {
  let valueIndex = block.firstValue
  while valueIndex < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, valueIndex)
    if stringEquals(value.kind, "param") && stringEquals(value.text, name) {
      return true
    }
    valueIndex = valueIndex + 1
  }
  return false
}

function emitTypedIrArguments(out: string, module: TypedIrModule, block: CompilerIrBlock, argumentId: i32): string {
  if argumentId < 0 {
    return out
  }
  let argument = irValueArenaGet(module.values, argumentId)
  if argument.operand1 >= 0 {
    out = emitTypedIrArguments(out, module, block, argument.operand1)
    out = stringBuilderAppend(out, ", ")
  }
  out = stringBuilderAppend(out, typedIrValueType(module, block, argument.operand0))
  out = stringBuilderAppend(out, " ")
  out = stringBuilderAppend(out, typedIrValueText(module, argument.operand0))
  return out
}

function typedIrArgumentCount(module: TypedIrModule, argumentId: i32): i32 {
  let count: i32 = 0
  while argumentId >= 0 do {
    let argument = irValueArenaGet(module.values, argumentId)
    count = count + 1
    argumentId = argument.operand1
  }
  return count
}

function emitTypedStructFields(out: string, module: TypedIrModule, block: CompilerIrBlock, linkId: i32, structId: i32): string {
  if linkId < 0 {
    return out
  }
  let link = irValueArenaGet(module.values, linkId)
  if link.operand1 >= 0 {
    out = emitTypedStructFields(out, module, block, link.operand1, structId)
  }
  let field = irValueArenaGet(module.values, link.operand0)
  let fieldType = typedIrValueType(module, block, field.operand0)
  let fieldValue = typedIrValueText(module, field.operand0)
  out = stringBuilderAppend(out, "  %field.")
  out = stringBuilderAppend(out, intToString(link.operand0))
  out = stringBuilderAppend(out, " = getelementptr ptr, ptr %v.")
  out = stringBuilderAppend(out, intToString(structId))
  out = stringBuilderAppend(out, ", i64 ")
  out = stringBuilderAppend(out, intToString(field.operand1))
  out = stringBuilderAppend(out, "
")
  if stringEquals(fieldType, "i32") {
    out = stringBuilderAppend(out, "  %boxed.")
    out = stringBuilderAppend(out, intToString(link.operand0))
    out = stringBuilderAppend(out, " = inttoptr i32 ")
    out = stringBuilderAppend(out, fieldValue)
    out = stringBuilderAppend(out, " to ptr
  store ptr %boxed.")
    out = stringBuilderAppend(out, intToString(link.operand0))
  } else {
    out = stringBuilderAppend(out, "  store ptr ")
    out = stringBuilderAppend(out, fieldValue)
  }
  out = stringBuilderAppend(out, ", ptr %field.")
  out = stringBuilderAppend(out, intToString(link.operand0))
  out = stringBuilderAppend(out, "
")
  return out
}

function typedIrHasElse(module: TypedIrModule, block: CompilerIrBlock, branchId: i32): bool {
  let index = branchId + 1
  while index < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, index)
    if stringEquals(value.kind, "if.else") && value.operand0 == branchId {
      return true
    }
    if stringEquals(value.kind, "if.end") && value.operand0 == branchId {
      return false
    }
    index = index + 1
  }
  return false
}

function typedIrLoopEnd(module: TypedIrModule, block: CompilerIrBlock, valueId: i32): i32 {
  let begin = valueId - 1
  while begin >= block.firstValue do {
    let candidate = irValueArenaGet(module.values, begin)
    if stringEquals(candidate.kind, "while.begin") {
      let end = valueId + 1
      while end < block.firstValue + block.valueCount do {
        let marker = irValueArenaGet(module.values, end)
        if stringEquals(marker.kind, "while.end") && marker.operand0 == begin {
          return begin
        }
        end = end + 1
      }
    }
    begin = begin - 1
  }
  return -1
}

function emitTypedIrInstruction(out: string, module: TypedIrModule, block: CompilerIrBlock, valueId: i32): string {
  let value = irValueArenaGet(module.values, valueId)

  if stringEquals(value.kind, "BreakStatement") || stringEquals(value.kind, "ContinueStatement") {
    let loop = typedIrLoopEnd(module, block, valueId)
    if loop >= 0 {
      if stringEquals(value.kind, "BreakStatement") {
        out = stringBuilderAppend(out, "  br label %while.end.")
      } else {
        out = stringBuilderAppend(out, "  br label %while.cond.")
      }
      out = stringBuilderAppend(out, intToString(loop))
      out = stringBuilderAppend(out, "
after.control.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, ":
")
    }
    return out
  }

  if stringEquals(value.kind, "struct") {
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = call ptr @calloc(i64 ")
    out = stringBuilderAppend(out, intToString(typedIrFieldCount(module)))
    out = stringBuilderAppend(out, ", i64 8)
")
    return emitTypedStructFields(out, module, block, value.operand1, valueId)
  }

  if stringEquals(value.kind, "slice") {
    let range = irValueArenaGet(module.values, value.operand1)
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = call ptr @lumen_string_slice(ptr ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, typedIrValueText(module, range.operand0))
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, typedIrValueText(module, range.operand1))
    out = stringBuilderAppend(out, ")
")
    return out
  }

  if stringEquals(value.kind, "member") {
    let memberType = typedIrLLVMType(value.typeId)
    out = stringBuilderAppend(out, "  %member.ptr.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = getelementptr ptr, ptr ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", i64 ")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, "
  %member.raw.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = load ptr, ptr %member.ptr.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, "
")
    if stringEquals(memberType, "i32") {
      out = stringBuilderAppend(out, "  %v.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = ptrtoint ptr %member.raw.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " to i32
")
    } else {
      out = stringBuilderAppend(out, "  %v.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = getelementptr i8, ptr %member.raw.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, ", i64 0
")
    }
    return out
  }

  if stringEquals(value.kind, "if.begin") {
    out = stringBuilderAppend(out, "  %if.cond.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = icmp ne i32 ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", 0
  br i1 %if.cond.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, ", label %if.then.")
    out = stringBuilderAppend(out, intToString(valueId))
    if typedIrHasElse(module, block, valueId) {
      out = stringBuilderAppend(out, ", label %if.else.")
    } else {
      out = stringBuilderAppend(out, ", label %if.end.")
    }
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, "
if.then.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "if.else") {
    out = stringBuilderAppend(out, "  br label %if.end.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, "
if.else.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "if.end") {
    out = stringBuilderAppend(out, "  br label %if.end.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, "
if.end.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "while.begin") {
    out = stringBuilderAppend(out, "  br label %while.cond.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, "
while.cond.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "while.condition") {
    out = stringBuilderAppend(out, "  %while.test.")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, " = icmp ne i32 ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", 0
  br i1 %while.test.")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, ", label %while.body.")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, ", label %while.end.")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, "
while.body.")
    out = stringBuilderAppend(out, intToString(value.operand1))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "while.end") {
    out = stringBuilderAppend(out, "  br label %while.cond.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, "
while.end.")
    out = stringBuilderAppend(out, intToString(value.operand0))
    out = stringBuilderAppend(out, ":
")
    return out
  }

  if stringEquals(value.kind, "load") {
    if typedIrIsCallTarget(module, block, valueId) {
      return out
    }
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    let valueType = typedIrStorageType(module, block, value.text)
    if typedIrIsParameter(module, block, value.text) {
      if stringEquals(valueType, "ptr") {
        out = stringBuilderAppend(out, " = getelementptr i8, ptr %")
        out = stringBuilderAppend(out, value.text)
        out = stringBuilderAppend(out, ", i64 0
")
      } else {
        out = stringBuilderAppend(out, " = add i32 %")
        out = stringBuilderAppend(out, value.text)
        out = stringBuilderAppend(out, ", 0
")
      }
      return out
    }
    out = stringBuilderAppend(out, " = load ")
    out = stringBuilderAppend(out, valueType)
    out = stringBuilderAppend(out, ", ptr %local.")
    out = stringBuilderAppend(out, intToString(typedIrStorageId(module, block, valueId, value.text)))
    out = stringBuilderAppend(out, ".addr
")
    return out
  }

  if stringEquals(value.kind, "local") {
    let valueType = typedIrValueType(module, block, value.operand0)
    out = stringBuilderAppend(out, "  %local.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, ".addr = alloca ")
    out = stringBuilderAppend(out, valueType)
    out = stringBuilderAppend(out, "
")
    out = stringBuilderAppend(out, "  store ")
    out = stringBuilderAppend(out, valueType)
    out = stringBuilderAppend(out, " ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", ptr %local.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, ".addr
")
    return out
  }

  if includes(value.kind, "binary.") {
    let leftType = typedIrValueType(module, block, value.operand0)
    let rightType = typedIrValueType(module, block, value.operand1)
    if stringEquals(value.kind, "binary.+") &&
      (stringEquals(leftType, "ptr") || stringEquals(rightType, "ptr")) {
      let leftValue = typedIrValueText(module, value.operand0)
      let rightValue = typedIrValueText(module, value.operand1)
      if !stringEquals(leftType, "ptr") {
        leftValue = "%string.left." + intToString(valueId)
        out = stringBuilderAppend(out, "  ")
        out = stringBuilderAppend(out, leftValue)
        out = stringBuilderAppend(out, " = call ptr @lumen_int_to_string(i32 ")
        out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
        out = stringBuilderAppend(out, ")
")
      }
      if !stringEquals(rightType, "ptr") {
        rightValue = "%string.right." + intToString(valueId)
        out = stringBuilderAppend(out, "  ")
        out = stringBuilderAppend(out, rightValue)
        out = stringBuilderAppend(out, " = call ptr @lumen_int_to_string(i32 ")
        out = stringBuilderAppend(out, typedIrValueText(module, value.operand1))
        out = stringBuilderAppend(out, ")
")
      }
      out = stringBuilderAppend(out, "  %v.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = call ptr @lumen_string_concat(ptr ")
      out = stringBuilderAppend(out, leftValue)
      out = stringBuilderAppend(out, ", ptr ")
      out = stringBuilderAppend(out, rightValue)
      out = stringBuilderAppend(out, ")
")
      return out
    }
    let predicate = ""
    if stringEquals(value.kind, "binary.==") {
      predicate = "eq"
    } else if stringEquals(value.kind, "binary.!=") {
      predicate = "ne"
    } else if stringEquals(value.kind, "binary.<") {
      predicate = "slt"
    } else if stringEquals(value.kind, "binary.<=") {
      predicate = "sle"
    } else if stringEquals(value.kind, "binary.>") {
      predicate = "sgt"
    } else if stringEquals(value.kind, "binary.>=") {
      predicate = "sge"
    }
    if !stringEquals(predicate, "") {
      out = stringBuilderAppend(out, "  %cmp.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = icmp ")
      out = stringBuilderAppend(out, predicate)
      out = stringBuilderAppend(out, " i32 ")
      out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
      out = stringBuilderAppend(out, ", ")
      out = stringBuilderAppend(out, typedIrValueText(module, value.operand1))
      out = stringBuilderAppend(out, "
  %v.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = zext i1 %cmp.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " to i32
")
      return out
    }
    let opcode = "add"
    if stringEquals(value.kind, "binary.-") {
      opcode = "sub"
    } else if stringEquals(value.kind, "binary.*") {
      opcode = "mul"
    } else if stringEquals(value.kind, "binary./") {
      opcode = "sdiv"
    } else if stringEquals(value.kind, "binary.&&") {
      opcode = "and"
    } else if stringEquals(value.kind, "binary.||") {
      opcode = "or"
    }
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = ")
    out = stringBuilderAppend(out, opcode)
    out = stringBuilderAppend(out, " i32 ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, ", ")
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand1))
    out = stringBuilderAppend(out, "
")
    return out
  }

  if includes(value.kind, "unary.") {
    if stringEquals(value.kind, "unary.!") {
      out = stringBuilderAppend(out, "  %unary.test.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = icmp eq i32 ")
      out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
      out = stringBuilderAppend(out, ", 0
  %v.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = zext i1 %unary.test.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " to i32
")
      return out
    }
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    if stringEquals(value.kind, "unary.-") {
      out = stringBuilderAppend(out, " = sub i32 0, ")
    } else {
      out = stringBuilderAppend(out, " = add i32 0, ")
    }
    out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
    out = stringBuilderAppend(out, "
")
    return out
  }

  if includes(value.kind, "call.") {
    if stringEquals(value.text, "println") {
      let argument = irValueArenaGet(module.values, value.operand1)
      let argumentType = typedIrValueType(module, block, argument.operand0)
      out = stringBuilderAppend(out, "  call i32 (ptr, ...) @printf(ptr ")
      if stringEquals(argumentType, "ptr") {
        out = stringBuilderAppend(out, "getelementptr inbounds ([4 x i8], ptr @.typed.fmt.str, i64 0, i64 0), ptr ")
      } else {
        out = stringBuilderAppend(out, "getelementptr inbounds ([4 x i8], ptr @.typed.fmt.int, i64 0, i64 0), i32 ")
      }
      out = stringBuilderAppend(out, typedIrValueText(module, argument.operand0))
      out = stringBuilderAppend(out, ")
")
      return out
    }
    let builtin = typedIrBuiltinSymbol(value.text)
    if !stringEquals(builtin, "") {
      let rawType = typedIrLLVMType(value.typeId)
      if stringEquals(value.text, "isOk") || stringEquals(value.text, "stringEquals") ||
        stringEquals(value.text, "includes") || stringEquals(value.text, "mapHas") {
        rawType = "i1"
      } else if stringEquals(value.text, "resultValue") {
        rawType = "ptr"
      }
      if !stringEquals(rawType, "void") {
        if stringEquals(rawType, "i1") ||
          (stringEquals(value.text, "resultValue") && value.typeId == 0) {
          out = stringBuilderAppend(out, "  %raw.")
        } else {
          out = stringBuilderAppend(out, "  %v.")
        }
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " = ")
      } else {
        out = stringBuilderAppend(out, "  ")
      }
      out = stringBuilderAppend(out, "call ")
      out = stringBuilderAppend(out, rawType)
      out = stringBuilderAppend(out, " @")
      out = stringBuilderAppend(out, builtin)
      out = stringBuilderAppend(out, "(")
      if stringEquals(value.text, "map") {
        out = stringBuilderAppend(out, "i32 ")
        out = stringBuilderAppend(out, intToString(typedIrArgumentCount(module, value.operand1)))
        if value.operand1 >= 0 {
          out = stringBuilderAppend(out, ", ")
        }
      }
      out = emitTypedIrArguments(out, module, block, value.operand1)
      out = stringBuilderAppend(out, ")
")
      if stringEquals(rawType, "i1") {
        out = stringBuilderAppend(out, "  %v.")
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " = zext i1 %raw.")
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " to i32
")
      } else if stringEquals(value.text, "resultValue") && value.typeId == 0 {
        out = stringBuilderAppend(out, "  %v.")
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " = ptrtoint ptr %raw.")
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " to i32
")
      }
      return out
    }
    out = stringBuilderAppend(out, "  %v.")
    out = stringBuilderAppend(out, intToString(valueId))
    out = stringBuilderAppend(out, " = call ")
    out = stringBuilderAppend(out, typedIrFunctionReturnType(module, value.text))
    out = stringBuilderAppend(out, " @")
    out = stringBuilderAppend(out, value.text)
    out = stringBuilderAppend(out, "(")
    out = emitTypedIrArguments(out, module, block, value.operand1)
    out = stringBuilderAppend(out, ")
")
    return out
  }

  if includes(value.kind, "assign.") {
    let target = irValueArenaGet(module.values, value.operand0)
    let assignedValue = typedIrValueText(module, value.operand1)
    if stringEquals(value.kind, "assign.++") || stringEquals(value.kind, "assign.--") {
      out = stringBuilderAppend(out, "  %assign.next.")
      out = stringBuilderAppend(out, intToString(valueId))
      if stringEquals(value.kind, "assign.++") {
        out = stringBuilderAppend(out, " = add i32 ")
      } else {
        out = stringBuilderAppend(out, " = sub i32 ")
      }
      out = stringBuilderAppend(out, typedIrValueText(module, value.operand0))
      out = stringBuilderAppend(out, ", 1
")
      assignedValue = "%assign.next." + intToString(valueId)
    }
    if stringEquals(target.kind, "load") && !typedIrIsParameter(module, block, target.text) {
      let valueType = typedIrStorageType(module, block, target.text)
      out = stringBuilderAppend(out, "  store ")
      out = stringBuilderAppend(out, valueType)
      out = stringBuilderAppend(out, " ")
      out = stringBuilderAppend(out, assignedValue)
      out = stringBuilderAppend(out, ", ptr %local.")
      out = stringBuilderAppend(out, intToString(typedIrStorageId(module, block, value.operand0, target.text)))
      out = stringBuilderAppend(out, ".addr
")
    } else if stringEquals(target.kind, "member") {
      let valueType = typedIrValueType(module, block, value.operand1)
      out = stringBuilderAppend(out, "  %assign.field.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, " = getelementptr ptr, ptr ")
      out = stringBuilderAppend(out, typedIrValueText(module, target.operand0))
      out = stringBuilderAppend(out, ", i64 ")
      out = stringBuilderAppend(out, intToString(target.operand1))
      out = stringBuilderAppend(out, "
")
      if stringEquals(valueType, "i32") {
        out = stringBuilderAppend(out, "  %assign.boxed.")
        out = stringBuilderAppend(out, intToString(valueId))
        out = stringBuilderAppend(out, " = inttoptr i32 ")
        out = stringBuilderAppend(out, assignedValue)
        out = stringBuilderAppend(out, " to ptr
  store ptr %assign.boxed.")
        out = stringBuilderAppend(out, intToString(valueId))
      } else {
        out = stringBuilderAppend(out, "  store ptr ")
        out = stringBuilderAppend(out, assignedValue)
      }
      out = stringBuilderAppend(out, ", ptr %assign.field.")
      out = stringBuilderAppend(out, intToString(valueId))
      out = stringBuilderAppend(out, "
")
    }
  }

  return out
}

// One typed function is emitted at a time. The first slice intentionally has
// no syntax or program-map dependency: it accepts only typed return values.
function emitTypedIrFunction(module: TypedIrModule, functionIndex: i32): string {
  let fn = irFunctionArenaGet(module.functions, functionIndex)
  let block = irBlockArenaGet(module.blocks, fn.firstBlock)
  let returnValue = "0"
  let valueIndex = block.firstValue

  while valueIndex < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, valueIndex)
    if stringEquals(value.kind, "return") {
      returnValue = typedIrValueText(module, value.operand0)
    }
    valueIndex = valueIndex + 1
  }

  let out = stringBuilder()
  out = stringBuilderAppend(out, "define ")
  out = stringBuilderAppend(out, typedIrFunctionReturnType(module, fn.name))
  out = stringBuilderAppend(out, " @")
  out = stringBuilderAppend(out, fn.name)
  out = stringBuilderAppend(out, "(")
  valueIndex = block.firstValue
  let parameterCount: i32 = 0
  while valueIndex < block.firstValue + block.valueCount do {
    let value = irValueArenaGet(module.values, valueIndex)
    if stringEquals(value.kind, "param") {
      if parameterCount > 0 {
        out = stringBuilderAppend(out, ", ")
      }
      out = stringBuilderAppend(out, typedIrLLVMType(value.typeId))
      out = stringBuilderAppend(out, " %")
      out = stringBuilderAppend(out, value.text)
      parameterCount = parameterCount + 1
    }
    valueIndex = valueIndex + 1
  }
  out = stringBuilderAppend(out, ") {
entry:
")
  valueIndex = block.firstValue
  while valueIndex < block.firstValue + block.valueCount do {
    out = emitTypedIrInstruction(out, module, block, valueIndex)
    valueIndex = valueIndex + 1
  }
  out = stringBuilderAppend(out, "  ret ")
  out = stringBuilderAppend(out, typedIrFunctionReturnType(module, fn.name))
  out = stringBuilderAppend(out, " ")
  out = stringBuilderAppend(out, returnValue)
  out = stringBuilderAppend(out, "
}
")
  return out
}

function emitTypedIr(module: TypedIrModule): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  let usesPrint: bool = false
  let valueIndex: i32 = 0
  while valueIndex < module.values.count do {
    let value = irValueArenaGet(module.values, valueIndex)
    if stringEquals(value.kind, "literal") && value.typeId == 1 {
      let size = stringLen(value.text) + 1
      out = stringBuilderAppend(out, "@.typed.str.")
      out = stringBuilderAppend(out, intToString(valueIndex))
      out = stringBuilderAppend(out, " = private unnamed_addr constant [")
      out = stringBuilderAppend(out, intToString(size))
      out = stringBuilderAppend(out, ' x i8] c"')
      out = stringBuilderAppend(out, typedIrEscapeString(value.text))
      out = stringBuilderAppend(out, '\00"
')
    }
    if includes(value.kind, "call.") && stringEquals(value.text, "println") {
      usesPrint = true
    }
    valueIndex = valueIndex + 1
  }
  if usesPrint {
    out = stringBuilderAppend(out, '@.typed.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
    out = stringBuilderAppend(out, '@.typed.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
    out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  }
  out = stringBuilderAppend(out, "declare i1 @lumen_string_contains(ptr, ptr)
declare ptr @lumen_string_concat(ptr, ptr)
declare ptr @calloc(i64, i64)
declare ptr @lumen_string_slice(ptr, i32, i32)
declare ptr @lumen_int_to_string(i32)
declare i1 @lumen_string_equals(ptr, ptr)
declare i32 @lumen_string_len(ptr)
declare i32 @lumen_string_to_int(ptr)
declare ptr @lumen_string_builder()
declare ptr @lumen_string_builder_append(ptr, ptr)
declare ptr @lumen_arg(i32)
declare ptr @lumen_arg_count()
declare ptr @lumen_error_message(ptr)
declare i1 @lumen_is_ok(ptr)
declare ptr @lumen_result_value(ptr)
declare ptr @lumen_json(ptr)
declare ptr @lumen_json_get(ptr, ptr)
declare ptr @lumen_json_get_raw(ptr, ptr)
declare ptr @lumen_list()
declare ptr @lumen_list_get(ptr, i32)
declare i32 @lumen_list_len(ptr)
declare ptr @lumen_list_push(ptr, ptr)
declare ptr @lumen_map(i32, ...)
declare ptr @lumen_map_get(ptr, ptr)
declare i1 @lumen_map_has(ptr, ptr)
declare ptr @lumen_map_set(ptr, ptr, ptr)
declare ptr @lumen_arena_new()
declare i32 @lumen_arena_append(ptr)
declare i32 @lumen_arena_len(ptr)
declare void @lumen_arena_set_string(ptr, i32, i32, ptr)
declare void @lumen_arena_set_i32(ptr, i32, i32, i32)
declare ptr @lumen_arena_get_string(ptr, i32, i32)
declare i32 @lumen_arena_get_i32(ptr, i32, i32)
declare ptr @lumen_read_file(ptr)
declare ptr @lumen_write_file(ptr, ptr)
")
  let functionIndex: i32 = 0

  while functionIndex < module.functions.count do {
    out = stringBuilderAppend(out, emitTypedIrFunction(module, functionIndex))
    functionIndex = functionIndex + 1
  }

  return out
}

function statementPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "statement")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function binaryValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%bin.")
  out = stringBuilderAppend(out, slot)
  return out
}

function callValueName(slot: string): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "%call.")
  out = stringBuilderAppend(out, slot)
  return out
}

// The compatibility emitter only knows numeric SSA values. Never put an AST
// name into LLVM where an i32 value is required while typed lowering takes
// over that expression family.
function llvmI32Atom(value: string): string {
  if includes(value, "%") {
    return value
  }
  if stringEquals(value, intToString(stringToInt(value))) {
    return value
  }
  return "0"
}

function statementAt(ir: IrModule, program: string, index: i32): IrStatement {
  return irStatementFromProgram(program, index)
}

function functionAt(ir: IrModule, program: string, index: i32): IrFunction {
  return irFunctionFromProgram(program, index)
}

function resolvedStatementExprKind(statement: IrStatement, symbols: string): string {
  let kind = statement.expressionKind
  let value = statement.expressionValue
  let resolvedKind = statement.resolvedKind

  if includes(kind, "call") {
    return "number"
  }

  if includes(kind, "binary") {
    return "number"
  }

  if includes(kind, "identifier") {
    let resolved = mapGet(symbols, value + "Kind")
    if includes(resolved, "string") {
      return resolved
    }
    if includes(resolved, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedKind
  }

  if includes(resolvedKind, "number") {
    return resolvedKind
  }

  return kind
}

function resolvedStatementExprValue(statement: IrStatement, symbols: string): string {
  let kind = statement.expressionKind
  let value = statement.expressionValue
  let resolvedKind = statement.resolvedKind
  let resolvedValue = statement.resolvedValue

  if includes(kind, "call") {
    return value
  }

  if includes(kind, "binary") {
    return value
  }

  if includes(kind, "identifier") {
    let resolvedKind = mapGet(symbols, value + "Kind")
    let resolved = mapGet(symbols, value + "Value")
    if includes(resolvedKind, "string") {
      return resolved
    }
    if includes(resolvedKind, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedValue
  }

  if includes(resolvedKind, "number") {
    return resolvedValue
  }

  return value
}

function addStructFieldSymbols(symbols: string, name: string, value: string): string {
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]

    if stringEquals(ch, ":") {
      let fieldStart = index + 1
      let cursor = fieldStart

      while cursor < length do {
        let current = value[cursor..cursor + 1]
        if stringEquals(current, "=") {
          let fieldName = value[fieldStart..cursor]
          let valueStart = cursor + 1
          let valueEnd = valueStart

          while valueEnd < length do {
            let next = value[valueEnd..valueEnd + 1]
            if stringEquals(next, ":") {
              let fieldKey = name + "." + fieldName
              symbols = mapSet(symbols, fieldKey + "Kind", "number")
              symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..valueEnd])
              index = valueEnd
              break
            }

            valueEnd = valueEnd + 1
          }

          if valueEnd >= length {
            let fieldKey = name + "." + fieldName
            symbols = mapSet(symbols, fieldKey + "Kind", "number")
            symbols = mapSet(symbols, fieldKey + "Value", value[valueStart..length])
            index = length
          }
        }

        if stringEquals(current, ":") {
          break
        }

        cursor = cursor + 1
      }
    }

    index = index + 1
  }

  return symbols
}

function buildStatementSymbols(program: string): string {
  let symbols = map("unused", "unused")
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      let name = mapGet(program, prefix + "Name")
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(mapGet(program, prefix + "ResolvedKind"), "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", mapGet(program, prefix + "ResolvedValue"))
        symbols = addStructFieldSymbols(symbols, name, mapGet(program, prefix + "ResolvedValue"))
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
        symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "assign") {
      let name = mapGet(program, prefix + "Name")
      symbols = mapSet(symbols, name + "Kind", resolvedExprKind(program, symbols, prefix))
      symbols = mapSet(symbols, name + "Value", resolvedExprValue(program, symbols, prefix))
    }

    if includes(kind, "while") {
      let name = mapGet(program, prefix + "BodyAssignName")
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
    }

    if includes(kind, "for") {
      let name = mapGet(program, prefix + "BodyAssignName")
      let loopName = mapGet(program, prefix + "LoopVariable")
      let initial = mapGet(symbols, name + "Value")
      symbols = mapSet(symbols, name + "InitialValue", initial)
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
      symbols = mapSet(symbols, loopName + "Kind", "number")
      symbols = mapSet(symbols, loopName + "Value", "%" + loopName + ".done")
    }

    index = index + 1
  }

  return symbols
}

function resolvedExprKind(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")

  if includes(kind, "call") {
    return "number"
  }

  if includes(kind, "binary") {
    return "number"
  }

  if includes(kind, "identifier") {
    let resolved = mapGet(symbols, value + "Kind")
    if includes(resolved, "string") {
      return resolved
    }
    if includes(resolved, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedKind
  }

  if includes(resolvedKind, "number") {
    return resolvedKind
  }

  return kind
}

function resolvedExprValue(program: string, symbols: string, prefix: string): string {
  let kind = mapGet(program, prefix + "ExprKind")
  let value = mapGet(program, prefix + "ExprValue")
  let resolvedKind = mapGet(program, prefix + "ResolvedKind")
  let resolvedValue = mapGet(program, prefix + "ResolvedValue")

  if includes(kind, "call") {
    return value
  }

  if includes(kind, "binary") {
    return value
  }

  if includes(kind, "identifier") {
    let resolvedKind = mapGet(symbols, value + "Kind")
    let resolved = mapGet(symbols, value + "Value")
    if includes(resolvedKind, "string") {
      return resolved
    }
    if includes(resolvedKind, "number") {
      return resolved
    }
  }

  if includes(resolvedKind, "string") {
    return resolvedValue
  }

  if includes(resolvedKind, "number") {
    return resolvedValue
  }

  return value
}

function hasForStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "for") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasWhileStatement(program: string): bool {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      return true
    }

    index = index + 1
  }

  return false
}

function resolvedNumberAtom(symbols: string, value: string): string {
  let resolved = mapGet(symbols, value + "Value")
  if includes(resolved, "%") {
    return resolved
  }

  if includes(mapGet(symbols, value + "Kind"), "number") {
    return resolved
  }

  return value
}

function hasFunction(program: string): bool {
  let count = stringToInt(mapGet(program, "functionCount"))
  return count > 0
}

function hasFunctionIr(ir: IrModule): bool {
  if ir.functionCount > 0 {
    if stringEquals(ir.function0Name, "") {
      return false
    }

    return true
  }

  return false
}

function hasForStatementIr(ir: IrModule, program: string): bool {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "for") {
      return true
    }

    index = index + 1
  }

  return false
}

function hasWhileStatementIr(ir: IrModule, program: string): bool {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "while") {
      return true
    }

    index = index + 1
  }

  return false
}

function buildStatementSymbolsIr(ir: IrModule, program: string): string {
  let symbols = map("unused", "unused")
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      let name = statement.name
      if includes(statement.expressionKind, "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(statement.expressionKind, "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(statement.resolvedKind, "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", statement.resolvedValue)
        symbols = addStructFieldSymbols(symbols, name, statement.resolvedValue)
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
        symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "const") {
      let name = statement.name
      if includes(statement.expressionKind, "binary") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", binaryValueName(intToString(index)))
      } else if includes(statement.expressionKind, "call") {
        symbols = mapSet(symbols, name + "Kind", "number")
        symbols = mapSet(symbols, name + "Value", callValueName(intToString(index)))
      } else if includes(statement.resolvedKind, "struct") {
        symbols = mapSet(symbols, name + "Kind", "struct")
        symbols = mapSet(symbols, name + "Value", statement.resolvedValue)
        symbols = addStructFieldSymbols(symbols, name, statement.resolvedValue)
      } else {
        symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
        symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "assign") {
      let name = statement.name
      symbols = mapSet(symbols, name + "Kind", resolvedStatementExprKind(statement, symbols))
      symbols = mapSet(symbols, name + "Value", resolvedStatementExprValue(statement, symbols))
    }

    if includes(statement.kind, "while") {
      let name = statement.bodyAssignName
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
    }

    if includes(statement.kind, "for") {
      let name = statement.bodyAssignName
      let initial = mapGet(symbols, name + "Value")
      symbols = mapSet(symbols, name + "InitialValue", initial)
      symbols = mapSet(symbols, name + "Kind", "number")
      symbols = mapSet(symbols, name + "Value", "%" + name + ".done")
      symbols = mapSet(symbols, statement.loopVariable + "Kind", "number")
      symbols = mapSet(symbols, statement.loopVariable + "Value", "%" + statement.loopVariable + ".done")
    }

    index = index + 1
  }

  return symbols
}

function emitStatementMainIr(ir: IrModule, program: string): string {
  let symbols = buildStatementSymbolsIr(ir, program)
  let returnValue = ir.returnValue
  let hasFor = hasForStatementIr(ir, program)
  let hasWhile = hasWhileStatementIr(ir, program)
  let out = stringBuilder()

  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
  if hasFunctionIr(ir) {
    out = emitFunctionDefinitionsIr(out, ir, program)
  }

  let globalIndex: i32 = 0
  while globalIndex < ir.statementCount do {
    let statement = statementAt(ir, program, globalIndex)

    if includes(statement.kind, "println") {
      let kind = resolvedStatementExprKind(statement, symbols)
      let value = resolvedStatementExprValue(statement, symbols)
      if includes(kind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), value)
      }
    }

    if includes(statement.kind, "if") {
      if includes(statement.bodyExpressionKind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), statement.bodyExpressionValue)
      }
    }

    if includes(statement.kind, "return") {
      returnValue = resolvedStatementExprValue(statement, symbols)
    }

    globalIndex = globalIndex + 1
  }

  out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  out = stringBuilderAppend(out, "declare ptr @lumen_arg_count()
")
  out = stringBuilderAppend(out, "declare ptr @lumen_arg(i32)
")
  out = stringBuilderAppend(out, "declare ptr @lumen_result_value(ptr)
")
  out = stringBuilderAppend(out, "define i32 @argCount() {
entry:
  %raw = call ptr @lumen_arg_count()
  %value = ptrtoint ptr %raw to i32
  ret i32 %value
}
")
  out = stringBuilderAppend(out, "define i32 @arg(i32 %index) {
entry:
  %raw = call ptr @lumen_arg(i32 %index)
  %value = ptrtoint ptr %raw to i32
  ret i32 %value
}
")
  out = stringBuilderAppend(out, "define i32 @resultValue(i32 %result) {
entry:
  %raw = inttoptr i32 %result to ptr
  %value = call ptr @lumen_result_value(ptr %raw)
  %number = ptrtoint ptr %value to i32
  ret i32 %number
}
")
  out = stringBuilderAppend(out, "define i32 @main() {
")
  out = stringBuilderAppend(out, "entry:
")
  out = emitLocalStorageIr(out, ir, program, symbols)
  if hasFor {
    out = emitForStatementsIr(out, ir, program, symbols)
  }
  out = emitBinaryStatementsIr(out, ir, program, symbols)
  out = emitCallStatementsIr(out, ir, program, symbols)
  if hasWhile {
    out = emitWhileStatementsIr(out, ir, program, symbols)
  }

  let emitIndex: i32 = 0
  while emitIndex < ir.statementCount do {
    let statement = statementAt(ir, program, emitIndex)

    if includes(statement.kind, "println") {
      out = emitPrint(out, intToString(emitIndex), resolvedStatementExprKind(statement, symbols), resolvedStatementExprValue(statement, symbols))
    }

    if includes(statement.kind, "if") {
      out = emitIfStatementIr(out, intToString(emitIndex), symbols, statement)
    }

    emitIndex = emitIndex + 1
  }

  out = stringBuilderAppend(out, "  ret i32 ")
  out = stringBuilderAppend(out, llvmI32Atom(returnValue))
  out = stringBuilderAppend(out, "
}
")

  return out
}

function emitStatementMain(program: string): string {
  let symbols = buildStatementSymbols(program)
  let returnValue = mapGet(program, "mainReturnValue")
  let statementCount = stringToInt(mapGet(program, "statementCount"))
  let hasFor = hasForStatement(program)
  let hasWhile = hasWhileStatement(program)
  let out = stringBuilder()

  out = stringBuilderAppend(out, "; Lumen self-host LLVM IR
")
  out = stringBuilderAppend(out, '@.fmt.str = private unnamed_addr constant [4 x i8] c"%s\0A\00"
')
  out = stringBuilderAppend(out, '@.fmt.int = private unnamed_addr constant [4 x i8] c"%d\0A\00"
')
  if hasFunction(program) {
    out = emitFunctionDefinitions(out, program)
  }

  let globalIndex: i32 = 0
  while globalIndex < statementCount do {
    let prefix = statementPrefix(globalIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      let kind = resolvedExprKind(program, symbols, prefix)
      let value = resolvedExprValue(program, symbols, prefix)
      if includes(kind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), value)
      }
    }

    if includes(statementKind, "if") {
      let bodyKind = mapGet(program, prefix + "BodyExprKind")
      let bodyValue = mapGet(program, prefix + "BodyExprValue")
      if includes(bodyKind, "string") {
        out = emitStringGlobal(out, intToString(globalIndex), bodyValue)
      }
    }

    if includes(statementKind, "return") {
      returnValue = resolvedExprValue(program, symbols, prefix)
    }

    globalIndex = globalIndex + 1
  }

  out = stringBuilderAppend(out, "declare i32 @printf(ptr, ...)
")
  out = stringBuilderAppend(out, "define i32 @main() {
")
  out = stringBuilderAppend(out, "entry:
")
  out = emitLocalStorage(out, program, symbols)
  if hasFor {
    out = emitForStatements(out, program, symbols)
  }
  out = emitBinaryStatements(out, program, symbols)
  out = emitCallStatements(out, program, symbols)
  if hasWhile {
    out = emitWhileStatements(out, program, symbols)
  }

  let emitIndex: i32 = 0
  while emitIndex < statementCount do {
    let prefix = statementPrefix(emitIndex)
    let statementKind = mapGet(program, prefix + "Kind")

    if includes(statementKind, "println") {
      out = emitPrint(out, intToString(emitIndex), resolvedExprKind(program, symbols, prefix), resolvedExprValue(program, symbols, prefix))
    }

    if includes(statementKind, "if") {
      out = emitIfStatement(out, intToString(emitIndex), program, symbols, prefix)
    }

    emitIndex = emitIndex + 1
  }

  out = stringBuilderAppend(out, "  ret i32 ")
  out = stringBuilderAppend(out, llvmI32Atom(returnValue))
  out = stringBuilderAppend(out, "
}
")

  return out
}

function emitLocalStorage(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")
    let name = mapGet(program, prefix + "Name")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        let skippedBinary = 1
      } else if includes(mapGet(program, prefix + "ExprKind"), "call") {
        let skippedCall = 1
      } else if includes(resolvedExprKind(program, symbols, prefix), "number") {
        out = emitLocalStore(out, name, resolvedExprValue(program, symbols, prefix))
      }
    }

    index = index + 1
  }

  return out
}

function emitLocalStorageIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "binary") {
        let skippedBinary = 1
      } else if includes(statement.expressionKind, "call") {
        let skippedCall = 1
      } else if includes(resolvedStatementExprKind(statement, symbols), "number") {
        out = emitLocalStore(out, statement.name, resolvedStatementExprValue(statement, symbols))
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "binary") {
        let skippedBinary = 1
      } else if includes(statement.expressionKind, "call") {
        let skippedCall = 1
      } else if includes(resolvedStatementExprKind(statement, symbols), "number") {
        out = emitLocalStore(out, statement.name, resolvedStatementExprValue(statement, symbols))
      }
    }

    index = index + 1
  }

  return out
}

function emitLocalStore(out: string, name: string, value: string): string {
  if includes(value, "%") {
    return out
  }

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 ")
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, ".addr
")

  return out
}

function functionPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "function")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function emitFunctionDefinitions(out: string, program: string): string {
  let count = stringToInt(mapGet(program, "functionCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = functionPrefix(index)
    let name = mapGet(program, prefix + "Name")
    let param0 = mapGet(program, prefix + "Param0")
    let param1 = mapGet(program, prefix + "Param1")
    let paramCount = mapGet(program, prefix + "ParamCount")
    let returnKind = mapGet(program, prefix + "ReturnKind")
    let operator = mapGet(program, prefix + "ReturnValue")
    let left = mapGet(program, prefix + "ReturnLeftValue")
    let right = mapGet(program, prefix + "ReturnRightValue")

    out = stringBuilderAppend(out, "define i32 @")
    out = stringBuilderAppend(out, name)
    out = stringBuilderAppend(out, "(")
    if !stringEquals(paramCount, "0") {
      out = stringBuilderAppend(out, "i32 %")
      out = stringBuilderAppend(out, param0)
    }
    if stringEquals(paramCount, "2") {
      out = stringBuilderAppend(out, ", i32 %")
      out = stringBuilderAppend(out, param1)
    }
    out = stringBuilderAppend(out, ") {
entry:
")
    if emitFunctionNumberAtom(left, param0, param1) && emitFunctionNumberAtom(right, param0, param1) {
      if stringEquals(operator, "*") {
        out = stringBuilderAppend(out, "  %fn.ret = mul i32 ")
      } else {
        out = stringBuilderAppend(out, "  %fn.ret = add i32 ")
      }
      out = emitFunctionAtom(out, left, param0, param1)
      out = stringBuilderAppend(out, ", ")
      out = emitFunctionAtom(out, right, param0, param1)
      out = stringBuilderAppend(out, "
")
      out = stringBuilderAppend(out, "  ret i32 %fn.ret
")
    } else {
      out = stringBuilderAppend(out, "  ret i32 0
")
    }
    out = stringBuilderAppend(out, "}
")

    index = index + 1
  }

  return out
}

function emitFunctionDefinitionsIr(out: string, ir: IrModule, program: string): string {
  let index: i32 = 0

  while index < ir.functionCount do {
    let fn = functionAt(ir, program, index)
    let name = fn.name
    let param0 = fn.param0
    let param1 = fn.param1
    let paramCount = fn.paramCount
    let returnKind = fn.returnKind
    let operator = fn.returnValue
    let left = fn.returnLeftValue
    let right = fn.returnRightValue

    out = stringBuilderAppend(out, "define i32 @")
    out = stringBuilderAppend(out, name)
    out = stringBuilderAppend(out, "(")
    if !stringEquals(paramCount, "0") {
      out = stringBuilderAppend(out, "i32 %")
      out = stringBuilderAppend(out, param0)
    }
    if stringEquals(paramCount, "2") {
      out = stringBuilderAppend(out, ", i32 %")
      out = stringBuilderAppend(out, param1)
    }
    out = stringBuilderAppend(out, ") {
entry:
")
    if emitFunctionNumberAtom(left, param0, param1) && emitFunctionNumberAtom(right, param0, param1) {
      if stringEquals(operator, "*") {
        out = stringBuilderAppend(out, "  %fn.ret = mul i32 ")
      } else {
        out = stringBuilderAppend(out, "  %fn.ret = add i32 ")
      }
      out = emitFunctionAtom(out, left, param0, param1)
      out = stringBuilderAppend(out, ", ")
      out = emitFunctionAtom(out, right, param0, param1)
      out = stringBuilderAppend(out, "
")
      out = stringBuilderAppend(out, "  ret i32 %fn.ret
")
    } else {
      out = stringBuilderAppend(out, "  ret i32 0
")
    }
    out = stringBuilderAppend(out, "}
")

    index = index + 1
  }

  return out
}

function emitFunctionAtom(out: string, value: string, param0: string, param1: string): string {
  if stringEquals(value, param0) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  if stringEquals(value, param1) {
    out = stringBuilderAppend(out, "%")
    out = stringBuilderAppend(out, value)
    return out
  }

  out = stringBuilderAppend(out, value)
  return out
}

function emitFunctionNumberAtom(value: string, param0: string, param1: string): bool {
  if !stringEquals(param0, "") && stringEquals(value, param0) {
    return true
  }

  if !stringEquals(param1, "") && stringEquals(value, param1) {
    return true
  }

  return stringEquals(value, intToString(stringToInt(value)))
}

function emitCallStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "call") {
        out = emitCall(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitCallStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "call") {
        out = emitCallIr(out, intToString(index), symbols, statement)
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "call") {
        out = emitCallIr(out, intToString(index), symbols, statement)
      }
    }

    index = index + 1
  }

  return out
}

function emitCallIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let name = statement.expressionValue
  let arg0 = resolvedNumberAtom(symbols, statement.expressionCallArg0)
  let arg1 = resolvedNumberAtom(symbols, statement.expressionCallArg1)
  let argCount = statement.expressionCallArgCount

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, callValueName(slot))
  out = stringBuilderAppend(out, " = call i32 @")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, "(")
  if !stringEquals(argCount, "0") {
    out = stringBuilderAppend(out, "i32 ")
    out = stringBuilderAppend(out, arg0)
  }
  if stringEquals(argCount, "2") {
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, arg1)
  }
  out = stringBuilderAppend(out, ")
")

  return out
}

function emitCall(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let name = mapGet(program, prefix + "ExprValue")
  let arg0 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg0"))
  let arg1 = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprCallArg1"))
  let argCount = mapGet(program, prefix + "ExprCallArgCount")

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, callValueName(slot))
  out = stringBuilderAppend(out, " = call i32 @")
  out = stringBuilderAppend(out, name)
  out = stringBuilderAppend(out, "(")
  if !stringEquals(argCount, "0") {
    out = stringBuilderAppend(out, "i32 ")
    out = stringBuilderAppend(out, arg0)
  }
  if stringEquals(argCount, "2") {
    out = stringBuilderAppend(out, ", i32 ")
    out = stringBuilderAppend(out, arg1)
  }
  out = stringBuilderAppend(out, ")
")

  return out
}

function emitBinaryStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    let kind = mapGet(program, prefix + "Kind")

    if includes(kind, "let") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    if includes(kind, "const") {
      if includes(mapGet(program, prefix + "ExprKind"), "binary") {
        out = emitBinaryAdd(out, intToString(index), program, symbols, prefix)
      }
    }

    index = index + 1
  }

  return out
}

function emitBinaryStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)

    if includes(statement.kind, "let") {
      if includes(statement.expressionKind, "binary") {
        out = emitBinaryAddIr(out, intToString(index), symbols, statement)
      }
    }

    if includes(statement.kind, "const") {
      if includes(statement.expressionKind, "binary") {
        out = emitBinaryAddIr(out, intToString(index), symbols, statement)
      }
    }

    index = index + 1
  }

  return out
}

function emitBinaryAddIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let left = resolvedNumberAtom(symbols, statement.expressionLeftValue)
  let right = resolvedNumberAtom(symbols, statement.expressionRightValue)

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, binaryValueName(slot))
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, left)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, right)
  out = stringBuilderAppend(out, "
")

  return out
}

function emitBinaryAdd(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let left = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprLeftValue"))
  let right = resolvedNumberAtom(symbols, mapGet(program, prefix + "ExprRightValue"))

  out = stringBuilderAppend(out, "  ")
  out = stringBuilderAppend(out, binaryValueName(slot))
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, left)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, right)
  out = stringBuilderAppend(out, "
")

  return out
}

function llvmIntegerPredicate(operator: string): string {
  if stringEquals(operator, "==") {
    return "eq"
  }
  if stringEquals(operator, "!=") {
    return "ne"
  }
  if stringEquals(operator, "<=") {
    return "sle"
  }
  if stringEquals(operator, ">") {
    return "sgt"
  }
  if stringEquals(operator, ">=") {
    return "sge"
  }
  return "slt"
}

function emitForStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let statement = irStatementFromProgram(program, index)
    if includes(statement.kind, "for") {
      out = emitForStatement(out, intToString(index), symbols, statement)
    }
    index = index + 1
  }

  return out
}

function emitForStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "for") {
      out = emitForStatement(out, intToString(index), symbols, statement)
    }
    index = index + 1
  }

  return out
}

function emitLoopControl(out: string, slot: string, label: string, operator: string, value: string, loopName: string, destination: string, next: string): string {
  if stringEquals(operator, "") {
    return out
  }

  out = stringBuilderAppend(out, "  %for.")
  out = stringBuilderAppend(out, label)
  out = stringBuilderAppend(out, ".")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp ")
  out = stringBuilderAppend(out, llvmIntegerPredicate(operator))
  out = stringBuilderAppend(out, " i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, value)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %for.")
  out = stringBuilderAppend(out, label)
  out = stringBuilderAppend(out, ".")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, destination)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, next)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, next)
  out = stringBuilderAppend(out, ":
")
  return out
}

function forOperand(statement: IrStatement, symbols: string, value: string, slot: string): string {
  if stringEquals(value, statement.bodyAssignName) {
    return "%" + value + ".body." + slot
  }
  if stringEquals(value, statement.loopVariable) {
    return "%" + value + ".body." + slot
  }
  return resolvedNumberAtom(symbols, value)
}

function emitForStatement(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let loopName = statement.loopVariable
  let assignName = statement.bodyAssignName
  let condition = llvmIntegerPredicate(statement.loopCompareOperator)
  let bodyLabel = "for.body." + slot
  let operationLabel = "for.operation." + slot
  let updateLabel = "for.update." + slot
  let endLabel = "for.end." + slot

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr = alloca i32
")
  out = stringBuilderAppend(out, "  store i32 ")
  out = stringBuilderAppend(out, statement.loopInitialValue)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  br label %for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  %for.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp ")
  out = stringBuilderAppend(out, condition)
  out = stringBuilderAppend(out, " i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, statement.loopBoundValue)
  out = stringBuilderAppend(out, "
  br i1 %for.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, bodyLabel)
  out = stringBuilderAppend(out, ", label %")
  out = stringBuilderAppend(out, endLabel)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, bodyLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")

  out = emitLoopControl(out, slot, "continue", statement.continueOperator, statement.continueValue, loopName, updateLabel, "for.after.continue." + slot)
  out = emitLoopControl(out, slot, "break", statement.breakOperator, statement.breakValue, loopName, endLabel, operationLabel)
  if stringEquals(statement.breakOperator, "") {
    if stringEquals(statement.continueOperator, "") {
      out = stringBuilderAppend(out, "  br label %")
      out = stringBuilderAppend(out, operationLabel)
      out = stringBuilderAppend(out, "
")
    } else {
      out = stringBuilderAppend(out, "  br label %")
      out = stringBuilderAppend(out, operationLabel)
      out = stringBuilderAppend(out, "
")
    }
    out = stringBuilderAppend(out, operationLabel)
    out = stringBuilderAppend(out, ":
")
  }

  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 ")
  out = stringBuilderAppend(out, forOperand(statement, symbols, statement.bodyAddLeft, slot))
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, forOperand(statement, symbols, statement.bodyAddRight, slot))
  out = stringBuilderAppend(out, "
  store i32 %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  br label %")
  out = stringBuilderAppend(out, updateLabel)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, updateLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, statement.loopUpdateValue)
  out = stringBuilderAppend(out, "
  store i32 %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
  br label %for.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, endLabel)
  out = stringBuilderAppend(out, ":
  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
  %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, loopName)
  out = stringBuilderAppend(out, ".addr
")
  return out
}

function emitWhileStatements(out: string, program: string, symbols: string): string {
  let count = stringToInt(mapGet(program, "statementCount"))
  let index: i32 = 0

  while index < count do {
    let prefix = statementPrefix(index)
    if includes(mapGet(program, prefix + "Kind"), "while") {
      out = emitWhileStatement(out, intToString(index), program, symbols, prefix)
    }

    index = index + 1
  }

  return out
}

function emitWhileStatementsIr(out: string, ir: IrModule, program: string, symbols: string): string {
  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "while") {
      out = emitWhileStatementIr(out, intToString(index), symbols, statement)
    }

    index = index + 1
  }

  return out
}

function emitWhileStatementIr(out: string, slot: string, symbols: string, statement: IrStatement): string {
  let leftName = statement.expressionLeftValue
  let rightValue = statement.expressionRightValue
  let assignName = statement.bodyAssignName
  let addLeft = statement.bodyAddLeft
  let addRight = statement.bodyAddRight
  let incrementName = statement.bodyIncrementName

  out = stringBuilderAppend(out, "  br label %while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %while.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = icmp slt i32 %")
  out = stringBuilderAppend(out, leftName)
  out = stringBuilderAppend(out, ".cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ")
  out = stringBuilderAppend(out, rightValue)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  br i1 %while.keep.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %while.body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", label %while.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, addLeft)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", %")
  out = stringBuilderAppend(out, addRight)
  out = stringBuilderAppend(out, ".body.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "  store i32 %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = load i32, ptr %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, " = add i32 %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".update.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", 1
")
  out = stringBuilderAppend(out, "  store i32 %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".next.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ", ptr %")
  out = stringBuilderAppend(out, incrementName)
  out = stringBuilderAppend(out, ".addr
")
  out = stringBuilderAppend(out, "  br label %while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.end.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
  out = stringBuilderAppend(out, "  %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".done = load i32, ptr %")
  out = stringBuilderAppend(out, assignName)
  out = stringBuilderAppend(out, ".addr
")

  return out
}

function emitWhileStatement(out: string, slot: string, program: string, symbols: string, prefix: string): string {
  let leftName = mapGet(program, prefix + "ExprLeftValue")
  let rightValue = mapGet(program, prefix + "ExprRightValue")
  let assignName = mapGet(program, prefix + "BodyAssignName")
  let addLeft = mapGet(program, prefix + "BodyAddLeft")
  let addRight = mapGet(program, prefix + "BodyAddRight")
  let incrementName = mapGet(program, prefix + "BodyIncrementName")

  out = stringBuilderAppend(out, "  br label %while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, "
")
  out = stringBuilderAppend(out, "while.cond.")
  out = stringBuilderAppend(out, slot)
  out = stringBuilderAppend(out, ":
")
