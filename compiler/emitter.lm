  out = stringBuilderAppend(out, '  %simple.ptr = call ptr @strstr(ptr %source, ptr getelementptr inbounds ([23 x i8], ptr @.pat.simple, i64 0, i64 0))
')
  out = stringBuilderAppend(out, '  %is.simple = icmp ne ptr %simple.ptr, null
