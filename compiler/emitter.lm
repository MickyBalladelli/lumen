  let index: i32 = 0

  while index < ir.statementCount do {
    let statement = statementAt(ir, program, index)
    if includes(statement.kind, "while") {
      out = emitWhileStatementIr(out, intToString(index), symbols, statement)
    }

    index = index + 1
  }

  return out
}

