import { TokenArena, diagnosticArenaGet, tokenArenaGet } from "./containers.lm"
import { AstProgram } from "./ast.lm"
import { loadModuleGraph } from "./modules.lm"
import { analyzeSemantics } from "./semantics.lm"
import { checkTypes } from "./typechecker.lm"
import { buildIr } from "./ir.lm"
import { emitIr } from "./emitter.lm"

function diagnosticTokenText(tokens: TokenArena, index: i32): string {
  let token = tokenArenaGet(tokens, index)
  return token.lexeme
}

function diagnosticFindToken(source: string, needle: string, start: i32): i32 {
  let length = stringLen(source)
  let needleLength = stringLen(needle)

  while start + needleLength <= length do {
    if stringEquals(source[start..start + needleLength], needle) {
      return start
    }

    start = start + 1
  }

  return length
}

function diagnosticLineBefore(source: string, end: i32): i32 {
  let line: i32 = 1
  let index: i32 = 0

  while index < end do {
    let ch = source[index..index + 1]
    if includes('
', ch) {
      line = line + 1
    }

    index = index + 1
  }

  return line
}

function diagnosticTokenLine(source: string, tokens: TokenArena, target: i32): i32 {
  let index: i32 = 0
  let cursor: i32 = 0

  while index <= target do {
    let text = diagnosticTokenText(tokens, index)
    cursor = diagnosticFindToken(source, text, cursor)

    if index == target {
      return diagnosticLineBefore(source, cursor)
    }

    let textLength = stringLen(text)
    cursor = cursor + textLength
    index = index + 1
  }

  return 1
}

function diagnosticMessage(source: string, tokens: TokenArena, message: string, tokenIndex: i32): string {
  let line = diagnosticTokenLine(source, tokens, tokenIndex)
  let lineText = intToString(line)
  let near = diagnosticTokenText(tokens, tokenIndex)
  return message + " at line " + lineText + " near " + near
}

function compileTiny(input: string, output: string): i32 {
  let graph = loadModuleGraph(input)
  if !graph.ok {
    let diagnosticIndex: i32 = 0
    while diagnosticIndex < graph.diagnostics.count do {
      let diagnostic = diagnosticArenaGet(graph.diagnostics, diagnosticIndex)
      println(
        "compile error: " +
        diagnostic.message +
        " at " +
        diagnostic.file +
        ":" +
        intToString(diagnostic.line) +
        ":" +
        intToString(diagnostic.column)
      )
      diagnosticIndex = diagnosticIndex + 1
    }
    return 1
  }
  let source = graph.entrySource
  let ast = graph.program
  let tokens = ast.tokens
  let semanticResult = analyzeSemantics(ast)

  if semanticResult.ok {
    let checked = 1
  } else {
    println(diagnosticMessage(source, tokens, semanticResult.message, semanticResult.tokenIndex))
    return 1
  }

  let typeResult = checkTypes(ast)
  if typeResult.ok {
    let checkedTypes = 1
  } else {
    println(diagnosticMessage(source, tokens, typeResult.message, typeResult.tokenIndex))
    return 1
  }

  let ir = buildIr(ast)
  let llvm = emitIr(ir)

  let writeResult = writeFile(output, llvm)
  if !isOk(writeResult) {
    println(errorMessage(writeResult))
    return 1
  }
  return resultValue(writeResult)
}

function main(): i32 {
  let argsResult = argCount()
  if !isOk(argsResult) {
    println(errorMessage(argsResult))
    return 1
  }
  let args = resultValue(argsResult)

  if args < 3 {
    println("usage: lumen-compiler input.lm output.ll")
    return 1
  }

  let inputResult = arg(1)
  let outputResult = arg(2)
  if !isOk(inputResult) {
    println(errorMessage(inputResult))
    return 1
  }
  if !isOk(outputResult) {
    println(errorMessage(outputResult))
    return 1
  }

  return compileTiny(resultValue(inputResult), resultValue(outputResult))
}
