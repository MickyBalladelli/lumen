import { TokenArena, diagnosticArenaGet, tokenArenaGet } from "./containers.lm"
import { AstProgram } from "./ast.lm"
import { loadModuleGraph } from "./modules.lm"
import { analyzeSemantics } from "./semantics.lm"
import { checkTypes } from "./typechecker.lm"
import { analyzeControlFlow } from "./controlflow.lm"
import { buildIr } from "./ir.lm"
import { emitIr, emitIrError } from "./emitter.lm"
import { compilerAbiRuntimeLinkInputs } from "./abi.lm"

function diagnosticMessage(entryPath: string, tokens: TokenArena, message: string, tokenIndex: i32): string {
  let token = tokenArenaGet(tokens, tokenIndex)
  if stringEquals(token.file, entryPath) {
    return message + " at line " + intToString(token.line) + " near " + token.lexeme
  }
  return message +
    " at " + token.file +
    ":" + intToString(token.line) +
    ":" + intToString(token.column) +
    " near " + token.lexeme
}

function reportCompilerDiagnostic(machine: bool, file: string, line: i32, column: i32, message: string): i32 {
  if machine {
    println("LUMEN_DIAGNOSTIC|" + file + "|" + intToString(line) + "|" + intToString(column) + "|" + message)
  } else {
    println(message)
  }
  return 1
}

function compileTiny(input: string, output: string, machine: bool): i32 {
  let graph = loadModuleGraph(input)
  if !graph.ok {
    let diagnosticIndex: i32 = 0
    while diagnosticIndex < graph.diagnostics.count do {
      let diagnostic = diagnosticArenaGet(graph.diagnostics, diagnosticIndex)
      if machine {
        reportCompilerDiagnostic(
          true,
          diagnostic.file,
          diagnostic.line,
          diagnostic.column,
          "compile error: " + diagnostic.message
        )
      } else {
        println(
          "compile error: " + diagnostic.message + " at " + diagnostic.file +
          ":" + intToString(diagnostic.line) + ":" + intToString(diagnostic.column)
        )
      }
      diagnosticIndex = diagnosticIndex + 1
    }
    return 1
  }
  let ast = graph.program
  let tokens = ast.tokens
  let semanticResult = analyzeSemantics(ast)

  if semanticResult.ok {
    let checked = 1
  } else {
    let token = tokenArenaGet(tokens, semanticResult.tokenIndex)
    if machine {
      return reportCompilerDiagnostic(true, token.file, token.line, token.column, semanticResult.message)
    }
    println(diagnosticMessage(graph.entryPath, tokens, semanticResult.message, semanticResult.tokenIndex))
    return 1
  }

  let typeResult = checkTypes(ast)
  if typeResult.ok {
    let checkedTypes = 1
  } else {
    let token = tokenArenaGet(tokens, typeResult.tokenIndex)
    if machine {
      return reportCompilerDiagnostic(true, token.file, token.line, token.column, typeResult.message)
    }
    println(diagnosticMessage(graph.entryPath, tokens, typeResult.message, typeResult.tokenIndex))
    return 1
  }

  let flow = analyzeControlFlow(ast, semanticResult.symbols)
  if !flow.ok {
    let token = tokenArenaGet(tokens, flow.tokenIndex)
    if machine {
      return reportCompilerDiagnostic(true, token.file, token.line, token.column, flow.message)
    }
    println(diagnosticMessage(graph.entryPath, tokens, flow.message, flow.tokenIndex))
    return 1
  }

  let ir = buildIr(ast)
  let backendError = emitIrError(ir)
  if !stringEquals(backendError, "") {
    if machine {
      return reportCompilerDiagnostic(true, graph.entryPath, 1, 1, backendError)
    }
    println(backendError)
    return 1
  }
  let llvm = emitIr(ir)

  if machine {
    return 0
  }
  let writeResult = writeFile(output, llvm)
  if !isOk(writeResult) {
    println(errorMessage(writeResult))
    return 1
  }
  return resultValue(writeResult)
}

function cleanupCompilerFile(path: string): i32 {
  let cleanup = removeFile(path)
  if !isOk(cleanup) {
    return 1
  }
  return 0
}

function compilerDirname(path: string): string {
  let end = lastIndexOf(path, "/")
  if end < 0 {
    return "."
  }
  if end == 0 {
    return "/"
  }
  return path[0..end]
}

function compilerRuntimeRoot(): string {
  let executableResult = arg(0)
  if !isOk(executableResult) {
    return "src/runtime"
  }
  let platformDirectory = compilerDirname(resultValue(executableResult))
  let nativeDirectory = compilerDirname(platformDirectory)
  let packageDirectory = compilerDirname(nativeDirectory)
  return packageDirectory + "/src/runtime"
}

function compilerOutputArgument(args: i32, input: string, extension: string): string {
  if args >= 5 {
    let optionResult = arg(3)
    let outputResult = arg(4)
    if isOk(optionResult) && isOk(outputResult) && stringEquals(resultValue(optionResult), "-o") {
      return resultValue(outputResult)
    }
  }
  if args >= 4 {
    let outputResult = arg(3)
    if isOk(outputResult) {
      return resultValue(outputResult)
    }
  }
  return input + extension
}

function compilerPrintHelp(): i32 {
  println("usage: lumen <command> [file.lm] [options]")
  println("commands:")
  println("  build [file.lm]       build a native executable")
  println("  emit [file.lm]        emit LLVM IR")
  println("  run [file.lm]         build and run a program")
  println("options:")
  println("  -o <path>             set output path")
  println("  -h, --help            show help")
  println("  -V, --version         show version")
  return 0
}

function emitAtomic(input: string, output: string): i32 {
  let temporary = output + "." + uuid() + ".tmp"
  let code = compileTiny(input, temporary, false)
  if code != 0 {
    cleanupCompilerFile(temporary)
    return code
  }
  let publish = atomicReplace(temporary, output)
  if !isOk(publish) {
    println(errorMessage(publish))
    cleanupCompilerFile(temporary)
    return 1
  }
  return 0
}

function buildNative(input: string, output: string, clang: string, runtimeRoot: string): i32 {
  let nonce = uuid()
  let llvmPath = output + "." + nonce + ".tmp.ll"
  let responseFile = output + "." + nonce + ".rsp.tmp"
  let executable = output + "." + nonce + ".exe.tmp"
  let compileCode = compileTiny(input, llvmPath, false)
  if compileCode != 0 {
    cleanupCompilerFile(llvmPath)
    return compileCode
  }

  let llvmResult = readFile(llvmPath)
  if !isOk(llvmResult) {
    println(errorMessage(llvmResult))
    cleanupCompilerFile(llvmPath)
    return 1
  }
  let responseResult = writeFile(responseFile, compilerAbiRuntimeLinkInputs(resultValue(llvmResult), runtimeRoot))
  if !isOk(responseResult) {
    println(errorMessage(responseResult))
    cleanupCompilerFile(llvmPath)
    cleanupCompilerFile(responseFile)
    return 1
  }

  let arguments: string[] = [
    "-Wno-override-module",
    "-g",
    llvmPath,
    "@" + responseFile,
    "-pthread",
    "-o",
    executable
  ]
  let link = exec(clang, arguments)
  if !isOk(link) || resultValue(link) != 0 {
    if !isOk(link) {
      println(errorMessage(link))
    } else {
      println("clang exited with " + intToString(resultValue(link)))
    }
    cleanupCompilerFile(llvmPath)
    cleanupCompilerFile(responseFile)
    cleanupCompilerFile(executable)
    return 1
  }

  let publish = atomicReplace(executable, output)
  cleanupCompilerFile(llvmPath)
  cleanupCompilerFile(responseFile)
  if !isOk(publish) {
    println(errorMessage(publish))
    cleanupCompilerFile(executable)
    return 1
  }
  return 0
}

function main(): i32 {
  let argsResult = argCount()
  if !isOk(argsResult) {
    println(errorMessage(argsResult))
    return 1
  }
  let args = resultValue(argsResult)

  if args < 2 {
    compilerPrintHelp()
    return 1
  }

  let firstResult = arg(1)
  if !isOk(firstResult) {
    println("cannot read compiler arguments")
    return 1
  }
  let first = resultValue(firstResult)

  if stringEquals(first, "--version") || stringEquals(first, "-V") {
    println("0.1.0")
    return 0
  }
  if stringEquals(first, "--help") || stringEquals(first, "-h") || stringEquals(first, "help") {
    return compilerPrintHelp()
  }
  if args < 3 {
    compilerPrintHelp()
    return 1
  }

  let secondResult = arg(2)
  if !isOk(secondResult) {
    println("cannot read compiler input")
    return 1
  }
  let second = resultValue(secondResult)

  if stringEquals(first, "emit") {
    return emitAtomic(second, compilerOutputArgument(args, second, ".ll"))
  }

  if stringEquals(first, "diagnose") {
    return compileTiny(second, "", true)
  }

  if stringEquals(first, "build") {
    if args >= 6 {
      let outputResult = arg(3)
      let clangResult = arg(4)
      let runtimeResult = arg(5)
      if !isOk(outputResult) || !isOk(clangResult) || !isOk(runtimeResult) {
        println("cannot read build arguments")
        return 1
      }
      return buildNative(
        second,
        resultValue(outputResult),
        resultValue(clangResult),
        resultValue(runtimeResult)
      )
    }
    return buildNative(second, compilerOutputArgument(args, second, ".out"), "clang", compilerRuntimeRoot())
  }

  if stringEquals(first, "run") {
    let output = compilerOutputArgument(args, second, ".out")
    let buildCode = buildNative(second, output, "clang", compilerRuntimeRoot())
    if buildCode != 0 {
      return buildCode
    }
    let noArguments: string[] = []
    let runResult = exec(output, noArguments)
    if !isOk(runResult) {
      println(errorMessage(runResult))
      return 1
    }
    return resultValue(runResult)
  }

  let inputResult = firstResult
  let outputResult = secondResult
  if !isOk(inputResult) {
    println(errorMessage(inputResult))
    return 1
  }
  if !isOk(outputResult) {
    println(errorMessage(outputResult))
    return 1
  }

  return compileTiny(resultValue(inputResult), resultValue(outputResult), false)
}
