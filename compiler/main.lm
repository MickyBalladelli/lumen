import { tokenize } from "./tokenizer.lm"
import { parseAst, parseProgram } from "./parser.lm"
import { analyzeSemantics } from "./semantics.lm"
import { checkTypes } from "./typechecker.lm"
import { emitMain } from "./emitter.lm"

function compileTiny(input: string, output: string): i32 {
  let source = readFile(input)
  let tokens = tokenize(source)
  let ast = parseAst(tokens)
  let semanticResult = analyzeSemantics(ast, tokens)

  if semanticResult.ok {
    let checked = 1
  } else {
    println(semanticResult.message)
    return 1
  }

  let typeResult = checkTypes(ast, tokens)
  if typeResult.ok {
    let checkedTypes = 1
  } else {
    println(typeResult.message)
    return 1
  }

  let program = parseProgram(tokens)
  let llvm = emitMain(program)

  return writeFile(output, llvm)
}

function main(): i32 {
  let args = argCount()

  if args < 3 {
    println("usage: lumen-compiler input.lm output.ll")
    return 1
  }

  return compileTiny(arg(1), arg(2))
}
