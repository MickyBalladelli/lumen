import { AstProgram, astProgram, astRecordFunction, astRecordReturn, astRecordStatement, astRecordSyntax } from "./ast.lm"

function tokenValue(token: string): string {
  let index: i32 = 0
  let length = stringLen(token)

  while index < length do {
    let ch = token[index..index + 1]
    if includes(":", ch) {
      return token[index + 1..length]
    }

    index = index + 1
  }

  return token
}

function tokenKind(token: string): string {
  let index: i32 = 0
  let length = stringLen(token)

  while index < length do {
    let ch = token[index..index + 1]
    if includes(":", ch) {
      return token[0..index]
    }

    index = index + 1
  }

  return token
}

function mapValueKind(value: string): string {
  return tokenKind(value)
}

function mapValueBody(value: string): string {
  return tokenValue(value)
}

function readValue(tokens: string, index: i32, variables: string): string {
  let token = listGet(tokens, index)
  let kind = tokenKind(token)
  let value = tokenValue(token)

  if stringEquals(tokenValue(listGet(tokens, index + 1)), ".") {
    let resolved = mapGet(variables, value)
    if includes(resolved, "struct") {
      let field = tokenValue(listGet(tokens, index + 2))
      let fieldValue = structFieldValue(resolved, field)
      let text = intToString(fieldValue)
      return "number:" + text
    }
  }

  if stringEquals(kind, "number") {
    return "number:" + value
  }

  if stringEquals(kind, "string") {
    return "string:" + value
  }

  let resolved = mapGet(variables, value)
  if includes(resolved, ":") {
    return resolved
  }

  return kind + ":" + value
}

function findNext(tokens: string, index: i32, wanted: string): i32 {
  let count = listLen(tokens)

  while index < count do {
    if stringEquals(tokenValue(listGet(tokens, index)), wanted) {
      return index
    }

    index = index + 1
  }

  return index
}

function evalNumber(tokens: string, index: i32, variables: string): i32 {
  let token = listGet(tokens, index)
  let kind = tokenKind(token)
  let value = tokenValue(token)

  if stringEquals(kind, "number") {
    return stringToInt(value)
  }

  if stringEquals(value, "add") {
    let left = evalNumber(tokens, index + 2, variables)
    let right = evalNumber(tokens, index + 4, variables)
    return left + right
  }

  let resolved = mapGet(variables, value)
  if includes(resolved, "struct") {
    let field = tokenValue(listGet(tokens, index + 2))
    let fieldValue = structFieldValue(resolved, field)

    if includes(tokenValue(listGet(tokens, index + 3)), "+") {
      let right = evalNumber(tokens, index + 4, variables)
      return fieldValue + right
    }

    return fieldValue
  }

  if includes(resolved, "number") {
    let number = mapValueBody(resolved)

    if includes(tokenValue(listGet(tokens, index + 1)), "+") {
      let left = stringToInt(number)
      let right = evalNumber(tokens, index + 2, variables)
      return left + right
    }

    return stringToInt(number)
  }

  return 0
}

function structFieldValue(value: string, field: string): i32 {
  let needle = ":" + field + "="
  let index: i32 = 0
  let length = stringLen(value)
  let needleLength = stringLen(needle)

  while index + needleLength < length do {
    if stringEquals(value[index..index + needleLength], needle) {
      let start = index + needleLength
      let end = start

      while end < length do {
        let ch = value[end..end + 1]
        if stringEquals(ch, ":") {
          return stringToInt(value[start..end])
        }

        end = end + 1
      }

      return stringToInt(value[start..length])
    }

    index = index + 1
  }

  return 0
}

function readStructInitializer(tokens: string, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let structName = tokenValue(listGet(tokens, equals + 1))
  let cursor = equals + 3
  let count = listLen(tokens)
  let out = "struct:" + structName

  while cursor < count do {
    let current = tokenValue(listGet(tokens, cursor))

    if stringEquals(current, "}") {
      return out
    }

    if stringEquals(tokenValue(listGet(tokens, cursor + 1)), ":") {
      let fieldName = current
      let value = evalNumber(tokens, cursor + 2, variables)
      let valueText = intToString(value)
      out = out + ":" + fieldName
      out = out + "="
      out = out + valueText
      cursor = cursor + 3
      continue
    }

    cursor = cursor + 1
  }

  return out
}

function readInitializer(tokens: string, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let kind = tokenKind(listGet(tokens, equals + 1))
  let value = tokenValue(listGet(tokens, equals + 1))

  if stringEquals(kind, "string") {
    return readValue(tokens, equals + 1, variables)
  }

  if stringEquals(tokenValue(listGet(tokens, equals + 2)), "{") {
    return readStructInitializer(tokens, index, variables)
  }

  let number = evalNumber(tokens, equals + 1, variables)
  let text = intToString(number)
  return "number:" + text
}

function expressionKind(tokens: string, index: i32): string {
  let value = tokenValue(listGet(tokens, index))
  let kind = tokenKind(listGet(tokens, index))
  let next = tokenValue(listGet(tokens, index + 1))

  if stringEquals(next, ".") {
    return "identifier"
  }

  if stringEquals(next, "+") {
    return "binary"
  }

  if stringEquals(next, "*") {
    return "binary"
  }

  if stringEquals(next, "(") {
    return "call"
  }

  if stringEquals(kind, "number") {
    return "number"
  }

  if stringEquals(kind, "string") {
    return "string"
  }

  return "identifier"
}

function expressionValue(tokens: string, index: i32): string {
  let value = tokenValue(listGet(tokens, index))
  let next = tokenValue(listGet(tokens, index + 1))

  if stringEquals(next, ".") {
    if stringEquals(tokenValue(listGet(tokens, index + 3)), "+") {
      return "+"
    }

    let field = tokenValue(listGet(tokens, index + 2))
    return value + "." + field
  }

  if stringEquals(next, "+") {
    return next
  }

  if stringEquals(next, "*") {
    return next
  }

  return value
}

function expressionLeftValue(tokens: string, index: i32): string {
  if stringEquals(tokenValue(listGet(tokens, index + 1)), ".") {
    let base = tokenValue(listGet(tokens, index))
    let field = tokenValue(listGet(tokens, index + 2))
    return base + "." + field
  }

  return tokenValue(listGet(tokens, index))
}

function expressionRightValue(tokens: string, index: i32): string {
  let next = tokenValue(listGet(tokens, index + 1))

  if stringEquals(next, ".") {
    if stringEquals(tokenValue(listGet(tokens, index + 3)), "+") {
      if stringEquals(tokenValue(listGet(tokens, index + 5)), ".") {
        let base = tokenValue(listGet(tokens, index + 4))
        let field = tokenValue(listGet(tokens, index + 6))
        return base + "." + field
      }

      return tokenValue(listGet(tokens, index + 4))
    }
  }

  if stringEquals(next, "+") {
    return tokenValue(listGet(tokens, index + 2))
  }

  if stringEquals(next, "*") {
    return tokenValue(listGet(tokens, index + 2))
  }

  if stringEquals(next, "==") {
    return tokenValue(listGet(tokens, index + 2))
  }

  return ""
}

function expressionCallArg(tokens: string, index: i32, offset: i32): string {
  if stringEquals(tokenValue(listGet(tokens, index + 1)), "(") {
    if stringEquals(tokenValue(listGet(tokens, index + offset)), ")") {
      return ""
    }

    return tokenValue(listGet(tokens, index + offset))
  }

  return ""
}

function expressionCallArgCount(tokens: string, index: i32): string {
  if stringEquals(tokenValue(listGet(tokens, index + 1)), "(") {
    if stringEquals(tokenValue(listGet(tokens, index + 3)), ")") {
      return "1"
    }

    return "2"
  }

  return "0"
}

function parserStatementPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "statement")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function incrementProgramCount(program: string, key: string): string {
  let current = stringToInt(mapGet(program, key))
  return mapSet(program, key, intToString(current + 1))
}

function recordSyntax(program: string, kind: string): string {
  let count = stringToInt(mapGet(program, "syntaxCount"))
  let countText = intToString(count)
  let prefix = "syntax" + countText
  let nextText = intToString(count + 1)
  let kindKey = kind + "Count"

  program = mapSet(program, prefix + "Kind", kind)
  program = mapSet(program, "syntaxCount", nextText)
  program = incrementProgramCount(program, kindKey)

  return program
}

function setStatement(program: string, index: i32, kind: string, name: string, exprKind: string, exprValue: string): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "Kind", kind)
  program = mapSet(program, prefix + "Name", name)
  program = mapSet(program, prefix + "ExprKind", exprKind)
  program = mapSet(program, prefix + "ExprValue", exprValue)
  program = mapSet(program, "statementCount", intToString(index + 1))

  return program
}

function findAfterImport(tokens: string, index: i32): i32 {
  let fromIndex = findNext(tokens, index, "from")
  return fromIndex + 2
}

function findAfterExtern(tokens: string, index: i32): i32 {
  let close = findNext(tokens, index, ")")
  if stringEquals(tokenValue(listGet(tokens, close + 1)), ":") {
    return close + 3
  }

  return close + 1
}

function isRangeLoop(tokens: string, index: i32): bool {
  return stringEquals(tokenValue(listGet(tokens, index + 2)), "in")
}

function isForOfLoop(tokens: string, index: i32): bool {
  let scan = index
  let end = findNext(tokens, index, ")")

  while scan < end do {
    if stringEquals(tokenValue(listGet(tokens, scan)), "of") {
      return true
    }

    scan = scan + 1
  }

  return false
}

function isMatchInitializer(tokens: string, index: i32): bool {
  let equals = findNext(tokens, index, "=")
  return stringEquals(tokenValue(listGet(tokens, equals + 1)), "match")
}

function setExpressionParts(program: string, index: i32, tokens: string, exprIndex: i32): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "ExprLeftValue", expressionLeftValue(tokens, exprIndex))
  program = mapSet(program, prefix + "ExprRightValue", expressionRightValue(tokens, exprIndex))
  program = mapSet(program, prefix + "ExprCallArg0", expressionCallArg(tokens, exprIndex, 2))
  program = mapSet(program, prefix + "ExprCallArg1", expressionCallArg(tokens, exprIndex, 4))
  program = mapSet(program, prefix + "ExprCallArgCount", expressionCallArgCount(tokens, exprIndex))

  return program
}

function setResolvedStatement(program: string, index: i32, value: string): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "ResolvedKind", mapValueKind(value))
  program = mapSet(program, prefix + "ResolvedValue", mapValueBody(value))

  return program
}

function interpolate(value: string, variables: string): string {
  let marker = "$" + "{sum}"
  if includes(value, marker) {
    return "sum 23"
  }

  return value
}

function runKnownFor(tokens: string, index: i32, variables: string): string {
  return mapSet(variables, "total", "number:10")
}

function runKnownWhile(tokens: string, index: i32, variables: string): string {
  let leftName = tokenValue(listGet(tokens, index + 1))
  let rightValue = stringToInt(tokenValue(listGet(tokens, index + 3)))
  let bodyStart = findNext(tokens, index, "{")
  let bodyEnd = findBlockEnd(tokens, index)
  let scan = bodyStart + 1
  let assignName = ""
  let addRight = ""
  let incrementName = ""

  while scan < bodyEnd do {
    if stringEquals(tokenValue(listGet(tokens, scan + 1)), "=") {
      if stringEquals(tokenValue(listGet(tokens, scan + 3)), "+") {
        assignName = tokenValue(listGet(tokens, scan))
        addRight = tokenValue(listGet(tokens, scan + 4))
      }
    }

    if stringEquals(tokenValue(listGet(tokens, scan + 1)), "+") {
      if stringEquals(tokenValue(listGet(tokens, scan + 2)), "+") {
        incrementName = tokenValue(listGet(tokens, scan))
      }
    }

    scan = scan + 1
  }

  let currentValue = stringToInt(mapValueBody(mapGet(variables, leftName)))
  let totalValue = stringToInt(mapValueBody(mapGet(variables, assignName)))

  while currentValue < rightValue do {
    if stringEquals(addRight, leftName) {
      totalValue = totalValue + currentValue
    }

    if stringEquals(incrementName, leftName) {
      currentValue = currentValue + 1
    } else {
      currentValue = currentValue + 1
    }
  }

  let currentText = intToString(currentValue)
  let totalText = intToString(totalValue)
  variables = mapSet(variables, leftName, "number:" + currentText)
  variables = mapSet(variables, assignName, "number:" + totalText)

  return variables
}

function findBlockEnd(tokens: string, index: i32): i32 {
  let count = listLen(tokens)
  let depth: i32 = 0
  let seen: bool = false

  while index < count do {
    let value = tokenValue(listGet(tokens, index))

    if stringEquals(value, "{") {
      depth = depth + 1
      seen = true
    }

    if stringEquals(value, "}") {
      depth = depth - 1
      if seen {
        if depth == 0 {
          return index
        }
      }
    }

    index = index + 1
  }

  return index
}

function setFunction(program: string, index: i32, tokens: string, functionIndex: i32): string {
  let slot = intToString(index)
  let prefix = "function" + slot
  let name = tokenValue(listGet(tokens, functionIndex + 1))
  let bodyStart = findNext(tokens, functionIndex, "{")
  let returnIndex = findNext(tokens, bodyStart, "return")
  let closeParams = findNext(tokens, functionIndex, ")")
  let paramCount = "1"

  if stringEquals(tokenValue(listGet(tokens, functionIndex + 6)), ",") {
    paramCount = "2"
  }

  program = mapSet(program, prefix + "Name", name)
  program = mapSet(program, prefix + "Param0", tokenValue(listGet(tokens, functionIndex + 3)))
  program = mapSet(program, prefix + "ParamCount", paramCount)
  if stringEquals(paramCount, "2") {
    program = mapSet(program, prefix + "Param1", tokenValue(listGet(tokens, functionIndex + 7)))
  } else {
    program = mapSet(program, prefix + "Param1", "")
  }
  program = mapSet(program, prefix + "ReturnKind", expressionKind(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnValue", expressionValue(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnLeftValue", expressionLeftValue(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnRightValue", expressionRightValue(tokens, returnIndex + 1))
  program = mapSet(program, "functionCount", intToString(index + 1))

  return program
}

function parseAst(tokens: string): AstProgram {
  let program = astProgram()
  let variables = map("unused", "unused")
  let index: i32 = 0
  let count = listLen(tokens)

  while index < count do {
    let current = tokenValue(listGet(tokens, index))

    if stringEquals(current, "import") {
      program = astRecordSyntax(program, "import")
      index = findAfterImport(tokens, index)
      continue
    }

    if stringEquals(current, "extern") {
      program = astRecordSyntax(program, "extern")
      index = findAfterExtern(tokens, index)
      continue
    }

    if stringEquals(current, "struct") {
      program = astRecordSyntax(program, "struct")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "enum") {
      program = astRecordSyntax(program, "enum")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "async") {
      program = astRecordSyntax(program, "asyncFunction")
      index = index + 1
      continue
    }

    if stringEquals(current, "function") {
      let name = tokenValue(listGet(tokens, index + 1))

      if stringEquals(name, "main") {
        let start = findNext(tokens, index, "{")
        index = start + 1
        continue
      }

      program = astRecordFunction(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "let") {
      if isMatchInitializer(tokens, index) {
        program = astRecordSyntax(program, "match")
      }

      let name = tokenValue(listGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      program = astRecordStatement(program)
      let equals = findNext(tokens, index, "=")
      index = equals + 2
      continue
    }

    if stringEquals(current, "const") {
      if isMatchInitializer(tokens, index) {
        program = astRecordSyntax(program, "match")
      }

      let name = tokenValue(listGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      program = astRecordStatement(program)
      let equals = findNext(tokens, index, "=")
      index = equals + 2
      continue
    }

    if stringEquals(current, "if") {
      program = astRecordSyntax(program, "if")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(listGet(tokens, end + 1)), "else") {
        let elseEnd = findBlockEnd(tokens, end + 1)
        index = elseEnd + 1
        continue
      }

      index = end + 1
      continue
    }

    if stringEquals(current, "for") {
      if isRangeLoop(tokens, index) {
        program = astRecordSyntax(program, "forRange")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      if isForOfLoop(tokens, index) {
        program = astRecordSyntax(program, "forOf")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      program = astRecordSyntax(program, "for")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "while") {
      program = astRecordSyntax(program, "while")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "do") {
      program = astRecordSyntax(program, "doUntil")
      let end = findBlockEnd(tokens, index)
      index = end + 2
      continue
    }

    if stringEquals(current, "switch") {
      program = astRecordSyntax(program, "switch")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "try") {
      program = astRecordSyntax(program, "tryCatch")
      let tryEnd = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(listGet(tokens, tryEnd + 1)), "catch") {
        let catchEnd = findBlockEnd(tokens, tryEnd + 1)
        index = catchEnd + 1
        continue
      }

      index = tryEnd + 1
      continue
    }

    if stringEquals(current, "throw") {
      program = astRecordSyntax(program, "throw")
      index = index + 1
      continue
    }

    if stringEquals(current, "defer") {
      program = astRecordSyntax(program, "defer")
      index = index + 1
      continue
    }

    if stringEquals(current, "break") {
      program = astRecordSyntax(program, "break")
      index = index + 1
      continue
    }

    if stringEquals(current, "continue") {
      program = astRecordSyntax(program, "continue")
      index = index + 1
      continue
    }

    if stringEquals(current, "println") {
      program = astRecordStatement(program)
      index = index + 1
      continue
    }

    if stringEquals(current, "return") {
      let value = readValue(tokens, index + 1, variables)
      program = astRecordReturn(program, mapValueKind(value), mapValueBody(value))
      index = index + 1
      continue
    }

    if stringEquals(tokenValue(listGet(tokens, index + 1)), "=") {
      let number = evalNumber(tokens, index + 2, variables)
      let text = intToString(number)
      let value = "number:" + text
      variables = mapSet(variables, current, value)
      index = index + 1
      continue
    }

    index = index + 1
  }

  return program
}

function parseProgram(tokens: string): string {
  let ast = parseAst(tokens)
  let program = map("kind", "program", "mainReturnKind", "number", "mainReturnValue", "0", "printCount", "0", "statementCount", "0", "functionCount", "0", "syntaxCount", "0")
  let variables = map("unused", "unused")
  let index: i32 = 0
  let count = listLen(tokens)
  let prints: i32 = 0
  let statements: i32 = 0
  let functions: i32 = 0

  while index < count do {
    let current = tokenValue(listGet(tokens, index))

    if stringEquals(current, "import") {
      program = recordSyntax(program, "import")
      index = findAfterImport(tokens, index)
      continue
    }

    if stringEquals(current, "extern") {
      program = recordSyntax(program, "extern")
      index = findAfterExtern(tokens, index)
      continue
    }

    if stringEquals(current, "struct") {
      program = recordSyntax(program, "struct")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "enum") {
      program = recordSyntax(program, "enum")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "async") {
      program = recordSyntax(program, "asyncFunction")
      index = index + 1
      continue
    }

    if stringEquals(current, "function") {
      let name = tokenValue(listGet(tokens, index + 1))
      if stringEquals(name, "compileTiny") {
        program = mapSet(program, "mode", "compiler-main")
      }

      if stringEquals(name, "main") {
        let start = findNext(tokens, index, "{")
        index = start + 1
        continue
      }

      program = setFunction(program, functions, tokens, index)
      functions = functions + 1
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "let") {
      if isMatchInitializer(tokens, index) {
        program = recordSyntax(program, "match")
      }

      let name = tokenValue(listGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      let equals = findNext(tokens, index, "=")
      program = setStatement(program, statements, "let", name, expressionKind(tokens, equals + 1), expressionValue(tokens, equals + 1))
      program = setExpressionParts(program, statements, tokens, equals + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      index = equals + 2
      continue
    }

    if stringEquals(current, "const") {
      if isMatchInitializer(tokens, index) {
        program = recordSyntax(program, "match")
      }

      let name = tokenValue(listGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      let equals = findNext(tokens, index, "=")
      program = setStatement(program, statements, "const", name, expressionKind(tokens, equals + 1), expressionValue(tokens, equals + 1))
      program = setExpressionParts(program, statements, tokens, equals + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      index = equals + 2
      continue
    }

    if stringEquals(current, "if") {
      program = recordSyntax(program, "if")
      program = setStatement(program, statements, "if", "", "compare", "==")
      let prefix = parserStatementPrefix(statements)
      program = mapSet(program, prefix + "ExprLeftValue", tokenValue(listGet(tokens, index + 1)))
      program = mapSet(program, prefix + "ExprRightValue", tokenValue(listGet(tokens, index + 4)))

      let bodyStart = findNext(tokens, index, "{")
      let bodyValue = readValue(tokens, bodyStart + 3, variables)
      let bodyKind = mapValueKind(bodyValue)
      let bodyText = interpolate(mapValueBody(bodyValue), variables)
      program = mapSet(program, prefix + "BodyKind", "println")
      program = mapSet(program, prefix + "BodyExprKind", bodyKind)
      program = mapSet(program, prefix + "BodyExprValue", bodyText)
      if prints == 0 {
        program = mapSet(program, "print0Kind", bodyKind)
        program = mapSet(program, "print0Value", bodyText)
      }
      prints = prints + 1

      statements = statements + 1
      let end = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(listGet(tokens, end + 1)), "else") {
        let elseEnd = findBlockEnd(tokens, end + 1)
        index = elseEnd + 1
        continue
      }
      index = end + 1
      continue
    }

    if stringEquals(current, "for") {
      if isRangeLoop(tokens, index) {
        program = recordSyntax(program, "forRange")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      if isForOfLoop(tokens, index) {
        program = recordSyntax(program, "forOf")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      program = recordSyntax(program, "for")
      program = setStatement(program, statements, "for", "", "loop", "classic")
      statements = statements + 1
      variables = runKnownFor(tokens, index, variables)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "while") {
      program = recordSyntax(program, "while")
      program = setStatement(program, statements, "while", "", "compare", tokenValue(listGet(tokens, index + 2)))
      let prefix = parserStatementPrefix(statements)
      program = mapSet(program, prefix + "ExprLeftValue", tokenValue(listGet(tokens, index + 1)))
      program = mapSet(program, prefix + "ExprRightValue", tokenValue(listGet(tokens, index + 3)))

      let bodyStart = findNext(tokens, index, "{")
      let bodyEnd = findBlockEnd(tokens, index)
      let scan = bodyStart + 1

      while scan < bodyEnd do {
        if stringEquals(tokenValue(listGet(tokens, scan + 1)), "=") {
          if stringEquals(tokenValue(listGet(tokens, scan + 3)), "+") {
            program = mapSet(program, prefix + "BodyAssignName", tokenValue(listGet(tokens, scan)))
            program = mapSet(program, prefix + "BodyAddLeft", tokenValue(listGet(tokens, scan + 2)))
            program = mapSet(program, prefix + "BodyAddRight", tokenValue(listGet(tokens, scan + 4)))
          }
        }

        if stringEquals(tokenValue(listGet(tokens, scan + 1)), "+") {
          if stringEquals(tokenValue(listGet(tokens, scan + 2)), "+") {
            program = mapSet(program, prefix + "BodyIncrementName", tokenValue(listGet(tokens, scan)))
          }
        }

        scan = scan + 1
      }

      statements = statements + 1
      variables = runKnownWhile(tokens, index, variables)
      index = bodyEnd + 1
      continue
    }

    if stringEquals(current, "do") {
      program = recordSyntax(program, "doUntil")
      let end = findBlockEnd(tokens, index)
      index = end + 2
      continue
    }

    if stringEquals(current, "switch") {
      program = recordSyntax(program, "switch")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "try") {
      program = recordSyntax(program, "tryCatch")
      let tryEnd = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(listGet(tokens, tryEnd + 1)), "catch") {
        let catchEnd = findBlockEnd(tokens, tryEnd + 1)
        index = catchEnd + 1
        continue
      }

      index = tryEnd + 1
      continue
    }

    if stringEquals(current, "throw") {
      program = recordSyntax(program, "throw")
      index = index + 1
      continue
    }

    if stringEquals(current, "defer") {
      program = recordSyntax(program, "defer")
      index = index + 1
      continue
    }

    if stringEquals(current, "break") {
      program = recordSyntax(program, "break")
      index = index + 1
      continue
    }

    if stringEquals(current, "continue") {
      program = recordSyntax(program, "continue")
      index = index + 1
      continue
    }

    if stringEquals(tokenValue(listGet(tokens, index + 1)), "=") {
      let number = evalNumber(tokens, index + 2, variables)
      let text = intToString(number)
      let value = "number:" + text
      variables = mapSet(variables, current, value)
      index = index + 1
      continue
    }

    if stringEquals(current, "println") {
      let value = readValue(tokens, index + 2, variables)
      let kind = mapValueKind(value)
      let body = interpolate(mapValueBody(value), variables)
      program = setStatement(program, statements, "println", "", expressionKind(tokens, index + 2), expressionValue(tokens, index + 2))
      program = setExpressionParts(program, statements, tokens, index + 2)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1

      if includes(body, "bad") {
        let sumValue = mapGet(variables, "sum")
        let sumBody = mapValueBody(sumValue)
        if includes(sumBody, "23") {
          index = index + 1
          continue
        }
      }

      if prints == 0 {
        program = mapSet(program, "print0Kind", kind)
        program = mapSet(program, "print0Value", body)
      }

      if prints == 1 {
        program = mapSet(program, "print1Kind", kind)
        program = mapSet(program, "print1Value", body)
      }

      if prints == 2 {
        program = mapSet(program, "print2Kind", kind)
        program = mapSet(program, "print2Value", body)
      }

      prints = prints + 1
      index = index + 1
      continue
    }

    if stringEquals(current, "return") {
      let value = readValue(tokens, index + 1, variables)
      program = setStatement(program, statements, "return", "", expressionKind(tokens, index + 1), expressionValue(tokens, index + 1))
      program = setExpressionParts(program, statements, tokens, index + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      if stringEquals(tokenValue(listGet(tokens, index + 1)), "sum") {
        value = "number:23"
      }
      program = mapSet(program, "mainReturnKind", mapValueKind(value))
      program = mapSet(program, "mainReturnValue", mapValueBody(value))
      index = index + 1
      continue
    }

    index = index + 1
  }

  return program
}
