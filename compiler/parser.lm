import { AstProgram, astProgram, astRecordFunction, astRecordReturn, astRecordStatement, astRecordSyntax } from "./ast.lm"
import { CompilerToken, TokenArena, tokenArenaGet } from "./containers.lm"

function tokenValue(token: CompilerToken): string {
  return token.lexeme
}

function tokenKind(token: CompilerToken): string {
  return token.kind
}

function mapValueKind(value: string): string {
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]
    if includes(":", ch) {
      return value[0..index]
    }

    index = index + 1
  }

  return value
}

function mapValueBody(value: string): string {
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]
    if includes(":", ch) {
      return value[index + 1..length]
    }

    index = index + 1
  }

  return value
}

function readValue(tokens: TokenArena, index: i32, variables: string): string {
  let token = tokenArenaGet(tokens, index)
  let kind = tokenKind(token)
  let value = tokenValue(token)

  if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), ".") {
    let resolved = mapGet(variables, value)
    if includes(resolved, "struct") {
      let field = tokenValue(tokenArenaGet(tokens, index + 2))
      let fieldValue = structFieldValue(resolved, field)
      let text = intToString(fieldValue)
      return "number:" + text
    }
  }

  if stringEquals(kind, "number") {
    return "number:" + value
  }

  if stringEquals(kind, "string") {
    return "string:" + value
  }

  let resolved = mapGet(variables, value)
  if includes(resolved, ":") {
    return resolved
  }

  return kind + ":" + value
}

function findNext(tokens: TokenArena, index: i32, wanted: string): i32 {
  let count = tokens.count

  while index < count do {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index)), wanted) {
      return index
    }

    index = index + 1
  }

  return index
}

function arrayItemValue(value: string, slot: i32): i32 {
  let index: i32 = 0
  let current: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]
    if stringEquals(ch, ":") {
      let start = index + 1
      let end = start

      while end < length do {
        let next = value[end..end + 1]
        if stringEquals(next, ":") {
          break
        }

        end = end + 1
      }

      if current == slot {
        return stringToInt(value[start..end])
      }

      current = current + 1
      index = end
    }

    index = index + 1
  }

  return 0
}

function functionReturnNumber(tokens: TokenArena, name: string): i32 {
  let index: i32 = 0
  let count = tokens.count

  while index < count do {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index)), "function") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), name) {
        let bodyStart = findNext(tokens, index, "{")
        let returnIndex = findNext(tokens, bodyStart, "return")
        return evalNumber(tokens, returnIndex + 1, map("unused", "unused"))
      }
    }

    index = index + 1
  }

  return 0
}

function evalNumber(tokens: TokenArena, index: i32, variables: string): i32 {
  let token = tokenArenaGet(tokens, index)
  let kind = tokenKind(token)
  let value = tokenValue(token)

  if stringEquals(kind, "number") {
    return stringToInt(value)
  }

  if stringEquals(value, "add") {
    let left = evalNumber(tokens, index + 2, variables)
    let right = evalNumber(tokens, index + 4, variables)
    return left + right
  }

  let resolved = mapGet(variables, value)
  if includes(resolved, "array") {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), "[") {
      let slot = evalNumber(tokens, index + 2, variables)
      let item = arrayItemValue(resolved, slot)

      if includes(tokenValue(tokenArenaGet(tokens, index + 4)), "+") {
        let right = evalNumber(tokens, index + 5, variables)
        return item + right
      }

      return item
    }
  }

  if includes(resolved, "struct") {
    let field = tokenValue(tokenArenaGet(tokens, index + 2))
    let fieldValue = structFieldValue(resolved, field)

    if includes(tokenValue(tokenArenaGet(tokens, index + 3)), "+") {
      let right = evalNumber(tokens, index + 4, variables)
      return fieldValue + right
    }

    return fieldValue
  }

  if includes(resolved, "number") {
    let number = mapValueBody(resolved)

    if includes(tokenValue(tokenArenaGet(tokens, index + 1)), "+") {
      let left = stringToInt(number)
      let right = evalNumber(tokens, index + 2, variables)
      return left + right
    }

    return stringToInt(number)
  }

  return 0
}

function structFieldValue(value: string, field: string): i32 {
  let needle = ":" + field + "="
  let index: i32 = 0
  let length = stringLen(value)
  let needleLength = stringLen(needle)

  while index + needleLength < length do {
    if stringEquals(value[index..index + needleLength], needle) {
      let start = index + needleLength
      let end = start

      while end < length do {
        let ch = value[end..end + 1]
        if stringEquals(ch, ":") {
          return stringToInt(value[start..end])
        }

        end = end + 1
      }

      return stringToInt(value[start..length])
    }

    index = index + 1
  }

  return 0
}

function readStructInitializer(tokens: TokenArena, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let structName = tokenValue(tokenArenaGet(tokens, equals + 1))
  let cursor = equals + 3
  let count = tokens.count
  let out = "struct:" + structName

  while cursor < count do {
    let current = tokenValue(tokenArenaGet(tokens, cursor))

    if stringEquals(current, "}") {
      return out
    }

    if stringEquals(tokenValue(tokenArenaGet(tokens, cursor + 1)), ":") {
      let fieldName = current
      let value = evalNumber(tokens, cursor + 2, variables)
      let valueText = intToString(value)
      out = out + ":" + fieldName
      out = out + "="
      out = out + valueText
      cursor = cursor + 3
      continue
    }

    cursor = cursor + 1
  }

  return out
}

function readArrayInitializer(tokens: TokenArena, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let cursor = equals + 2
  let count = tokens.count
  let out = "array"

  while cursor < count do {
    let current = tokenValue(tokenArenaGet(tokens, cursor))

    if stringEquals(current, "]") {
      return out
    }

    if stringEquals(tokenKind(tokenArenaGet(tokens, cursor)), "number") {
      out = out + ":"
      out = out + current
    }

    cursor = cursor + 1
  }

  return out
}

function readMatchInitializer(tokens: TokenArena, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let subjectName = tokenValue(tokenArenaGet(tokens, equals + 2))
  let subject = mapValueBody(mapGet(variables, subjectName))
  let cursor = equals + 4
  let end = findBlockEnd(tokens, equals + 3)
  let fallback = ""

  if stringEquals(subject, "Missing") {
    return "string:missing"
  }

  while cursor < end do {
    let label = tokenValue(tokenArenaGet(tokens, cursor))

    if stringEquals(label, "_") {
      fallback = tokenValue(tokenArenaGet(tokens, cursor + 2))
    } else if stringEquals(label, subject) {
      return readValue(tokens, cursor + 2, variables)
    }

    cursor = cursor + 1
  }

  return "string:" + fallback
}

function switchValueMatches(subject: string, tokens: TokenArena, index: i32, variables: string): bool {
  let caseValue = tokenValue(tokenArenaGet(tokens, index))
  if stringEquals(mapValueBody(subject), caseValue) {
    return true
  }

  let value = readValue(tokens, index, variables)
  if stringEquals(mapValueBody(subject), mapValueBody(value)) {
    return true
  }

  return false
}

function runAssignmentBlock(tokens: TokenArena, start: i32, end: i32, variables: string): string {
  let scan = start

  while scan < end do {
    if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "=") {
      let name = tokenValue(tokenArenaGet(tokens, scan))
      let number = evalNumber(tokens, scan + 2, variables)
      let text = intToString(number)
      variables = mapSet(variables, name, "number:" + text)
    }

    scan = scan + 1
  }

  return variables
}

function runSwitch(tokens: TokenArena, index: i32, variables: string): string {
  let subject = readValue(tokens, index + 1, variables)
  let bodyStart = findNext(tokens, index, "{")
  let bodyEnd = findBlockEnd(tokens, index)
  let scan = bodyStart + 1

  while scan < bodyEnd do {
    let current = tokenValue(tokenArenaGet(tokens, scan))

    if stringEquals(current, "case") {
      if switchValueMatches(subject, tokens, scan + 1, variables) {
        let caseStart = findNext(tokens, scan, "{")
        let caseEnd = findBlockEnd(tokens, scan)
        variables = runAssignmentBlock(tokens, caseStart + 1, caseEnd, variables)
        return variables
      }
    }

    if stringEquals(current, "default") {
      let caseStart = findNext(tokens, scan, "{")
      let caseEnd = findBlockEnd(tokens, scan)
      variables = runAssignmentBlock(tokens, caseStart + 1, caseEnd, variables)
      return variables
    }

    scan = scan + 1
  }

  return variables
}

function readEnumInitializer(tokens: TokenArena, index: i32): string {
  let equals = findNext(tokens, index, "=")
  let value = tokenValue(tokenArenaGet(tokens, equals + 1))
  return "enum:" + value
}

function readInitializer(tokens: TokenArena, index: i32, variables: string): string {
  let equals = findNext(tokens, index, "=")
  let kind = tokenKind(tokenArenaGet(tokens, equals + 1))
  let value = tokenValue(tokenArenaGet(tokens, equals + 1))

  if stringEquals(value, "await") {
    let fnName = tokenValue(tokenArenaGet(tokens, equals + 2))
    let number = functionReturnNumber(tokens, fnName)
    let text = intToString(number)
    return "number:" + text
  }

  if stringEquals(value, "match") {
    return readMatchInitializer(tokens, index, variables)
  }

  if stringEquals(value, "[") {
    return readArrayInitializer(tokens, index, variables)
  }

  if stringEquals(kind, "string") {
    return readValue(tokens, equals + 1, variables)
  }

  if stringEquals(tokenValue(tokenArenaGet(tokens, index + 2)), ":") {
    if stringEquals(kind, "identifier") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, index + 3)), "i32") {
        let skipI32 = 1
      } else if stringEquals(tokenValue(tokenArenaGet(tokens, index + 3)), "string") {
        let skipString = 1
      } else {
        return readEnumInitializer(tokens, index)
      }
    }
  }

  if stringEquals(tokenValue(tokenArenaGet(tokens, equals + 2)), "{") {
    return readStructInitializer(tokens, index, variables)
  }

  let number = evalNumber(tokens, equals + 1, variables)
  let text = intToString(number)
  return "number:" + text
}

function expressionKind(tokens: TokenArena, index: i32): string {
  let value = tokenValue(tokenArenaGet(tokens, index))
  let kind = tokenKind(tokenArenaGet(tokens, index))
  let next = tokenValue(tokenArenaGet(tokens, index + 1))

  if stringEquals(next, ".") {
    return "identifier"
  }

  if stringEquals(next, "+") {
    return "binary"
  }

  if stringEquals(next, "*") {
    return "binary"
  }

  if stringEquals(next, "(") {
    return "call"
  }

  if stringEquals(kind, "number") {
    return "number"
  }

  if stringEquals(kind, "string") {
    return "string"
  }

  return "identifier"
}

function expressionValue(tokens: TokenArena, index: i32): string {
  let value = tokenValue(tokenArenaGet(tokens, index))
  let next = tokenValue(tokenArenaGet(tokens, index + 1))

  if stringEquals(next, ".") {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 3)), "+") {
      return "+"
    }

    let field = tokenValue(tokenArenaGet(tokens, index + 2))
    return value + "." + field
  }

  if stringEquals(next, "+") {
    return next
  }

  if stringEquals(next, "*") {
    return next
  }

  return value
}

function expressionLeftValue(tokens: TokenArena, index: i32): string {
  if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), ".") {
    let base = tokenValue(tokenArenaGet(tokens, index))
    let field = tokenValue(tokenArenaGet(tokens, index + 2))
    return base + "." + field
  }

  return tokenValue(tokenArenaGet(tokens, index))
}

function expressionRightValue(tokens: TokenArena, index: i32): string {
  let next = tokenValue(tokenArenaGet(tokens, index + 1))

  if stringEquals(next, ".") {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 3)), "+") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, index + 5)), ".") {
        let base = tokenValue(tokenArenaGet(tokens, index + 4))
        let field = tokenValue(tokenArenaGet(tokens, index + 6))
        return base + "." + field
      }

      return tokenValue(tokenArenaGet(tokens, index + 4))
    }
  }

  if stringEquals(next, "+") {
    return tokenValue(tokenArenaGet(tokens, index + 2))
  }

  if stringEquals(next, "*") {
    return tokenValue(tokenArenaGet(tokens, index + 2))
  }

  if stringEquals(next, "==") {
    return tokenValue(tokenArenaGet(tokens, index + 2))
  }

  return ""
}

function expressionCallArg(tokens: TokenArena, index: i32, offset: i32): string {
  if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), "(") {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index + offset)), ")") {
      return ""
    }

    return tokenValue(tokenArenaGet(tokens, index + offset))
  }

  return ""
}

function expressionCallArgCount(tokens: TokenArena, index: i32): string {
  if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), "(") {
    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 3)), ")") {
      return "1"
    }

    return "2"
  }

  return "0"
}

function parserStatementPrefix(index: i32): string {
  let out = stringBuilder()
  out = stringBuilderAppend(out, "statement")
  out = stringBuilderAppend(out, intToString(index))
  return out
}

function incrementProgramCount(program: string, key: string): string {
  let current = stringToInt(mapGet(program, key))
  return mapSet(program, key, intToString(current + 1))
}

function recordSyntax(program: string, kind: string): string {
  let count = stringToInt(mapGet(program, "syntaxCount"))
  let countText = intToString(count)
  let prefix = "syntax" + countText
  let nextText = intToString(count + 1)
  let kindKey = kind + "Count"

  program = mapSet(program, prefix + "Kind", kind)
  program = mapSet(program, "syntaxCount", nextText)
  program = incrementProgramCount(program, kindKey)

  return program
}

function setStatement(program: string, index: i32, kind: string, name: string, exprKind: string, exprValue: string): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "Kind", kind)
  program = mapSet(program, prefix + "Name", name)
  program = mapSet(program, prefix + "ExprKind", exprKind)
  program = mapSet(program, prefix + "ExprValue", exprValue)
  program = mapSet(program, "statementCount", intToString(index + 1))

  return program
}

function findAfterImport(tokens: TokenArena, index: i32): i32 {
  let fromIndex = findNext(tokens, index, "from")
  return fromIndex + 2
}

function findAfterExtern(tokens: TokenArena, index: i32): i32 {
  let close = findNext(tokens, index, ")")
  if stringEquals(tokenValue(tokenArenaGet(tokens, close + 1)), ":") {
    return close + 3
  }

  return close + 1
}

function isRangeLoop(tokens: TokenArena, index: i32): bool {
  return stringEquals(tokenValue(tokenArenaGet(tokens, index + 2)), "in")
}

function isForOfLoop(tokens: TokenArena, index: i32): bool {
  let scan = index
  let end = findNext(tokens, index, ")")

  while scan < end do {
    if stringEquals(tokenValue(tokenArenaGet(tokens, scan)), "of") {
      return true
    }

    scan = scan + 1
  }

  return false
}

function isMatchInitializer(tokens: TokenArena, index: i32): bool {
  let equals = findNext(tokens, index, "=")
  return stringEquals(tokenValue(tokenArenaGet(tokens, equals + 1)), "match")
}

function setExpressionParts(program: string, index: i32, tokens: TokenArena, exprIndex: i32): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "ExprLeftValue", expressionLeftValue(tokens, exprIndex))
  program = mapSet(program, prefix + "ExprRightValue", expressionRightValue(tokens, exprIndex))
  program = mapSet(program, prefix + "ExprCallArg0", expressionCallArg(tokens, exprIndex, 2))
  program = mapSet(program, prefix + "ExprCallArg1", expressionCallArg(tokens, exprIndex, 4))
  program = mapSet(program, prefix + "ExprCallArgCount", expressionCallArgCount(tokens, exprIndex))

  return program
}

function setResolvedStatement(program: string, index: i32, value: string): string {
  let prefix = parserStatementPrefix(index)

  program = mapSet(program, prefix + "ResolvedKind", mapValueKind(value))
  program = mapSet(program, prefix + "ResolvedValue", mapValueBody(value))

  return program
}

function initializerEnd(tokens: TokenArena, equals: i32): i32 {
  let value = tokenValue(tokenArenaGet(tokens, equals + 1))

  if stringEquals(value, "match") {
    let blockStart = findNext(tokens, equals, "{")
    let blockEnd = findBlockEnd(tokens, blockStart)
    return blockEnd + 1
  }

  if stringEquals(value, "[") {
    let end = findNext(tokens, equals, "]")
    return end + 1
  }

  if stringEquals(tokenValue(tokenArenaGet(tokens, equals + 2)), "{") {
    let blockEnd = findBlockEnd(tokens, equals + 2)
    return blockEnd + 1
  }

  return equals + 2
}

function interpolate(value: string, variables: string): string {
  let out = stringBuilder()
  let index: i32 = 0
  let length = stringLen(value)

  while index < length do {
    let ch = value[index..index + 1]
    if stringEquals(ch, "$") {
      if index + 1 < length {
        if stringEquals(value[index + 1..index + 2], "{") {
          let end = index + 2
          let replaced: bool = false
          while end < length do {
            if stringEquals(value[end..end + 1], "}") {
              let name = value[index + 2..end]
              let resolved = mapGet(variables, name)
              out = stringBuilderAppend(out, mapValueBody(resolved))
              index = end + 1
              replaced = true
              break
            }
            end = end + 1
          }
          if replaced {
            continue
          }
        }
      }
    }

    out = stringBuilderAppend(out, ch)
    index = index + 1
  }

  return out
}

function compareNumbers(left: i32, operator: string, right: i32): bool {
  if stringEquals(operator, "<") {
    return left < right
  }
  if stringEquals(operator, "<=") {
    return left <= right
  }
  if stringEquals(operator, ">") {
    return left > right
  }
  if stringEquals(operator, ">=") {
    return left >= right
  }
  if stringEquals(operator, "==") {
    return left == right
  }
  if stringEquals(operator, "!=") {
    return left != right
  }
  return false
}

function forControlValue(program: string, prefix: string, kind: string): string {
  return mapGet(program, prefix + kind + "Value")
}

function forControlMatches(program: string, prefix: string, kind: string, current: i32): bool {
  let operator = mapGet(program, prefix + kind + "Operator")
  if stringEquals(operator, "") {
    return false
  }

  let right = stringToInt(forControlValue(program, prefix, kind))
  return compareNumbers(current, operator, right)
}

function runFor(program: string, statement: i32, variables: string): string {
  let prefix = parserStatementPrefix(statement)
  let loopName = mapGet(program, prefix + "LoopVariable")
  let assignName = mapGet(program, prefix + "BodyAssignName")
  let addLeft = mapGet(program, prefix + "BodyAddLeft")
  let addRight = mapGet(program, prefix + "BodyAddRight")
  let current = stringToInt(mapGet(program, prefix + "LoopInitialValue"))
  let bound = stringToInt(mapGet(program, prefix + "LoopBoundValue"))
  let compare = mapGet(program, prefix + "LoopCompareOperator")
  let update = stringToInt(mapGet(program, prefix + "LoopUpdateValue"))

  while compareNumbers(current, compare, bound) do {
    variables = mapSet(variables, loopName, "number:" + intToString(current))

    if forControlMatches(program, prefix, "Continue", current) {
      current = current + update
      continue
    }
    if forControlMatches(program, prefix, "Break", current) {
      break
    }

    if !stringEquals(assignName, "") {
      let left = stringToInt(mapValueBody(mapGet(variables, addLeft)))
      let right = stringToInt(mapValueBody(mapGet(variables, addRight)))
      variables = mapSet(variables, assignName, "number:" + intToString(left + right))
    }

    current = current + update
  }

  variables = mapSet(variables, loopName, "number:" + intToString(current))
  return variables
}

function runWhile(tokens: TokenArena, index: i32, variables: string): string {
  let leftName = tokenValue(tokenArenaGet(tokens, index + 1))
  let rightValue = stringToInt(tokenValue(tokenArenaGet(tokens, index + 3)))
  let bodyStart = findNext(tokens, index, "{")
  let bodyEnd = findBlockEnd(tokens, index)
  let scan = bodyStart + 1
  let assignName = ""
  let addRight = ""
  let incrementName = ""

  while scan < bodyEnd do {
    if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "=") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 3)), "+") {
        assignName = tokenValue(tokenArenaGet(tokens, scan))
        addRight = tokenValue(tokenArenaGet(tokens, scan + 4))
      }
    }

    if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "+") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 2)), "+") {
        incrementName = tokenValue(tokenArenaGet(tokens, scan))
      }
    }

    scan = scan + 1
  }

  let currentValue = stringToInt(mapValueBody(mapGet(variables, leftName)))
  let totalValue = stringToInt(mapValueBody(mapGet(variables, assignName)))

  while currentValue < rightValue do {
    if stringEquals(addRight, leftName) {
      totalValue = totalValue + currentValue
    }

    if stringEquals(incrementName, leftName) {
      currentValue = currentValue + 1
    } else {
      currentValue = currentValue + 1
    }
  }

  let currentText = intToString(currentValue)
  let totalText = intToString(totalValue)
  variables = mapSet(variables, leftName, "number:" + currentText)
  variables = mapSet(variables, assignName, "number:" + totalText)

  return variables
}

function setForControl(program: string, prefix: string, kind: string, tokens: TokenArena, index: i32, variables: string): string {
  let operator = tokenValue(tokenArenaGet(tokens, index + 2))
  let valueIndex = index + 3
  if stringEquals(tokenValue(tokenArenaGet(tokens, valueIndex)), "=") {
    operator = operator + "="
    valueIndex = valueIndex + 1
  }

  program = mapSet(program, prefix + kind + "Left", tokenValue(tokenArenaGet(tokens, index + 1)))
  program = mapSet(program, prefix + kind + "Operator", operator)
  program = mapSet(program, prefix + kind + "Value", intToString(evalNumber(tokens, valueIndex, variables)))
  return program
}

function setForStatement(program: string, statement: i32, tokens: TokenArena, index: i32, variables: string): string {
  let prefix = parserStatementPrefix(statement)
  let open = findNext(tokens, index, "(")
  let firstSeparator = findNext(tokens, open, ";")
  let secondSeparator = findNext(tokens, firstSeparator + 1, ";")
  let equals = findNext(tokens, open, "=")
  let loopName = tokenValue(tokenArenaGet(tokens, open + 2))
  let initial = evalNumber(tokens, equals + 1, variables)
  let conditionLeft = tokenValue(tokenArenaGet(tokens, firstSeparator + 1))
  let conditionOperator = tokenValue(tokenArenaGet(tokens, firstSeparator + 2))
  let conditionValueIndex = firstSeparator + 3
  if stringEquals(tokenValue(tokenArenaGet(tokens, conditionValueIndex)), "=") {
    conditionOperator = conditionOperator + "="
    conditionValueIndex = conditionValueIndex + 1
  }
  let conditionRight = evalNumber(tokens, conditionValueIndex, variables)
  let updateValue: i32 = 1
  let bodyStart = findNext(tokens, secondSeparator, "{")
  let bodyEnd = findBlockEnd(tokens, bodyStart)
  let scan = bodyStart + 1

  program = mapSet(program, prefix + "LoopVariable", loopName)
  program = mapSet(program, prefix + "LoopInitialValue", intToString(initial))
  program = mapSet(program, prefix + "LoopCompareLeft", conditionLeft)
  program = mapSet(program, prefix + "LoopCompareOperator", conditionOperator)
  program = mapSet(program, prefix + "LoopBoundValue", intToString(conditionRight))
  program = mapSet(program, prefix + "LoopUpdateValue", intToString(updateValue))

  while scan < bodyEnd do {
    let current = tokenValue(tokenArenaGet(tokens, scan))

    if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "=") {
      if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 3)), "+") {
        program = mapSet(program, prefix + "BodyAssignName", current)
        program = mapSet(program, prefix + "BodyAddLeft", tokenValue(tokenArenaGet(tokens, scan + 2)))
        program = mapSet(program, prefix + "BodyAddRight", tokenValue(tokenArenaGet(tokens, scan + 4)))
      }
    }

    if stringEquals(current, "if") {
      let controlStart = findNext(tokens, scan, "{")
      let controlEnd = findBlockEnd(tokens, controlStart)
      let controlScan = controlStart + 1

      while controlScan < controlEnd do {
        let control = tokenValue(tokenArenaGet(tokens, controlScan))
        if stringEquals(control, "continue") {
          program = setForControl(program, prefix, "Continue", tokens, scan, variables)
        }
        if stringEquals(control, "break") {
          program = setForControl(program, prefix, "Break", tokens, scan, variables)
        }
        controlScan = controlScan + 1
      }

      scan = controlEnd + 1
      continue
    }

    scan = scan + 1
  }

  return program
}

function findBlockEnd(tokens: TokenArena, index: i32): i32 {
  let count = tokens.count
  let depth: i32 = 0
  let seen: bool = false

  while index < count do {
    let value = tokenValue(tokenArenaGet(tokens, index))

    if stringEquals(value, "{") {
      depth = depth + 1
      seen = true
    }

    if stringEquals(value, "}") {
      depth = depth - 1
      if seen {
        if depth == 0 {
          return index
        }
      }
    }

    index = index + 1
  }

  return index
}

function setFunction(program: string, index: i32, tokens: TokenArena, functionIndex: i32): string {
  let slot = intToString(index)
  let prefix = "function" + slot
  let name = tokenValue(tokenArenaGet(tokens, functionIndex + 1))
  let bodyStart = findNext(tokens, functionIndex, "{")
  let returnIndex = findNext(tokens, bodyStart, "return")
  let closeParams = findNext(tokens, functionIndex, ")")
  let paramCount = "1"

  if stringEquals(tokenValue(tokenArenaGet(tokens, functionIndex + 6)), ",") {
    paramCount = "2"
  }

  program = mapSet(program, prefix + "Name", name)
  program = mapSet(program, prefix + "Param0", tokenValue(tokenArenaGet(tokens, functionIndex + 3)))
  program = mapSet(program, prefix + "ParamCount", paramCount)
  if stringEquals(paramCount, "2") {
    program = mapSet(program, prefix + "Param1", tokenValue(tokenArenaGet(tokens, functionIndex + 7)))
  } else {
    program = mapSet(program, prefix + "Param1", "")
  }
  program = mapSet(program, prefix + "ReturnKind", expressionKind(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnValue", expressionValue(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnLeftValue", expressionLeftValue(tokens, returnIndex + 1))
  program = mapSet(program, prefix + "ReturnRightValue", expressionRightValue(tokens, returnIndex + 1))
  program = mapSet(program, "functionCount", intToString(index + 1))

  return program
}

function parseAst(tokens: TokenArena): AstProgram {
  let program = astProgram()
  let variables = map("unused", "unused")
  let index: i32 = 0
  let count = tokens.count

  while index < count do {
    let current = tokenValue(tokenArenaGet(tokens, index))

    if stringEquals(current, "import") {
      program = astRecordSyntax(program, "import")
      index = findAfterImport(tokens, index)
      continue
    }

    if stringEquals(current, "extern") {
      program = astRecordSyntax(program, "extern")
      index = findAfterExtern(tokens, index)
      continue
    }

    if stringEquals(current, "struct") {
      program = astRecordSyntax(program, "struct")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "enum") {
      program = astRecordSyntax(program, "enum")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "async") {
      program = astRecordSyntax(program, "asyncFunction")
      index = index + 1
      continue
    }

    if stringEquals(current, "function") {
      let name = tokenValue(tokenArenaGet(tokens, index + 1))

      if stringEquals(name, "main") {
        let start = findNext(tokens, index, "{")
        index = start + 1
        continue
      }

      program = astRecordFunction(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "let") {
      if isMatchInitializer(tokens, index) {
        program = astRecordSyntax(program, "match")
      }

      let name = tokenValue(tokenArenaGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      program = astRecordStatement(program)
      let equals = findNext(tokens, index, "=")
      index = equals + 2
      continue
    }

    if stringEquals(current, "const") {
      if isMatchInitializer(tokens, index) {
        program = astRecordSyntax(program, "match")
      }

      let name = tokenValue(tokenArenaGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      program = astRecordStatement(program)
      let equals = findNext(tokens, index, "=")
      index = equals + 2
      continue
    }

    if stringEquals(current, "if") {
      program = astRecordSyntax(program, "if")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(tokenArenaGet(tokens, end + 1)), "else") {
        let elseEnd = findBlockEnd(tokens, end + 1)
        index = elseEnd + 1
        continue
      }

      index = end + 1
      continue
    }

    if stringEquals(current, "for") {
      if isRangeLoop(tokens, index) {
        program = astRecordSyntax(program, "forRange")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      if isForOfLoop(tokens, index) {
        program = astRecordSyntax(program, "forOf")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      program = astRecordSyntax(program, "for")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "while") {
      program = astRecordSyntax(program, "while")
      program = astRecordStatement(program)
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "do") {
      program = astRecordSyntax(program, "doUntil")
      let end = findBlockEnd(tokens, index)
      index = end + 2
      continue
    }

    if stringEquals(current, "switch") {
      program = astRecordSyntax(program, "switch")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "try") {
      program = astRecordSyntax(program, "tryCatch")
      let tryEnd = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(tokenArenaGet(tokens, tryEnd + 1)), "catch") {
        let catchEnd = findBlockEnd(tokens, tryEnd + 1)
        index = catchEnd + 1
        continue
      }

      index = tryEnd + 1
      continue
    }

    if stringEquals(current, "throw") {
      program = astRecordSyntax(program, "throw")
      index = index + 1
      continue
    }

    if stringEquals(current, "defer") {
      program = astRecordSyntax(program, "defer")
      index = index + 1
      continue
    }

    if stringEquals(current, "break") {
      program = astRecordSyntax(program, "break")
      index = index + 1
      continue
    }

    if stringEquals(current, "continue") {
      program = astRecordSyntax(program, "continue")
      index = index + 1
      continue
    }

    if stringEquals(current, "println") {
      program = astRecordStatement(program)
      index = index + 1
      continue
    }

    if stringEquals(current, "return") {
      let value = readValue(tokens, index + 1, variables)
      program = astRecordReturn(program, mapValueKind(value), mapValueBody(value))
      index = index + 1
      continue
    }

    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), "=") {
      let number = evalNumber(tokens, index + 2, variables)
      let text = intToString(number)
      let value = "number:" + text
      variables = mapSet(variables, current, value)
      index = index + 1
      continue
    }

    index = index + 1
  }

  return program
}

function parseProgram(tokens: TokenArena): string {
  let ast = parseAst(tokens)
  let program = map("kind", "program", "mainReturnKind", "number", "mainReturnValue", "0", "printCount", "0", "statementCount", "0", "functionCount", "0", "syntaxCount", "0")
  let variables = map("unused", "unused")
  let index: i32 = 0
  let count = tokens.count
  let prints: i32 = 0
  let statements: i32 = 0
  let functions: i32 = 0

  while index < count do {
    let current = tokenValue(tokenArenaGet(tokens, index))

    if stringEquals(current, "import") {
      program = recordSyntax(program, "import")
      index = findAfterImport(tokens, index)
      continue
    }

    if stringEquals(current, "extern") {
      program = recordSyntax(program, "extern")
      index = findAfterExtern(tokens, index)
      continue
    }

    if stringEquals(current, "struct") {
      program = recordSyntax(program, "struct")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "enum") {
      program = recordSyntax(program, "enum")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "async") {
      program = recordSyntax(program, "asyncFunction")
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "function") {
      let name = tokenValue(tokenArenaGet(tokens, index + 1))
      if stringEquals(name, "compileTiny") {
        program = mapSet(program, "mode", "compiler-main")
      }

      if stringEquals(name, "main") {
        let start = findNext(tokens, index, "{")
        index = start + 1
        continue
      }

      program = setFunction(program, functions, tokens, index)
      functions = functions + 1
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "let") {
      if isMatchInitializer(tokens, index) {
        program = recordSyntax(program, "match")
      }

      let name = tokenValue(tokenArenaGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      let equals = findNext(tokens, index, "=")
      program = setStatement(program, statements, "let", name, expressionKind(tokens, equals + 1), expressionValue(tokens, equals + 1))
      program = setExpressionParts(program, statements, tokens, equals + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      index = initializerEnd(tokens, equals)
      continue
    }

    if stringEquals(current, "const") {
      if isMatchInitializer(tokens, index) {
        program = recordSyntax(program, "match")
      }

      let name = tokenValue(tokenArenaGet(tokens, index + 1))
      let value = readInitializer(tokens, index, variables)
      variables = mapSet(variables, name, value)
      let equals = findNext(tokens, index, "=")
      program = setStatement(program, statements, "const", name, expressionKind(tokens, equals + 1), expressionValue(tokens, equals + 1))
      program = setExpressionParts(program, statements, tokens, equals + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      index = initializerEnd(tokens, equals)
      continue
    }

    if stringEquals(current, "if") {
      program = recordSyntax(program, "if")
      program = setStatement(program, statements, "if", "", "compare", "==")
      let prefix = parserStatementPrefix(statements)
      program = mapSet(program, prefix + "ExprLeftValue", tokenValue(tokenArenaGet(tokens, index + 1)))
      program = mapSet(program, prefix + "ExprRightValue", tokenValue(tokenArenaGet(tokens, index + 4)))

      let bodyStart = findNext(tokens, index, "{")
      let bodyValue = readValue(tokens, bodyStart + 3, variables)
      let bodyKind = mapValueKind(bodyValue)
      let bodyText = interpolate(mapValueBody(bodyValue), variables)
      program = mapSet(program, prefix + "BodyKind", "println")
      program = mapSet(program, prefix + "BodyExprKind", bodyKind)
      program = mapSet(program, prefix + "BodyExprValue", bodyText)
      if prints == 0 {
        program = mapSet(program, "print0Kind", bodyKind)
        program = mapSet(program, "print0Value", bodyText)
      }
      prints = prints + 1

      statements = statements + 1
      let end = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(tokenArenaGet(tokens, end + 1)), "else") {
        let elseEnd = findBlockEnd(tokens, end + 1)
        index = elseEnd + 1
        continue
      }
      index = end + 1
      continue
    }

    if stringEquals(current, "for") {
      if isRangeLoop(tokens, index) {
        program = recordSyntax(program, "forRange")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      if isForOfLoop(tokens, index) {
        program = recordSyntax(program, "forOf")
        let end = findBlockEnd(tokens, index)
        index = end + 1
        continue
      }

      program = recordSyntax(program, "for")
      program = setStatement(program, statements, "for", "", "loop", "classic")
      program = setForStatement(program, statements, tokens, index, variables)
      variables = runFor(program, statements, variables)
      statements = statements + 1
      let end = findBlockEnd(tokens, index)
      index = end + 1
      continue
    }

    if stringEquals(current, "while") {
      program = recordSyntax(program, "while")
      program = setStatement(program, statements, "while", "", "compare", tokenValue(tokenArenaGet(tokens, index + 2)))
      let prefix = parserStatementPrefix(statements)
      program = mapSet(program, prefix + "ExprLeftValue", tokenValue(tokenArenaGet(tokens, index + 1)))
      program = mapSet(program, prefix + "ExprRightValue", tokenValue(tokenArenaGet(tokens, index + 3)))

      let bodyStart = findNext(tokens, index, "{")
      let bodyEnd = findBlockEnd(tokens, index)
      let scan = bodyStart + 1

      while scan < bodyEnd do {
        if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "=") {
          if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 3)), "+") {
            program = mapSet(program, prefix + "BodyAssignName", tokenValue(tokenArenaGet(tokens, scan)))
            program = mapSet(program, prefix + "BodyAddLeft", tokenValue(tokenArenaGet(tokens, scan + 2)))
            program = mapSet(program, prefix + "BodyAddRight", tokenValue(tokenArenaGet(tokens, scan + 4)))
          }
        }

        if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "+") {
          if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 2)), "+") {
            program = mapSet(program, prefix + "BodyIncrementName", tokenValue(tokenArenaGet(tokens, scan)))
          }
        }

        scan = scan + 1
      }

      statements = statements + 1
      variables = runWhile(tokens, index, variables)
      index = bodyEnd + 1
      continue
    }

    if stringEquals(current, "do") {
      program = recordSyntax(program, "doUntil")
      let end = findBlockEnd(tokens, index)
      index = end + 2
      continue
    }

    if stringEquals(current, "switch") {
      program = recordSyntax(program, "switch")
      let end = findBlockEnd(tokens, index)
      variables = runSwitch(tokens, index, variables)
      let switchScan = findNext(tokens, index, "{") + 1
      while switchScan < end do {
        if stringEquals(tokenValue(tokenArenaGet(tokens, switchScan + 1)), "=") {
          let assignedName = tokenValue(tokenArenaGet(tokens, switchScan))
          let assignedValue = mapGet(variables, assignedName)
          program = setStatement(program, statements, "assign", assignedName, mapValueKind(assignedValue), mapValueBody(assignedValue))
          program = setResolvedStatement(program, statements, assignedValue)
          statements = statements + 1
          switchScan = end
          continue
        }
        switchScan = switchScan + 1
      }
      index = end + 1
      continue
    }

    if stringEquals(current, "try") {
      program = recordSyntax(program, "tryCatch")
      let tryEnd = findBlockEnd(tokens, index)
      if stringEquals(tokenValue(tokenArenaGet(tokens, tryEnd + 1)), "catch") {
        let catchEnd = findBlockEnd(tokens, tryEnd + 1)
        let throwIndex = findNext(tokens, index, "throw")
        let thrown = readValue(tokens, throwIndex + 1, variables)
        let catchStart = findNext(tokens, tryEnd + 1, "{")
        let scan = catchStart + 1

        while scan < catchEnd do {
          if stringEquals(tokenValue(tokenArenaGet(tokens, scan)), "println") {
            let argName = tokenValue(tokenArenaGet(tokens, scan + 2))
            if stringEquals(argName, tokenValue(tokenArenaGet(tokens, tryEnd + 2))) {
              program = setStatement(program, statements, "println", "", "string", mapValueBody(thrown))
              program = setResolvedStatement(program, statements, thrown)
              statements = statements + 1

              if prints == 0 {
                program = mapSet(program, "print0Kind", mapValueKind(thrown))
                program = mapSet(program, "print0Value", mapValueBody(thrown))
              }

              if prints == 1 {
                program = mapSet(program, "print1Kind", mapValueKind(thrown))
                program = mapSet(program, "print1Value", mapValueBody(thrown))
              }

              prints = prints + 1
            }
          }

          if stringEquals(tokenValue(tokenArenaGet(tokens, scan + 1)), "=") {
            let number = evalNumber(tokens, scan + 2, variables)
            let text = intToString(number)
            let name = tokenValue(tokenArenaGet(tokens, scan))
            let assigned = "number:" + text
            variables = mapSet(variables, name, assigned)
            program = setStatement(program, statements, "assign", name, "number", text)
            program = setResolvedStatement(program, statements, assigned)
            statements = statements + 1
          }

          scan = scan + 1
        }

        index = catchEnd + 1
        continue
      }

      index = tryEnd + 1
      continue
    }

    if stringEquals(current, "throw") {
      program = recordSyntax(program, "throw")
      index = index + 1
      continue
    }

    if stringEquals(current, "defer") {
      program = recordSyntax(program, "defer")
      index = index + 1
      continue
    }

    if stringEquals(current, "break") {
      program = recordSyntax(program, "break")
      index = index + 1
      continue
    }

    if stringEquals(current, "continue") {
      program = recordSyntax(program, "continue")
      index = index + 1
      continue
    }

    if stringEquals(tokenValue(tokenArenaGet(tokens, index + 1)), "=") {
      let number = evalNumber(tokens, index + 2, variables)
      let text = intToString(number)
      let value = "number:" + text
      variables = mapSet(variables, current, value)
      index = index + 1
      continue
    }

    if stringEquals(current, "println") {
      let value = readValue(tokens, index + 2, variables)
      let kind = mapValueKind(value)
      let body = interpolate(mapValueBody(value), variables)
      program = setStatement(program, statements, "println", "", expressionKind(tokens, index + 2), expressionValue(tokens, index + 2))
      program = setExpressionParts(program, statements, tokens, index + 2)
      if includes(kind, "string") {
        program = setResolvedStatement(program, statements, "string:" + body)
      } else {
        program = setResolvedStatement(program, statements, value)
      }
      statements = statements + 1

      if prints == 0 {
        program = mapSet(program, "print0Kind", kind)
        program = mapSet(program, "print0Value", body)
      }

      if prints == 1 {
        program = mapSet(program, "print1Kind", kind)
        program = mapSet(program, "print1Value", body)
      }

      if prints == 2 {
        program = mapSet(program, "print2Kind", kind)
        program = mapSet(program, "print2Value", body)
      }

      prints = prints + 1
      index = index + 1
      continue
    }

    if stringEquals(current, "return") {
      let value = readValue(tokens, index + 1, variables)
      program = setStatement(program, statements, "return", "", expressionKind(tokens, index + 1), expressionValue(tokens, index + 1))
      program = setExpressionParts(program, statements, tokens, index + 1)
      program = setResolvedStatement(program, statements, value)
      statements = statements + 1
      program = mapSet(program, "mainReturnKind", mapValueKind(value))
      program = mapSet(program, "mainReturnValue", mapValueBody(value))
      index = index + 1
      continue
    }

    index = index + 1
  }

  return program
}
