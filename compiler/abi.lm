function compilerAbiParameter(signature: CompilerAbiSignature, index: i32): string {
  if signature.variadic && index >= signature.parameterCount {
    return signature.parameter0
  }
  if index == 0 { return signature.parameter0
  }
  if index == 1 { return signature.parameter1
  }
  if index == 2 { return signature.parameter2
  }
  if index == 3 { return signature.parameter3
  }
  if index >= 4 && stringEquals(signature.name, "serveHttp") {
    return "string[]"
  }
  return ""
}

function compilerAbiDeclaration(signature: CompilerAbiSignature): string {
  if !signature.found || stringEquals(signature.symbol, "") {
    return ""
  }
  return "declare " + signature.llvmReturnType + " @" + signature.symbol +
    "(" + signature.llvmParameters + ")
"
}

function compilerAbiAppendDeclaration(out: string, name: string): string {
  return stringBuilderAppend(out, compilerAbiDeclaration(compilerAbiSignature(name)))
}

