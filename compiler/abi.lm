struct CompilerAbiSignature {
  found: bool
  name: string
  symbol: string
  returnType: string
  parameter0: string
  parameter1: string
  parameter2: string
  parameter3: string
  parameterCount: i32
  minArity: i32
  maxArity: i32
  variadic: bool
  llvmReturnType: string
  llvmParameters: string
  runtimeUnit: string
}

function compilerAbi(
  name: string,
  symbol: string,
  returnType: string,
  parameter0: string,
  parameter1: string,
  parameter2: string,
  parameter3: string,
  parameterCount: i32,
  minArity: i32,
  maxArity: i32,
  variadic: bool,
  llvmReturnType: string,
  llvmParameters: string,
  runtimeUnit: string
): CompilerAbiSignature {
  return CompilerAbiSignature {
    found: true,
    name: name,
    symbol: symbol,
    returnType: returnType,
    parameter0: parameter0,
    parameter1: parameter1,
    parameter2: parameter2,
    parameter3: parameter3,
    parameterCount: parameterCount,
    minArity: minArity,
    maxArity: maxArity,
    variadic: variadic,
    llvmReturnType: llvmReturnType,
    llvmParameters: llvmParameters,
    runtimeUnit: runtimeUnit
  }
}

function compilerAbiMissing(name: string): CompilerAbiSignature {
  let signature = compilerAbi(name, "", "unknown", "", "", "", "", 0, 0, 0, false, "", "", "")
  signature.found = false
  return signature
}

