struct CompilerToken {
  kind: string
  lexeme: string
  literal: string
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
}

struct CompilerAstNode {
  kind: string
  parent: i32
  firstChild: i32
  childCount: i32
  tokenStart: i32
  tokenEnd: i32
  typeId: i32
  symbolId: i32
  text: string
  name: string
  value: string
  operator: string
  typeName: string
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
  flags: i32
}

struct CompilerType {
  kind: string
  name: string
  elementType: i32
  nullable: i32
}

struct CompilerSymbol {
  kind: string
  name: string
  typeId: i32
  scopeId: i32
  declarationId: i32
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
}

struct CompilerIrValue {
  kind: string
  typeId: i32
  operand0: i32
  operand1: i32
  text: string
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
}

struct CompilerIrBlock {
  name: string
  firstValue: i32
  valueCount: i32
  terminator: string
  target0: i32
  target1: i32
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
}

struct CompilerIrFunction {
  name: string
  firstBlock: i32
  blockCount: i32
  returnTypeId: i32
  file: string
  offset: i32
  line: i32
  column: i32
  endOffset: i32
  endLine: i32
  endColumn: i32
}

struct CompilerDiagnostic {
  severity: string
  message: string
  file: string
  offset: i32
  line: i32
  column: i32
  length: i32
}

struct AstArena {
  storage: string
  count: i32
}

struct TypeArena {
  storage: string
  count: i32
}

struct SymbolArena {
  storage: string
  count: i32
}

struct IrValueArena {
  storage: string
  count: i32
}

struct IrBlockArena {
  storage: string
  count: i32
}

struct IrFunctionArena {
  storage: string
  count: i32
}

struct DiagnosticArena {
  storage: string
  count: i32
}

struct TokenArena {
  storage: string
  count: i32
  ok: bool
  diagnostics: DiagnosticArena
}

struct CompilerContainers {
  tokens: TokenArena
  ast: AstArena
  types: TypeArena
  symbols: SymbolArena
  values: IrValueArena
  blocks: IrBlockArena
  functions: IrFunctionArena
  diagnostics: DiagnosticArena
}

function tokenArena(): TokenArena {
  return TokenArena {
    storage: arenaNew(),
    count: 0,
    ok: true,
    diagnostics: diagnosticArena()
  }
}

function tokenArenaPush(arena: TokenArena, token: CompilerToken): TokenArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, token.kind)
  arenaSetString(arena.storage, index, 1, token.lexeme)
  arenaSetString(arena.storage, index, 2, token.literal)
  arenaSetString(arena.storage, index, 3, token.file)
  arenaSetI32(arena.storage, index, 4, token.offset)
  arenaSetI32(arena.storage, index, 5, token.line)
  arenaSetI32(arena.storage, index, 6, token.column)
  arenaSetI32(arena.storage, index, 7, token.endOffset)
  arenaSetI32(arena.storage, index, 8, token.endLine)
  arenaSetI32(arena.storage, index, 9, token.endColumn)
  arena.count = arenaLen(arena.storage)
  return arena
}

function tokenArenaGet(arena: TokenArena, index: i32): CompilerToken {
  return CompilerToken {
    kind: arenaGetString(arena.storage, index, 0),
    lexeme: arenaGetString(arena.storage, index, 1),
    literal: arenaGetString(arena.storage, index, 2),
    file: arenaGetString(arena.storage, index, 3),
    offset: arenaGetI32(arena.storage, index, 4),
    line: arenaGetI32(arena.storage, index, 5),
    column: arenaGetI32(arena.storage, index, 6),
    endOffset: arenaGetI32(arena.storage, index, 7),
    endLine: arenaGetI32(arena.storage, index, 8),
    endColumn: arenaGetI32(arena.storage, index, 9)
  }
}

function astArena(): AstArena {
  return AstArena {
    storage: arenaNew(),
    count: 0
  }
}

function astArenaPush(arena: AstArena, node: CompilerAstNode): AstArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, node.kind)
  arenaSetI32(arena.storage, index, 1, node.parent)
  arenaSetI32(arena.storage, index, 2, node.firstChild)
  arenaSetI32(arena.storage, index, 3, node.childCount)
  arenaSetI32(arena.storage, index, 4, node.tokenStart)
  arenaSetI32(arena.storage, index, 5, node.tokenEnd)
  arenaSetI32(arena.storage, index, 6, node.typeId)
  arenaSetI32(arena.storage, index, 20, node.symbolId)
  arenaSetString(arena.storage, index, 7, node.text)
  arenaSetString(arena.storage, index, 8, node.name)
  arenaSetString(arena.storage, index, 9, node.value)
  arenaSetString(arena.storage, index, 10, node.operator)
  arenaSetString(arena.storage, index, 11, node.typeName)
  arenaSetString(arena.storage, index, 12, node.file)
  arenaSetI32(arena.storage, index, 13, node.offset)
  arenaSetI32(arena.storage, index, 14, node.line)
  arenaSetI32(arena.storage, index, 15, node.column)
  arenaSetI32(arena.storage, index, 16, node.endOffset)
  arenaSetI32(arena.storage, index, 17, node.endLine)
  arenaSetI32(arena.storage, index, 18, node.endColumn)
  arenaSetI32(arena.storage, index, 19, node.flags)
  arena.count = arenaLen(arena.storage)
  return arena
}

function astArenaSet(arena: AstArena, index: i32, node: CompilerAstNode): AstArena {
  arenaSetString(arena.storage, index, 0, node.kind)
  arenaSetI32(arena.storage, index, 1, node.parent)
  arenaSetI32(arena.storage, index, 2, node.firstChild)
  arenaSetI32(arena.storage, index, 3, node.childCount)
  arenaSetI32(arena.storage, index, 4, node.tokenStart)
  arenaSetI32(arena.storage, index, 5, node.tokenEnd)
  arenaSetI32(arena.storage, index, 6, node.typeId)
  arenaSetI32(arena.storage, index, 20, node.symbolId)
  arenaSetString(arena.storage, index, 7, node.text)
  arenaSetString(arena.storage, index, 8, node.name)
  arenaSetString(arena.storage, index, 9, node.value)
  arenaSetString(arena.storage, index, 10, node.operator)
  arenaSetString(arena.storage, index, 11, node.typeName)
  arenaSetString(arena.storage, index, 12, node.file)
  arenaSetI32(arena.storage, index, 13, node.offset)
  arenaSetI32(arena.storage, index, 14, node.line)
  arenaSetI32(arena.storage, index, 15, node.column)
  arenaSetI32(arena.storage, index, 16, node.endOffset)
  arenaSetI32(arena.storage, index, 17, node.endLine)
  arenaSetI32(arena.storage, index, 18, node.endColumn)
  arenaSetI32(arena.storage, index, 19, node.flags)
  return arena
}

function astArenaGet(arena: AstArena, index: i32): CompilerAstNode {
  return CompilerAstNode {
    kind: arenaGetString(arena.storage, index, 0),
    parent: arenaGetI32(arena.storage, index, 1),
    firstChild: arenaGetI32(arena.storage, index, 2),
    childCount: arenaGetI32(arena.storage, index, 3),
    tokenStart: arenaGetI32(arena.storage, index, 4),
    tokenEnd: arenaGetI32(arena.storage, index, 5),
    typeId: arenaGetI32(arena.storage, index, 6),
    symbolId: arenaGetI32(arena.storage, index, 20),
    text: arenaGetString(arena.storage, index, 7),
    name: arenaGetString(arena.storage, index, 8),
    value: arenaGetString(arena.storage, index, 9),
    operator: arenaGetString(arena.storage, index, 10),
    typeName: arenaGetString(arena.storage, index, 11),
    file: arenaGetString(arena.storage, index, 12),
    offset: arenaGetI32(arena.storage, index, 13),
    line: arenaGetI32(arena.storage, index, 14),
    column: arenaGetI32(arena.storage, index, 15),
    endOffset: arenaGetI32(arena.storage, index, 16),
    endLine: arenaGetI32(arena.storage, index, 17),
    endColumn: arenaGetI32(arena.storage, index, 18),
    flags: arenaGetI32(arena.storage, index, 19)
  }
}

function typeArena(): TypeArena {
  return TypeArena {
    storage: arenaNew(),
    count: 0
  }
}

function typeArenaPush(arena: TypeArena, compilerType: CompilerType): TypeArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, compilerType.kind)
  arenaSetString(arena.storage, index, 1, compilerType.name)
  arenaSetI32(arena.storage, index, 2, compilerType.elementType)
  arenaSetI32(arena.storage, index, 3, compilerType.nullable)
  arena.count = arenaLen(arena.storage)
  return arena
}

function typeArenaGet(arena: TypeArena, index: i32): CompilerType {
  return CompilerType {
    kind: arenaGetString(arena.storage, index, 0),
    name: arenaGetString(arena.storage, index, 1),
    elementType: arenaGetI32(arena.storage, index, 2),
    nullable: arenaGetI32(arena.storage, index, 3)
  }
}

function symbolArena(): SymbolArena {
  return SymbolArena {
    storage: arenaNew(),
    count: 0
  }
}

function symbolArenaPush(arena: SymbolArena, symbol: CompilerSymbol): SymbolArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, symbol.kind)
  arenaSetString(arena.storage, index, 1, symbol.name)
  arenaSetI32(arena.storage, index, 2, symbol.typeId)
  arenaSetI32(arena.storage, index, 3, symbol.scopeId)
  arenaSetI32(arena.storage, index, 4, symbol.declarationId)
  arenaSetString(arena.storage, index, 5, symbol.file)
  arenaSetI32(arena.storage, index, 6, symbol.offset)
  arenaSetI32(arena.storage, index, 7, symbol.line)
  arenaSetI32(arena.storage, index, 8, symbol.column)
  arenaSetI32(arena.storage, index, 9, symbol.endOffset)
  arenaSetI32(arena.storage, index, 10, symbol.endLine)
  arenaSetI32(arena.storage, index, 11, symbol.endColumn)
  arena.count = arenaLen(arena.storage)
  return arena
}

function symbolArenaGet(arena: SymbolArena, index: i32): CompilerSymbol {
  return CompilerSymbol {
    kind: arenaGetString(arena.storage, index, 0),
    name: arenaGetString(arena.storage, index, 1),
    typeId: arenaGetI32(arena.storage, index, 2),
    scopeId: arenaGetI32(arena.storage, index, 3),
    declarationId: arenaGetI32(arena.storage, index, 4),
    file: arenaGetString(arena.storage, index, 5),
    offset: arenaGetI32(arena.storage, index, 6),
    line: arenaGetI32(arena.storage, index, 7),
    column: arenaGetI32(arena.storage, index, 8),
    endOffset: arenaGetI32(arena.storage, index, 9),
    endLine: arenaGetI32(arena.storage, index, 10),
    endColumn: arenaGetI32(arena.storage, index, 11)
  }
}

function irValueArena(): IrValueArena {
  return IrValueArena {
    storage: arenaNew(),
    count: 0
  }
}

function irValueArenaPush(arena: IrValueArena, value: CompilerIrValue): IrValueArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, value.kind)
  arenaSetI32(arena.storage, index, 1, value.typeId)
  arenaSetI32(arena.storage, index, 2, value.operand0)
  arenaSetI32(arena.storage, index, 3, value.operand1)
  arenaSetString(arena.storage, index, 4, value.text)
  arenaSetString(arena.storage, index, 5, value.file)
  arenaSetI32(arena.storage, index, 6, value.offset)
  arenaSetI32(arena.storage, index, 7, value.line)
  arenaSetI32(arena.storage, index, 8, value.column)
  arenaSetI32(arena.storage, index, 9, value.endOffset)
  arenaSetI32(arena.storage, index, 10, value.endLine)
  arenaSetI32(arena.storage, index, 11, value.endColumn)
  arena.count = arenaLen(arena.storage)
  return arena
}

function irValueArenaGet(arena: IrValueArena, index: i32): CompilerIrValue {
  return CompilerIrValue {
    kind: arenaGetString(arena.storage, index, 0),
    typeId: arenaGetI32(arena.storage, index, 1),
    operand0: arenaGetI32(arena.storage, index, 2),
    operand1: arenaGetI32(arena.storage, index, 3),
    text: arenaGetString(arena.storage, index, 4),
    file: arenaGetString(arena.storage, index, 5),
    offset: arenaGetI32(arena.storage, index, 6),
    line: arenaGetI32(arena.storage, index, 7),
    column: arenaGetI32(arena.storage, index, 8),
    endOffset: arenaGetI32(arena.storage, index, 9),
    endLine: arenaGetI32(arena.storage, index, 10),
    endColumn: arenaGetI32(arena.storage, index, 11)
  }
}

function irBlockArena(): IrBlockArena {
  return IrBlockArena {
    storage: arenaNew(),
    count: 0
  }
}

function irBlockArenaPush(arena: IrBlockArena, block: CompilerIrBlock): IrBlockArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, block.name)
  arenaSetI32(arena.storage, index, 1, block.firstValue)
  arenaSetI32(arena.storage, index, 2, block.valueCount)
  arenaSetString(arena.storage, index, 3, block.terminator)
  arenaSetI32(arena.storage, index, 4, block.target0)
  arenaSetI32(arena.storage, index, 5, block.target1)
  arenaSetString(arena.storage, index, 6, block.file)
  arenaSetI32(arena.storage, index, 7, block.offset)
  arenaSetI32(arena.storage, index, 8, block.line)
  arenaSetI32(arena.storage, index, 9, block.column)
  arenaSetI32(arena.storage, index, 10, block.endOffset)
  arenaSetI32(arena.storage, index, 11, block.endLine)
  arenaSetI32(arena.storage, index, 12, block.endColumn)
  arena.count = arenaLen(arena.storage)
  return arena
}

function irBlockArenaGet(arena: IrBlockArena, index: i32): CompilerIrBlock {
  return CompilerIrBlock {
    name: arenaGetString(arena.storage, index, 0),
    firstValue: arenaGetI32(arena.storage, index, 1),
    valueCount: arenaGetI32(arena.storage, index, 2),
    terminator: arenaGetString(arena.storage, index, 3),
    target0: arenaGetI32(arena.storage, index, 4),
    target1: arenaGetI32(arena.storage, index, 5),
    file: arenaGetString(arena.storage, index, 6),
    offset: arenaGetI32(arena.storage, index, 7),
    line: arenaGetI32(arena.storage, index, 8),
    column: arenaGetI32(arena.storage, index, 9),
    endOffset: arenaGetI32(arena.storage, index, 10),
    endLine: arenaGetI32(arena.storage, index, 11),
    endColumn: arenaGetI32(arena.storage, index, 12)
  }
}

function irFunctionArena(): IrFunctionArena {
  return IrFunctionArena {
    storage: arenaNew(),
    count: 0
  }
}

function irFunctionArenaPush(arena: IrFunctionArena, fn: CompilerIrFunction): IrFunctionArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, fn.name)
  arenaSetI32(arena.storage, index, 1, fn.firstBlock)
  arenaSetI32(arena.storage, index, 2, fn.blockCount)
  arenaSetI32(arena.storage, index, 3, fn.returnTypeId)
  arenaSetString(arena.storage, index, 4, fn.file)
  arenaSetI32(arena.storage, index, 5, fn.offset)
  arenaSetI32(arena.storage, index, 6, fn.line)
  arenaSetI32(arena.storage, index, 7, fn.column)
  arenaSetI32(arena.storage, index, 8, fn.endOffset)
  arenaSetI32(arena.storage, index, 9, fn.endLine)
  arenaSetI32(arena.storage, index, 10, fn.endColumn)
  arena.count = arenaLen(arena.storage)
  return arena
}

function irFunctionArenaGet(arena: IrFunctionArena, index: i32): CompilerIrFunction {
  return CompilerIrFunction {
    name: arenaGetString(arena.storage, index, 0),
    firstBlock: arenaGetI32(arena.storage, index, 1),
    blockCount: arenaGetI32(arena.storage, index, 2),
    returnTypeId: arenaGetI32(arena.storage, index, 3),
    file: arenaGetString(arena.storage, index, 4),
    offset: arenaGetI32(arena.storage, index, 5),
    line: arenaGetI32(arena.storage, index, 6),
    column: arenaGetI32(arena.storage, index, 7),
    endOffset: arenaGetI32(arena.storage, index, 8),
    endLine: arenaGetI32(arena.storage, index, 9),
    endColumn: arenaGetI32(arena.storage, index, 10)
  }
}

function diagnosticArena(): DiagnosticArena {
  return DiagnosticArena {
    storage: arenaNew(),
    count: 0
  }
}

function diagnosticArenaPush(arena: DiagnosticArena, diagnostic: CompilerDiagnostic): DiagnosticArena {
  let index = arenaAppend(arena.storage)
  arenaSetString(arena.storage, index, 0, diagnostic.severity)
  arenaSetString(arena.storage, index, 1, diagnostic.message)
  arenaSetString(arena.storage, index, 2, diagnostic.file)
  arenaSetI32(arena.storage, index, 3, diagnostic.offset)
  arenaSetI32(arena.storage, index, 4, diagnostic.line)
  arenaSetI32(arena.storage, index, 5, diagnostic.column)
  arenaSetI32(arena.storage, index, 6, diagnostic.length)
  arena.count = arenaLen(arena.storage)
  return arena
}

function diagnosticArenaGet(arena: DiagnosticArena, index: i32): CompilerDiagnostic {
  return CompilerDiagnostic {
    severity: arenaGetString(arena.storage, index, 0),
    message: arenaGetString(arena.storage, index, 1),
    file: arenaGetString(arena.storage, index, 2),
    offset: arenaGetI32(arena.storage, index, 3),
    line: arenaGetI32(arena.storage, index, 4),
    column: arenaGetI32(arena.storage, index, 5),
    length: arenaGetI32(arena.storage, index, 6)
  }
}

function compilerContainers(): CompilerContainers {
  return CompilerContainers {
    tokens: tokenArena(),
    ast: astArena(),
    types: typeArena(),
    symbols: symbolArena(),
    values: irValueArena(),
    blocks: irBlockArena(),
    functions: irFunctionArena(),
    diagnostics: diagnosticArena()
  }
}
