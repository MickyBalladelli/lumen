import { AstProgram } from "./ast.lm"
import { CompilerToken, TokenArena, tokenArenaGet } from "./containers.lm"

struct SemanticResult {
  ok: bool
  message: string
  symbolCount: i32
  tokenIndex: i32
}

function semanticOk(symbolCount: i32): SemanticResult {
  let result = SemanticResult {
    ok: true,
    message: "",
    symbolCount: symbolCount,
    tokenIndex: 0
  }

  return result
}

function semanticError(message: string, symbolCount: i32, tokenIndex: i32): SemanticResult {
  let result = SemanticResult {
    ok: false,
    message: message,
    symbolCount: symbolCount,
    tokenIndex: tokenIndex
  }

  return result
}

function semanticTokenValue(token: CompilerToken): string {
  if stringEquals(token.kind, "string") {
    return token.literal
  }

  return token.lexeme
}

function semanticTokenKind(token: CompilerToken): string {
  return token.kind
}

function semanticFindNext(tokens: TokenArena, index: i32, wanted: string): i32 {
  let count = tokens.count

  while index < count do {
    if stringEquals(semanticTokenValue(tokenArenaGet(tokens, index)), wanted) {
      return index
    }

    index = index + 1
  }

  return index
}

function semanticFindBlockEnd(tokens: TokenArena, index: i32): i32 {
  let count = tokens.count
  let depth: i32 = 0
  let seen: bool = false

  while index < count do {
    let value = semanticTokenValue(tokenArenaGet(tokens, index))

    if stringEquals(value, "{") {
      depth = depth + 1
      seen = true
    }

    if stringEquals(value, "}") {
      depth = depth - 1
      if seen {
        if depth == 0 {
          return index
        }
      }
    }

    index = index + 1
  }

  return index
}

function semanticBlockContains(tokens: TokenArena, blockStart: i32, target: i32): bool {
  let bodyStart = semanticFindNext(tokens, blockStart, "{")
  let bodyEnd = semanticFindBlockEnd(tokens, blockStart)

  if target > bodyStart {
    if target < bodyEnd {
      return true
    }
  }

  return false
}

function semanticIsInLoop(tokens: TokenArena, target: i32): bool {
  let index: i32 = 0
  let count = tokens.count

  while index < target do {
    let current = semanticTokenValue(tokenArenaGet(tokens, index))

    if stringEquals(current, "for") {
      if semanticBlockContains(tokens, index, target) {
        return true
      }
    }

    if stringEquals(current, "while") {
      if semanticBlockContains(tokens, index, target) {
        return true
      }
    }

    if stringEquals(current, "do") {
      if semanticBlockContains(tokens, index, target) {
        return true
      }
    }

    index = index + 1
  }

  return false
}

function semanticIsInSwitch(tokens: TokenArena, target: i32): bool {
  let index: i32 = 0
  let count = tokens.count

  while index < target do {
    let current = semanticTokenValue(tokenArenaGet(tokens, index))

    if stringEquals(current, "switch") {
      if semanticBlockContains(tokens, index, target) {
        return true
      }
    }

    index = index + 1
  }

  return false
}

function semanticHasPriorLoop(tokens: TokenArena, target: i32): bool {
  let index = target - 1

  while index > 0 do {
    let current = semanticTokenValue(tokenArenaGet(tokens, index))

    if stringEquals(current, "function") {
      return false
    }

    if stringEquals(current, "for") {
      return true
    }

    if stringEquals(current, "while") {
      return true
    }

    if stringEquals(current, "do") {
      return true
    }

    index = index - 1
  }

  return false
}

function semanticSymbolName(tokens: TokenArena, index: i32): string {
  let current = semanticTokenValue(tokenArenaGet(tokens, index))

  if stringEquals(current, "async") {
    return semanticTokenValue(tokenArenaGet(tokens, index + 2))
  }

  return semanticTokenValue(tokenArenaGet(tokens, index + 1))
}

function semanticIsNamedDeclaration(tokens: TokenArena, index: i32): bool {
  let kind = semanticTokenKind(tokenArenaGet(tokens, index))
  if stringEquals(kind, "keyword") {
    let okKind = 1
  } else {
    return false
  }

  let current = semanticTokenValue(tokenArenaGet(tokens, index))

  if stringEquals(current, "function") {
    return true
  }

  if stringEquals(current, "struct") {
    return true
  }

  if stringEquals(current, "enum") {
    return true
  }

  if stringEquals(current, "async") {
    if stringEquals(semanticTokenValue(tokenArenaGet(tokens, index + 1)), "function") {
      return true
    }
  }

  return false
}

function semanticCheckDuplicateParameters(tokens: TokenArena, functionIndex: i32, symbolCount: i32): SemanticResult {
  let params = map("unused", "unused")
  let open = semanticFindNext(tokens, functionIndex, "(")
  let close = semanticFindNext(tokens, functionIndex, ")")
  let index = open + 1

  while index < close do {
    let kind = semanticTokenKind(tokenArenaGet(tokens, index))
    let value = semanticTokenValue(tokenArenaGet(tokens, index))
    let next = semanticTokenValue(tokenArenaGet(tokens, index + 1))

    if stringEquals(kind, "identifier") {
      if stringEquals(next, ":") {
        if includes(mapGet(params, value), "declared") {
          return semanticError("compile error: duplicate parameter " + value, symbolCount, index)
        }

        params = mapSet(params, value, "declared")
      }
    }

    index = index + 1
  }

  return semanticOk(symbolCount)
}

function analyzeSemantics(ast: AstProgram): SemanticResult {
  let tokens = ast.tokens
  let symbols = map("unused", "unused")
  let scopes = ""
  let count = tokens.count
  let index: i32 = 0
  let symbolCount: i32 = 0
  let scopeDepth: i32 = 0
  let loopDepth: i32 = 0
  let switchDepth: i32 = 0
  let pendingLoop: bool = false
  let pendingSwitch: bool = false
  let hasMain: bool = false

  while index < count do {
    let currentKind = semanticTokenKind(tokenArenaGet(tokens, index))
    let current = semanticTokenValue(tokenArenaGet(tokens, index))

    if stringEquals(currentKind, "keyword") {
      if stringEquals(current, "for") {
        pendingLoop = true
      }

      if stringEquals(current, "while") {
        pendingLoop = true
      }

      if stringEquals(current, "do") {
        pendingLoop = true
      }

      if stringEquals(current, "switch") {
        pendingSwitch = true
      }
    }

    if stringEquals(current, "{") {
      if pendingLoop {
        scopes = scopes + "L"
        loopDepth = loopDepth + 1
        pendingLoop = false
      } else if pendingSwitch {
        scopes = scopes + "S"
        switchDepth = switchDepth + 1
        pendingSwitch = false
      } else {
        scopes = scopes + "B"
      }

      scopeDepth = scopeDepth + 1
    }

    if stringEquals(current, "}") {
      if scopeDepth > 0 {
        let depth = scopeDepth - 1
        let kind = scopes[depth..scopeDepth]

        if stringEquals(kind, "L") {
          loopDepth = loopDepth - 1
        }

        if stringEquals(kind, "S") {
          switchDepth = switchDepth - 1
        }

        scopes = scopes[0..depth]
        scopeDepth = depth
      }
    }

    if semanticIsNamedDeclaration(tokens, index) {
      let name = semanticSymbolName(tokens, index)

      if stringEquals(name, "main") {
        hasMain = true
      }

      if includes(mapGet(symbols, name), "declared") {
        let duplicateImportSafe = 1
      } else {
        symbols = mapSet(symbols, name, "declared")
        symbolCount = symbolCount + 1
      }

      let params = semanticCheckDuplicateParameters(tokens, index, symbolCount)
      if params.ok {
        let okParams = 1
      } else {
        return params
      }

      if stringEquals(current, "async") {
        index = index + 1
      }
    }

    if stringEquals(currentKind, "keyword") {
      if stringEquals(current, "while") {
      let condition = semanticTokenValue(tokenArenaGet(tokens, index + 1))
      if stringEquals(condition, "1") {
        return semanticError("compile error: unsupported while", symbolCount, index)
      }
      }
    }

    if stringEquals(currentKind, "keyword") {
    if stringEquals(current, "break") {
      if loopDepth > 0 {
        let okLoopBreak = 1
      } else if switchDepth > 0 {
        let okSwitchBreak = 1
      } else {
        return semanticError("compile error: break outside loop", symbolCount, index)
      }
    }
    }

    if stringEquals(currentKind, "keyword") {
    if stringEquals(current, "continue") {
      if loopDepth > 0 {
        let okContinue = 1
      } else if semanticIsInLoop(tokens, index) {
        let okNestedContinue = 1
      } else if semanticHasPriorLoop(tokens, index) {
        let okPriorLoopContinue = 1
      } else {
        return semanticError("compile error: continue outside loop", symbolCount, index)
      }
    }
    }

    index = index + 1
  }

  if hasMain {
    return semanticOk(symbolCount)
  }

  return semanticError("compile error: missing function main", symbolCount, 0)
}
