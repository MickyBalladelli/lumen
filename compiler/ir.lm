import { AstProgram, astChildAt, astNodeAt } from "./ast.lm"
import { compilerAbiSignature } from "./abi.lm"
import { CompilerAstNode, CompilerIrBlock, CompilerIrFunction, CompilerIrValue, IrBlockArena, IrFunctionArena, IrValueArena, irBlockArena, irBlockArenaGet, irBlockArenaPush, irFunctionArena, irFunctionArenaGet, irFunctionArenaPush, irValueArena, irValueArenaGet, irValueArenaPush, tokenArenaGet } from "./containers.lm"
struct TypedIrModule {
  values: IrValueArena
  blocks: IrBlockArena
  functions: IrFunctionArena
  functionTypes: string
  localTypes: string
  enumValues: string
  fieldSlots: string
  fieldTypes: string
  fieldCount: i32
}

function typedIrModule(): TypedIrModule {
  return TypedIrModule {
    values: irValueArena(),
    blocks: irBlockArena(),
    functions: irFunctionArena(),
    functionTypes: map("unused", "0"),
    localTypes: map("unused", "0"),
    enumValues: map("unused", "0"),
    fieldSlots: map("unused", "0"),
    fieldTypes: map("unused", "1"),
    fieldCount: 0
  }
}

function typedIrValue(node: CompilerAstNode, nodeKind: string, typeId: i32, operand0: i32, operand1: i32, text: string): CompilerIrValue {
  return CompilerIrValue {
    kind: nodeKind,
    typeId: typeId,
    operand0: operand0,
    operand1: operand1,
    text: text,
    file: node.file,
    offset: node.offset,
    line: node.line,
    column: node.column,
    endOffset: node.endOffset,
    endLine: node.endLine,
    endColumn: node.endColumn
  }
}

function typedIrAppendValue(module: TypedIrModule, node: CompilerAstNode, kind: string, typeId: i32, operand0: i32, operand1: i32, text: string): TypedIrModule {
  let normalizedType = typeId
  if normalizedType < 0 {
    normalizedType = 0
  }
  module.values = irValueArenaPush(module.values, typedIrValue(node, kind, normalizedType, operand0, operand1, text))
  if stringEquals(kind, "param") || stringEquals(kind, "local") {
    module.localTypes = mapSet(module.localTypes, text, intToString(normalizedType))
  }
  return module
}

function typedIrTypeId(typeName: string): i32 {
  if stringEquals(typeName, "i32") || stringEquals(typeName, "bool") ||
    stringEquals(typeName, "") {
    return 0
  }
  if stringEquals(typeName, "void") {
    return 4
  }
  if stringEquals(typeName, "Result<i32>") {
    return 2
  }
  if includes(typeName, "Result") {
    return 3
  }
  return 1
}

function typedIrStorageTypeId(module: TypedIrModule, name: string): i32 {
  if mapHas(module.localTypes, name) {
    return stringToInt(mapGet(module.localTypes, name))
  }
  return 0
}

function typedIrCallTypeId(module: TypedIrModule, name: string, arguments: i32): i32 {
  if mapHas(module.functionTypes, name) {
    return stringToInt(mapGet(module.functionTypes, name))
  }

  let functionIndex: i32 = 0
  while functionIndex < module.functions.count do {
    let fn = irFunctionArenaGet(module.functions, functionIndex)
    if stringEquals(fn.name, name) {
      return fn.returnTypeId
    }
    functionIndex = functionIndex + 1
  }

  if stringEquals(name, "resultValue") && arguments >= 0 {
    let argument = irValueArenaGet(module.values, arguments)
    let source = irValueArenaGet(module.values, argument.operand0)
    if source.typeId == 2 {
      return 0
    }
    return 1
  }
  let signature = compilerAbiSignature(name)
  if signature.found {
    return typedIrTypeId(signature.returnType)
  }
  return 1
}

function typedIrRegisterFunctionTypes(module: TypedIrModule, ast: AstProgram): TypedIrModule {
  let root = astNodeAt(ast, ast.root)
  let index: i32 = 0

  while index < root.childCount do {
    let nodeId = astChildAt(ast, ast.root, index)
    let node = astNodeAt(ast, nodeId)
    if stringEquals(node.kind, "FunctionDeclaration") {
      let returnType: i32 = 0
      let childIndex: i32 = 0
      while childIndex < node.childCount do {
        let child = astNodeAt(ast, astChildAt(ast, nodeId, childIndex))
        if stringEquals(child.kind, "TypeAnnotation") {
          returnType = typedIrTypeId(child.typeName)
        }
        childIndex = childIndex + 1
      }
      module.functionTypes = mapSet(module.functionTypes, node.name, intToString(returnType))
    }
    index = index + 1
  }

  return module
}

function typedIrRegisterStructFields(module: TypedIrModule, ast: AstProgram): TypedIrModule {
  let root = astNodeAt(ast, ast.root)
  let index: i32 = 0

  while index < root.childCount do {
    let nodeId = astChildAt(ast, ast.root, index)
    let node = astNodeAt(ast, nodeId)
    if stringEquals(node.kind, "StructDeclaration") {
      let childIndex: i32 = 0
      while childIndex < node.childCount do {
        let child = astNodeAt(ast, astChildAt(ast, nodeId, childIndex))
        if stringEquals(child.kind, "StructField") {
          module = typedIrRegisterField(module, child.name, typedIrTypeId(child.typeName))
        }
        childIndex = childIndex + 1
      }
    }
    index = index + 1
  }

  return module
}

function typedIrRegisterEnumValues(module: TypedIrModule, ast: AstProgram): TypedIrModule {
  let root = astNodeAt(ast, ast.root)
  let nodeIndex: i32 = 0
  while nodeIndex < root.childCount do {
    let nodeId = astChildAt(ast, ast.root, nodeIndex)
    let node = astNodeAt(ast, nodeId)
    if stringEquals(node.kind, "EnumDeclaration") {
      let childIndex: i32 = 0
      let value: i32 = 0
      while childIndex < node.childCount do {
        let child = astNodeAt(ast, astChildAt(ast, nodeId, childIndex))
        if stringEquals(child.kind, "EnumVariant") {
          module.enumValues = mapSet(module.enumValues, child.name, intToString(value))
          value = value + 1
        }
        childIndex = childIndex + 1
      }
    }
    nodeIndex = nodeIndex + 1
  }
  return module
}

function typedIrFieldSlot(module: TypedIrModule, name: string): i32 {
  if mapHas(module.fieldSlots, name) {
    return stringToInt(mapGet(module.fieldSlots, name))
  }
  return module.fieldCount
}

function typedIrFieldTypeId(module: TypedIrModule, name: string): i32 {
  if mapHas(module.fieldTypes, name) {
    return stringToInt(mapGet(module.fieldTypes, name))
  }
  return 1
}

function typedIrRegisterField(module: TypedIrModule, name: string, typeId: i32): TypedIrModule {
  if !mapHas(module.fieldSlots, name) {
    module.fieldSlots = mapSet(module.fieldSlots, name, intToString(module.fieldCount))
    module.fieldTypes = mapSet(module.fieldTypes, name, intToString(typeId))
    module.fieldCount = module.fieldCount + 1
  }
  return module
}

// AST identifiers describe syntax. IR operands must instead refer to values
// owned by this block, so the backend never needs to recover AST parents.
function typedIrLowerNode(module: TypedIrModule, ast: AstProgram, nodeId: i32): TypedIrModule {
  let node = astNodeAt(ast, nodeId)
  let firstChild = module.values.count
  let childIndex: i32 = 0
  let operand0: i32 = -1
  let operand1: i32 = -1

  if stringEquals(node.kind, "IfStatement") {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    let condition = module.values.count - 1
    module = typedIrAppendValue(module, node, "if.begin", node.typeId, condition, -1, "")
    let branch = module.values.count - 1
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 1))
    if node.childCount > 2 {
      module = typedIrAppendValue(module, node, "if.else", node.typeId, branch, -1, "")
      module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 2))
    }
    return typedIrAppendValue(module, node, "if.end", node.typeId, branch, -1, "")
  }

  if stringEquals(node.kind, "WhileStatement") {
    module = typedIrAppendValue(module, node, "while.begin", node.typeId, -1, -1, "")
    let loop = module.values.count - 1
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    let condition = module.values.count - 1
    module = typedIrAppendValue(module, node, "while.condition", node.typeId, condition, loop, "")
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 1))
    return typedIrAppendValue(module, node, "while.end", node.typeId, loop, -1, "")
  }

  if stringEquals(node.kind, "ForStatement") {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    module = typedIrAppendValue(module, node, "while.begin", node.typeId, -1, -1, "")
    let loop = module.values.count - 1
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 1))
    let condition = module.values.count - 1
    module = typedIrAppendValue(module, node, "while.condition", node.typeId, condition, loop, "")
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 3))
    module = typedIrAppendValue(module, node, "for.update", node.typeId, loop, -1, "")
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 2))
    return typedIrAppendValue(module, node, "while.end", node.typeId, loop, -1, "")
  }

  if stringEquals(node.kind, "SwitchStatement") {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    let subject = module.values.count - 1
    module = typedIrAppendValue(module, node, "switch.begin", node.typeId, subject, -1, "")
    let switchId = module.values.count - 1
    childIndex = 1
    while childIndex < node.childCount do {
      let caseId = astChildAt(ast, nodeId, childIndex)
      let switchCase = astNodeAt(ast, caseId)
      let pattern: i32 = -1
      let bodyIndex: i32 = 0
      if switchCase.flags == 0 {
        module = typedIrLowerNode(module, ast, astChildAt(ast, caseId, 0))
        pattern = module.values.count - 1
        bodyIndex = 1
      }
      module = typedIrAppendValue(module, switchCase, "switch.case", 0, subject, pattern, intToString(switchId))
      let marker = module.values.count - 1
      module = typedIrLowerNode(module, ast, astChildAt(ast, caseId, bodyIndex))
      module = typedIrAppendValue(module, switchCase, "switch.endcase", 0, marker, switchId, "")
      childIndex = childIndex + 1
    }
    return typedIrAppendValue(module, node, "switch.end", node.typeId, switchId, -1, "")
  }

  if stringEquals(node.kind, "TryCatchStatement") {
    let tryBlockId = astChildAt(ast, nodeId, 0)
    let tryBlock = astNodeAt(ast, tryBlockId)
    let throwId: i32 = -1
    childIndex = 0
    while childIndex < tryBlock.childCount do {
      let statementId = astChildAt(ast, tryBlockId, childIndex)
      let statement = astNodeAt(ast, statementId)
      if stringEquals(statement.kind, "ThrowStatement") {
        throwId = statementId
        break
      }
      childIndex = childIndex + 1
    }
    if throwId >= 0 {
      module = typedIrLowerNode(module, ast, astChildAt(ast, throwId, 0))
      let thrown = module.values.count - 1
      let parameter = astNodeAt(ast, astChildAt(ast, nodeId, 1))
      module = typedIrAppendValue(module, parameter, "local", 1, thrown, -1, parameter.name)
      module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 2))
    } else {
      module = typedIrLowerNode(module, ast, tryBlockId)
    }
    return typedIrAppendValue(module, node, "try", node.typeId, -1, -1, "")
  }

  if stringEquals(node.kind, "StructExpression") {
    let fields: i32 = -1
    while childIndex < node.childCount do {
      module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, childIndex))
      let field = module.values.count - 1
      module = typedIrAppendValue(module, node, "field.link", 1, field, fields, "")
      fields = module.values.count - 1
      childIndex = childIndex + 1
    }
    return typedIrAppendValue(module, node, "struct", 1, -1, fields, node.name)
  }

  if stringEquals(node.kind, "ArrayExpression") {
    let elements: i32 = -1
    while childIndex < node.childCount do {
      module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, childIndex))
      let element = module.values.count - 1
      let elementValue = irValueArenaGet(module.values, element)
      module = typedIrAppendValue(module, node, "array.element", elementValue.typeId, element, elements, "")
      elements = module.values.count - 1
      childIndex = childIndex + 1
    }
    return typedIrAppendValue(module, node, "array", 1, node.childCount, elements, "")
  }

  if stringEquals(node.kind, "SliceExpression") {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    let object = module.values.count - 1
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 1))
    let start = module.values.count - 1
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 2))
    let end = module.values.count - 1
    module = typedIrAppendValue(module, node, "slice.range", 0, start, end, "")
    return typedIrAppendValue(module, node, "slice", 1, object, module.values.count - 1, "")
  }

  if stringEquals(node.kind, "MatchExpression") {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, 0))
    let subject = module.values.count - 1
    let arms: i32 = -1
    let resultType: i32 = 1
    childIndex = 1
    while childIndex < node.childCount do {
      let armId = astChildAt(ast, nodeId, childIndex)
      let arm = astNodeAt(ast, armId)
      if stringEquals(arm.kind, "MatchArm") {
        module = typedIrLowerNode(module, ast, astChildAt(ast, armId, 0))
        let pattern = module.values.count - 1
        module = typedIrLowerNode(module, ast, astChildAt(ast, armId, 1))
        let result = module.values.count - 1
        let resultValue = irValueArenaGet(module.values, result)
        resultType = resultValue.typeId
        module = typedIrAppendValue(module, arm, "match.arm", 1, pattern, result, intToString(arms))
        arms = module.values.count - 1
      }
      childIndex = childIndex + 1
    }
    return typedIrAppendValue(module, node, "match", resultType, subject, arms, "")
  }

  if stringEquals(node.kind, "CallExpression") {
    if stringEquals(node.name, "await") {
      let callText = node.text
      let open = indexOf(callText, "(")
      let target: string = callText[5..open]
      module = typedIrAppendValue(module, node, "load", 1, -1, -1, target)
      return typedIrAppendValue(
        module,
        node,
        "call.0",
        typedIrCallTypeId(module, target, -1),
        module.values.count - 1,
        -1,
        target
      )
    }
    let callee: i32 = -1
    let arguments: i32 = -1
    while childIndex < node.childCount do {
      module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, childIndex))
      let childValue = module.values.count - 1
      if childIndex == 0 {
        callee = childValue
      } else {
        module = typedIrAppendValue(module, node, "argument", node.typeId, childValue, arguments, "")
        arguments = module.values.count - 1
      }
      childIndex = childIndex + 1
    }
    return typedIrAppendValue(
      module,
      node,
      "call." + intToString(node.childCount - 1),
      typedIrCallTypeId(module, node.name, arguments),
      callee,
      arguments,
      node.name
    )
  }

  while childIndex < node.childCount do {
    module = typedIrLowerNode(module, ast, astChildAt(ast, nodeId, childIndex))
    let childValue = module.values.count - 1
    if childIndex == 0 {
      operand0 = childValue
    }
    if childIndex == 1 {
      operand1 = childValue
    }
    childIndex = childIndex + 1
  }

  if stringEquals(node.kind, "RawExpression") ||
    stringEquals(node.kind, "BlockStatement") ||
    stringEquals(node.kind, "TypeAnnotation") ||
    stringEquals(node.kind, "Identifier") {
    return module
  }

  let kind = node.kind
  let typeId = node.typeId
  let text = node.text
  if stringEquals(kind, "LiteralExpression") {
    kind = "literal"
    text = node.value
    let token = tokenArenaGet(ast.tokens, node.tokenStart)
    if stringEquals(token.kind, "string") {
      typeId = 1
      let interpolation = indexOf(node.value, "${")
      let interpolationEnd = indexOf(node.value, "}")
      if interpolation >= 0 && interpolationEnd > interpolation {
        let literalValue = node.value
        let name: string = literalValue[interpolation + 2..interpolationEnd]
        module = typedIrAppendValue(module, node, "load", typedIrStorageTypeId(module, name), -1, -1, name)
        operand0 = module.values.count - 1
        kind = "interpolate"
      }
    } else {
      typeId = 0
    }
  } else if stringEquals(kind, "IdentifierExpression") {
    if stringEquals(node.name, "_") {
      kind = "match.wildcard"
      text = ""
      typeId = 0
    } else if mapHas(module.enumValues, node.name) {
      kind = "literal"
      text = mapGet(module.enumValues, node.name)
      typeId = 0
    } else {
      kind = "load"
      text = node.name
      typeId = typedIrStorageTypeId(module, node.name)
    }
  } else if stringEquals(kind, "VariableDeclarator") {
    kind = "local"
    text = node.name
    operand1 = -1
    if module.values.count > firstChild {
      operand0 = module.values.count - 1
      let initializer = irValueArenaGet(module.values, operand0)
      typeId = initializer.typeId
    }
    if !stringEquals(node.typeName, "") {
      typeId = typedIrTypeId(node.typeName)
    }
  } else if stringEquals(kind, "BinaryExpression") {
    kind = "binary." + node.operator
    let left = irValueArenaGet(module.values, operand0)
    let right = irValueArenaGet(module.values, operand1)
    if left.typeId > 0 || right.typeId > 0 {
      typeId = 1
    }
  } else if stringEquals(kind, "AssignmentExpression") {
    kind = "assign." + node.operator
    if module.values.count > firstChild + 1 {
      operand1 = module.values.count - 1
    }
  } else if stringEquals(kind, "UnaryExpression") {
    kind = "unary." + node.operator
    if module.values.count > firstChild {
      operand0 = module.values.count - 1
    }
  } else if stringEquals(kind, "StructProperty") {
    kind = "struct.field"
    text = node.name
    if module.values.count > firstChild {
      operand0 = module.values.count - 1
      let fieldValue = irValueArenaGet(module.values, operand0)
      typeId = fieldValue.typeId
    }
    module = typedIrRegisterField(module, node.name, typeId)
    operand1 = typedIrFieldSlot(module, node.name)
  } else if stringEquals(kind, "MemberExpression") {
    if node.flags == 1 {
      kind = "index"
      typeId = 0
    } else {
      kind = "member"
      text = node.name
      if node.typeId >= 0 {
        typeId = node.typeId
      } else {
        typeId = typedIrFieldTypeId(module, node.name)
      }
      module = typedIrRegisterField(module, node.name, typeId)
      operand1 = typedIrFieldSlot(module, node.name)
    }
  } else if stringEquals(kind, "ReturnStatement") {
    kind = "return"
    if module.values.count > firstChild {
      operand0 = module.values.count - 1
    }
  }

  return typedIrAppendValue(module, node, kind, typeId, operand0, operand1, text)
}

function typedIrBlockTerminator(module: TypedIrModule, firstValue: i32): string {
  let index = firstValue
  while index < module.values.count do {
    let value = irValueArenaGet(module.values, index)
    if stringEquals(value.kind, "return") {
      return "return"
    }
    index = index + 1
  }

  return "return"
}


// Function ownership is explicit. The LLVM emitter can lower one function
// without recovering it from a delimiter-sensitive program string.
function buildTypedIr(ast: AstProgram): TypedIrModule {
  let module = typedIrModule()
  let root = astNodeAt(ast, ast.root)
  module = typedIrRegisterStructFields(module, ast)
  module = typedIrRegisterEnumValues(module, ast)
  module = typedIrRegisterFunctionTypes(module, ast)
  let childIndex: i32 = 0

  while childIndex < root.childCount do {
    let nodeId = astChildAt(ast, ast.root, childIndex)
    let node = astNodeAt(ast, nodeId)
    if stringEquals(node.kind, "FunctionDeclaration") {
      module.localTypes = map("unused", "0")
      let firstValue = module.values.count
      let returnTypeId: i32 = 0
      let functionChild: i32 = 0
      while functionChild < node.childCount do {
        let functionNodeId = astChildAt(ast, nodeId, functionChild)
        let functionNode = astNodeAt(ast, functionNodeId)
        if stringEquals(functionNode.kind, "BlockStatement") {
          module = typedIrLowerNode(module, ast, functionNodeId)
        } else if stringEquals(functionNode.kind, "VariableDeclarator") {
          module = typedIrAppendValue(module, functionNode, "param", typedIrTypeId(functionNode.typeName), -1, -1, functionNode.name)
        } else if stringEquals(functionNode.kind, "TypeAnnotation") {
          returnTypeId = typedIrTypeId(functionNode.typeName)
        }
        functionChild = functionChild + 1
      }
      let blockId = module.blocks.count
      module.blocks = irBlockArenaPush(module.blocks, CompilerIrBlock {
        name: node.name + ".entry",
        firstValue: firstValue,
        valueCount: module.values.count - firstValue,
        terminator: typedIrBlockTerminator(module, firstValue),
        target0: -1,
        target1: -1,
        file: node.file,
        offset: node.offset,
        line: node.line,
        column: node.column,
        endOffset: node.endOffset,
        endLine: node.endLine,
        endColumn: node.endColumn
      })
      module.functions = irFunctionArenaPush(module.functions, CompilerIrFunction {
        name: node.name,
        firstBlock: blockId,
        blockCount: 1,
        returnTypeId: returnTypeId,
        file: node.file,
        offset: node.offset,
        line: node.line,
        column: node.column,
        endOffset: node.endOffset,
        endLine: node.endLine,
        endColumn: node.endColumn
      })
    }
    childIndex = childIndex + 1
  }
  return module
}

function typedIrValid(module: TypedIrModule): bool {
  let functionIndex: i32 = 0
  let previousBlockEnd: i32 = 0
  let previousValueEnd: i32 = 0
  let functionNames = map("unused", "0")
  let blockNames = map("unused", "0")

  while functionIndex < module.functions.count do {
    let fn = irFunctionArenaGet(module.functions, functionIndex)
    if stringEquals(fn.name, "") || fn.blockCount < 1 ||
      fn.returnTypeId < 0 {
      return false
    }
    if mapHas(functionNames, fn.name) {
      return false
    }
    functionNames = mapSet(functionNames, fn.name, "1")
    if fn.firstBlock != previousBlockEnd {
      return false
    }
    if fn.firstBlock + fn.blockCount > module.blocks.count {
      return false
    }

    let blockIndex = fn.firstBlock
    while blockIndex < fn.firstBlock + fn.blockCount do {
      let block = irBlockArenaGet(module.blocks, blockIndex)
      if stringEquals(block.name, "") || stringEquals(block.terminator, "") {
        return false
      }
      if mapHas(blockNames, block.name) {
        return false
      }
      blockNames = mapSet(blockNames, block.name, "1")
      if block.firstValue < 0 || block.valueCount < 0 {
        return false
      }
      if block.firstValue != previousValueEnd {
        return false
      }
      if block.firstValue + block.valueCount > module.values.count {
        return false
      }
      if !stringEquals(block.terminator, "return") &&
        !stringEquals(block.terminator, "branch") &&
        !stringEquals(block.terminator, "condbranch") &&
        !stringEquals(block.terminator, "unreachable") {
        return false
      }
      if stringEquals(block.terminator, "branch") &&
        (block.target0 < fn.firstBlock ||
          block.target0 >= fn.firstBlock + fn.blockCount) {
        return false
      }
      if stringEquals(block.terminator, "condbranch") &&
        (block.target0 < fn.firstBlock ||
          block.target0 >= fn.firstBlock + fn.blockCount ||
          block.target1 < fn.firstBlock ||
          block.target1 >= fn.firstBlock + fn.blockCount) {
        return false
      }

      let valueIndex = block.firstValue
      while valueIndex < block.firstValue + block.valueCount do {
        let value = irValueArenaGet(module.values, valueIndex)
        if stringEquals(value.kind, "") {
          return false
        }
        if value.typeId < 0 ||
          value.operand0 < -1 || value.operand1 < -1 {
          return false
        }
        let operand0IsValue = !stringEquals(value.kind, "array")
        let operand1IsValue = !stringEquals(value.kind, "member") &&
          !stringEquals(value.kind, "struct.field")
        if (operand0IsValue && value.operand0 >= module.values.count) ||
          (operand1IsValue && value.operand1 >= module.values.count) {
          return false
        }
        if (operand0IsValue && value.operand0 >= valueIndex) ||
          (operand1IsValue && value.operand1 >= valueIndex) {
          return false
        }
        if operand0IsValue && value.operand0 >= 0 &&
          value.operand0 < block.firstValue {
          return false
        }
        if operand1IsValue && value.operand1 >= 0 &&
          value.operand1 < block.firstValue {
          return false
        }
        valueIndex = valueIndex + 1
      }
      previousValueEnd = block.firstValue + block.valueCount
      blockIndex = blockIndex + 1
    }

    previousBlockEnd = fn.firstBlock + fn.blockCount
    functionIndex = functionIndex + 1
  }

  return previousBlockEnd == module.blocks.count && previousValueEnd == module.values.count
}

function buildIr(ast: AstProgram): TypedIrModule {
  return buildTypedIr(ast)
}
