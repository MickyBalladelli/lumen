import { tokenize } from "../compiler/tokenizer.lm"
import { astToProgram, parseProgram } from "../compiler/parser.lm"
import { analyzeSemantics } from "../compiler/semantics.lm"
import { checkTypes } from "../compiler/typechecker.lm"
import { buildIr } from "../compiler/ir.lm"
import { emitIr } from "../compiler/emitter.lm"
import { astCountKind, astMaxDepth } from "../compiler/ast.lm"

function main(): i32 {
  let tokens = tokenize("function main(): i32 { let value = 7 println(value) return value }")
  let ast = parseProgram(tokens)
  let program = astToProgram(ast)
  let ir = buildIr(ast)
  let llvm = emitIr(ir)

  println(mapGet(program, "mainReturnValue"))
  println(mapGet(program, "statementCount"))
  println(mapGet(program, "statement0Kind"))
  println(mapGet(program, "statement0ExprKind"))
  println(mapGet(program, "statement1Kind"))
  println(mapGet(program, "statement1ExprKind"))
  println(mapGet(program, "statement2Kind"))
  println(mapGet(program, "statement2ExprKind"))
  println(includes(llvm, "ret i32 7"))
  println(mapGet(program, "irKind"))

  let syntaxSource = 'import { println } from "system"
struct Point {
  x: i32
}
function helper(value: i32): i32 {
  return value + 1
}
function main(): i32 {
  let value: i32 = 0
  while value < 3 do {
    if value == 2 {
      break
    }
    value = helper(value)
    continue
  }
  println(value)
  return value
}'
  let syntaxTokens = tokenize(syntaxSource)
  let syntaxAst = parseProgram(syntaxTokens)
  let syntaxSemantics = analyzeSemantics(syntaxAst)
  let syntaxTypes = checkTypes(syntaxAst)

  println(astCountKind(syntaxAst, "Program"))
  println(astCountKind(syntaxAst, "ImportDeclaration"))
  println(astCountKind(syntaxAst, "StructDeclaration"))
  println(astCountKind(syntaxAst, "StructField"))
  println(astCountKind(syntaxAst, "FunctionDeclaration"))
  println(astCountKind(syntaxAst, "VariableDeclaration"))
  println(astCountKind(syntaxAst, "WhileStatement"))
  println(astCountKind(syntaxAst, "IfStatement"))
  println(astCountKind(syntaxAst, "AssignmentExpression"))
  println(astCountKind(syntaxAst, "CallExpression"))
  println(astCountKind(syntaxAst, "ReturnStatement"))
  println(astMaxDepth(syntaxAst))
  println(syntaxSemantics.ok)
  println(syntaxSemantics.symbolCount)
  println(syntaxTypes.ok)
  println(syntaxTypes.checkedCount)

  let badTokens = tokenize("function main(): i32 { break return 0 }")
  let badAst = parseProgram(badTokens)
  let badSemantics = analyzeSemantics(badAst)
  println(badSemantics.ok)
  println(badSemantics.message)

  let badTypeTokens = tokenize("function main(): i32 { let value: string = 7 return 0 }")
  let badTypeAst = parseProgram(badTypeTokens)
  let badTypes = checkTypes(badTypeAst)
  println(badTypes.ok)
  println(badTypes.message)

  return 0
}
