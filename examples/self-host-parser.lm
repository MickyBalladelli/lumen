import { tokenize } from "../compiler/tokenizer.lm"
import { parseAst, parseProgram } from "../compiler/parser.lm"
import { emitMain } from "../compiler/emitter.lm"

function main(): i32 {
  let tokens = tokenize("function main(): i32 { let value = 7 println(value) return value }")
  let program = parseProgram(tokens)
  let llvm = emitMain(program)

  println(mapGet(program, "mainReturnValue"))
  println(mapGet(program, "statementCount"))
  println(mapGet(program, "statement0Kind"))
  println(mapGet(program, "statement0ExprKind"))
  println(mapGet(program, "statement1Kind"))
  println(mapGet(program, "statement1ExprKind"))
  println(mapGet(program, "statement2Kind"))
  println(mapGet(program, "statement2ExprKind"))
  println(includes(llvm, "ret i32 7"))

  let syntaxSource = 'import { println } from "system" struct Point { x: i32 y: i32 } enum Status { Ok Missing } extern function native(value: i32): i32 async function load(): i32 { return 1 } function main(): i32 { defer cleanup() let status: Status = Missing let label = match status { Ok => "ok" _ => "unknown" } for item in 0..2 { continue } for (let value of values) { break } switch status { case Missing { println(label) } default { println("x") } } do { status = Ok } until status == Ok try { throw "boom" } catch error { println(error) } return 0 }'
  let syntaxTokens = tokenize(syntaxSource)
  let syntaxAst = parseAst(syntaxTokens)

  println(syntaxAst.importCount)
  println(syntaxAst.structCount)
  println(syntaxAst.enumCount)
  println(syntaxAst.externCount)
  println(syntaxAst.asyncFunctionCount)
  println(syntaxAst.deferCount)
  println(syntaxAst.matchCount)
  println(syntaxAst.forRangeCount)
  println(syntaxAst.forOfCount)
  println(syntaxAst.switchCount)
  println(syntaxAst.doUntilCount)
  println(syntaxAst.tryCatchCount)

  return 0
}
