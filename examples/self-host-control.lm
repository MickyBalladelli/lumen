import { tokenize } from "../compiler/tokenizer.lm"
import { astToProgram, parseProgram } from "../compiler/parser.lm"
import { emitMain } from "../compiler/emitter.lm"

function main(): i32 {
  let sourceResult = readFile("examples/control-flow.lm")
  if !isOk(sourceResult) {
    println(errorMessage(sourceResult))
    return 1
  }
  let source = resultValue(sourceResult)
  let tokens = tokenize(source)
  let ast = parseProgram(tokens)
  let program = astToProgram(ast)
  let llvm = emitMain(program)

  println(mapGet(program, "mainReturnValue"))
  println(mapGet(program, "print0Value"))
  println(includes(llvm, "for.cond"))

  return 0
}
