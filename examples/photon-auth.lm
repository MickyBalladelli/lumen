import { googleAuthorizeUrl, authNeedsTokenExchange } from "auth"

function main(): i32 {
  let clientId = env("GOOGLE_CLIENT_ID")
  let redirectUri = env("AUTH_REDIRECT_URI")
  let state = env("AUTH_STATE")
  let nonce = env("AUTH_NONCE")

  if !isOk(clientId) {
    println("missing GOOGLE_CLIENT_ID")
    return 0
  }

  if !isOk(redirectUri) {
    println("missing AUTH_REDIRECT_URI")
    return 0
  }

  if !isOk(state) {
    println("missing AUTH_STATE")
    return 0
  }

  if !isOk(nonce) {
    println("missing AUTH_NONCE")
    return 0
  }

  println(googleAuthorizeUrl(
    resultValue(clientId),
    resultValue(redirectUri),
    resultValue(state),
    resultValue(nonce)
  ))
  println(authNeedsTokenExchange())

  return 0
}
