struct Point {
  x: i32
  y: i32
}

function main(): i32 {
  let values: i32[] = [2, 3, 5]
  let points: Point[] = [
    Point { x: 4, y: 7 },
    Point { x: 1, y: 9 }
  ]
  let total: i32 = 0

  for (let value of values) {
    total = total + value
  }

  for (let point of points) {
    total = total + point.y
  }

  println(total)

  return total
}
