import { println } from "system"

function add(left: i32, right: i32): i32 {
  return left + right
}

function main(): i32 {
  let total: i32 = 0

  for (let i: i32 = 0; i < 8; i++) {
    if i == 2 {
      continue
    }

    if i == 6 {
      break
    }

    total = total + i
  }

  let sum = add(total, 10)

  if sum == 23 {
    println("sum ${sum}")
  } else {
    println("bad")
  }

  return sum
}
