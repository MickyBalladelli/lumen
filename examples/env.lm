function main(): i32 {
  let valueResult = env("LUMEN_TEST_ENV")
  let dotenvResult = env("LUMEN_DOTENV_VALUE")
  let missing = env("LUMEN_MISSING_ENV")

  if !isOk(valueResult) {
    println(errorMessage(valueResult))
    return 1
  }
  if !isOk(dotenvResult) {
    println(errorMessage(dotenvResult))
    return 1
  }
  let value = resultValue(valueResult)
  let dotenv = resultValue(dotenvResult)

  println(value)
  println(dotenv)
  println(errorMessage(missing))
  println(includes(value, "from-env"))
  println(includes(dotenv, "from-dotenv"))

  return 0
}
