function processArg(index: i32, fallback: string): string {
  let value = arg(index)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function processHasArgs(): bool {
  let count = argCount()
  if !isOk(count) {
    return false
  }
  return resultValue(count) > 1
}

function processName(fallback: string): string {
  return processArg(0, fallback)
}
