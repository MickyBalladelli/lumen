function argOr(index: i32, fallback: string): string {
  let value = arg(index)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function hasArgs(): bool {
  let count = argCount()
  if !isOk(count) {
    return false
  }
  return resultValue(count) > 1
}

function commandName(fallback: string): string {
  return argOr(1, fallback)
}
