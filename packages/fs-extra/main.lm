function readTextOr(path: string, fallback: string): string {
  let value = readFile(path)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function writeJsonText(path: string, jsonText: string): Result<i32> {
  return writeFile(path, jsonText)
}

function appendLine(path: string, message: string): Result<i32> {
  return appendFile(path, message)
}
