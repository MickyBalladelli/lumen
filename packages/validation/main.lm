function requireString(name: string, value: string): string {
  if stringEquals(value, "") {
    return err(name + " is required")
  }

  return ok(value)
}

function minI32(name: string, value: i32, min: i32): string {
  if value < min {
    return err(name + " is too small")
  }

  return ok(intToString(value))
}

function maxI32(name: string, value: i32, max: i32): string {
  if value > max {
    return err(name + " is too large")
  }

  return ok(intToString(value))
}

function emailLike(name: string, value: string): string {
  if includes(value, "@") {
    return ok(value)
  }

  return err(name + " must look like email")
}
