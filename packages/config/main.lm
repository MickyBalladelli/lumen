function envOr(name: string, fallback: string): string {
  let value = env(name)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function requireEnv(name: string): Result<string> {
  let value = env(name)

  return value
}

function configFromEnv(name: string, fallback: string): string {
  let value = env(name)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function configRequired(name: string): Result<string> {
  let value = env(name)

  return value
}

function configPair(name: string, value: string): string {
  return map(name, value)
}
