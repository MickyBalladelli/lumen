function envValue(name: string): string {
  return env(name)
}

function envOr(name: string, fallback: string): string {
  let value = env(name)

  if stringEquals(value, "") {
    return fallback
  }

  return value
}

function requireEnv(name: string): string {
  let value = env(name)

  if stringEquals(value, "") {
    return err("missing env " + name)
  }

  return ok(value)
}
