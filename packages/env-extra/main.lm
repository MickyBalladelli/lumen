function envText(name: string, fallback: string): string {
  let value = env(name)

  if !isOk(value) {
    return fallback
  }

  return resultValue(value)
}

function envRequired(name: string): Result<string> {
  let value = env(name)

  return value
}

function envBool(name: string, fallback: bool): bool {
  let value = env(name)

  if !isOk(value) {
    return fallback
  }
  let text = resultValue(value)

  if stringEquals(text, "true") {
    return true
  }

  if stringEquals(text, "false") {
    return false
  }

  return fallback
}
