{
  "name": "lumen",
  "version": "0.1.0",
  "type": "module",
  "description": "Foundational compiler for the Lumen systems language",
  "keywords": [
    "compiler",
    "language",
    "llvm",
    "lsp"
  ],
  "author": "Micky Balladelli",
  "license": "MIT",
  "homepage": "https://github.com/MickyBalladelli/lumen#readme",
  "bugs": {
    "url": "https://github.com/MickyBalladelli/lumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MickyBalladelli/lumen.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "scripts/check-docs.mjs",
    "scripts/generate-support-matrix.mjs",
    "compiler",
    "benchmarks",
    "packages",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "book",
    "lumen.json",
    "photon.json"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "lumen": "./src/cli/lumen.js",
    "lmsh": "./src/cli/lmsh.js",
    "photon": "./src/cli/photon.js",
    "lumen-format": "./src/cli/format.js",
    "lumen-lsp": "./src/cli/lsp.js"
  },
  "scripts": {
    "lumen": "node ./src/cli/lumen.js",
    "parse": "node ./src/cli/parse.js",
    "format": "node ./src/cli/format.js",
    "lsp": "node ./src/cli/lsp.js",
    "compile": "./build/lumen-compiler",
    "bootstrap": "node ./src/cli/check-runtime-abi.js && node ./src/cli/compile.js compiler/main.lm -o build/lumen-compiler",
    "check:abi": "node ./src/cli/check-runtime-abi.js",
    "lmsh": "node ./src/cli/lmsh.js",
    "http": "node ./src/cli/http.js",
    "chat": "node ./src/cli/chat.js",
    "speedtest": "node ./src/cli/speedtest.js",
    "test": "node ./src/cli/test-all.js",
    "test:unit": "node --test --test-reporter=spec ./tests/unit/*.test.js",
    "test:integration": "node ./src/cli/test-examples.js",
    "test:examples": "node ./src/cli/test-suites/examples.js",
    "test:cli": "node ./src/cli/test-suites/cli-workflows.js",
    "test:negative": "node ./src/cli/test-suites/negative.js",
    "test:lsp": "node ./src/cli/test-suites/lsp.js",
    "test:bootstrap": "node ./src/cli/test-suites/bootstrap.js",
    "test:parity": "node ./src/cli/test-parity.js",
    "test:sanitizers": "node ./src/cli/test-sanitizers.js",
    "test:http-runtime": "node ./src/cli/test-http-runtime.js",
    "test:package": "node ./src/cli/test-installed-package.js",
    "test:properties": "node ./src/cli/fuzz-compiler.js --runs 250",
    "fuzz:compiler": "node ./src/cli/fuzz-compiler.js --runs 5000 --timeout 120000",
    "fuzz:http": "node ./src/cli/fuzz-http.js",
    "docs:support": "node ./scripts/generate-support-matrix.mjs",
    "check:docs": "node ./scripts/generate-support-matrix.mjs --check && node ./scripts/check-docs.mjs",
    "check:versions": "node ./scripts/sync-versions.mjs --check",
    "check:package": "node ./scripts/check-package.mjs",
    "release:check": "npm run check:docs && npm run check:versions && npm run check:package && npm run check:abi && npm run test:unit && npm run test:package",
    "release:artifacts": "node ./scripts/create-release-artifacts.mjs",
    "prepublishOnly": "npm run release:check",
    "version": "node ./scripts/sync-versions.mjs"
  }
}
