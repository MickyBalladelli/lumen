{
  "name": "lumen",
  "version": "0.1.0",
  "type": "module",
  "description": "Foundational compiler for the Lumen systems language",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "parse": "node ./src/cli/parse.js",
    "compile": "node ./src/cli/compile.js",
    "bootstrap": "node ./src/cli/compile.js compiler/main.lm -o build/lumen-compiler",
    "compile:lumen": "./build/lumen-compiler",
    "compile:lumen:basic": "./build/lumen-compiler examples/basic.lm build/basic.ll",
    "compile:lumen:control": "./build/lumen-compiler examples/control-flow.lm build/control-flow.ll",
    "bootstrap:self": "./build/lumen-compiler compiler/main.lm build/lumen-compiler-self.ll && clang -Wno-override-module build/lumen-compiler-self.ll src/runtime/http.c -pthread -o build/lumen-compiler-self",
    "compile:self": "./build/lumen-compiler-self",
    "compile:self:basic": "./build/lumen-compiler-self examples/basic.lm build/basic-self.ll",
    "compile:self:control": "./build/lumen-compiler-self examples/control-flow.lm build/control-flow-self.ll",
    "compile:examples": "node ./src/cli/compile-examples.js",
    "http": "node ./src/cli/http.js",
    "chat": "node ./src/cli/chat.js",
    "test": "node ./src/cli/test-examples.js"
  }
}
